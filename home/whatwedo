addEventListener('keydown',e=>{if(e.key==='Escape')menu.classList.remove('open');});
addEventListener('scroll',()=>document.getElementById('bar').classList.toggle('scrolled',scrollY>30),{passive:true});
(function(){function apply(t){document.documentElement.setAttribute('data-theme',t);document.querySelectorAll('#themeTog button').forEach(b=>b.classList.toggle('on',b.dataset.theme===t));}
  var h=new Date().getHours();var theme=localStorage.getItem('es_theme')||((h>=8&&h<17)?'light':'dark');apply(theme);
  document.querySelectorAll('#themeTog button').forEach(b=>b.addEventListener('click',()=>{theme=b.dataset.theme;localStorage.setItem('es_theme',theme);apply(theme);}));})();
const revIO=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');revIO.unobserve(e.target);}}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>revIO.observe(el));

/* capabilities word wall */
const CAPS=['Production','Post-Production','Editing','Color Grading','Sound Design','Cinematography','Direction','Script','Storyboarding','Concept','3D Animation','Modeling','Rendering','Rigging','2D Animation','Character Design','Motion Graphics','Compositing','VFX','Clean-up','AI Productions','AI Pipelines','Pre-viz','Generative Assets','Upscaling','Crew','In-House','Craft','Precision','Delivery','Brand Film','Documentary','Commercials','Social-First','Cutdowns','Campaigns','Launch','Titles','Data Viz','Brand Systems','Call Sheet','On-Set','Location Scouting','Casting','Lighting','Sound Mix','Scoring','Multi-Format','QA','Reels','Explainers','Infographics','Photography','Animation','Environments','Simulation','Effects','Style Frames','No Handoffs','One Crew','Full Screen','Everything In THE KIT'];
document.getElementById('capWall').innerHTML=CAPS.map((w,i)=>`<span class="${i%2?'it':''}">${w}</span>`).join(' ');
/* hover thumbnails (like the home word wall) */
