  const wall=document.getElementById('capWall');
  const thumb=document.createElement('div');thumb.className='ww-thumb';thumb.innerHTML='<img loading="lazy" decoding="async" alt="">';wall.appendChild(thumb);
  const img=thumb.querySelector('img');
