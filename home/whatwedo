  .uni-cap{display:block;position:absolute;left:0;right:0;bottom:18px;z-index:5;text-align:center;
    padding:0 28px;font-family:var(--font-med);font-size:11.5px;letter-spacing:.04em;color:var(--text);line-height:1.5}
  .uni-cap b{color:var(--pink)}
  .uni-final{position:relative;inset:auto;transform:none;max-width:none;text-align:center;
    padding:0;margin:0 auto;max-height:0;overflow:hidden;opacity:0;transition:opacity .5s,max-height .5s,padding .5s}
  .uni-final.show{transform:none;opacity:1;max-height:320px;padding:30px 26px 8px}
  .uni-final .q{font-size:20px}
  .uni-final .cta{margin-top:14px}
}
