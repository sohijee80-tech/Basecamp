/* growth engine pillars */
const PILLARS=[
  ['Production','On-set execution with an in-house crew — directors, DOPs, and production management working off a single call sheet, so nothing gets lost between departments.',['Pre-Production & Scheduling','Location Scouting & Casting','Full Crew, One Roof','Multi-Format Capture','On-Set Problem Solving']],
  ['Post-Production','Edit, color, and sound — the craft that turns raw footage into a piece that\'s ready to run, on any platform.',['Offline & Online Edit','Color Grading','Sound Design & Mix','Multi-Format Delivery']],
  ['AI Productions','AI-assisted pipelines layered into production and post — built to move faster without cutting corners on craft.',['AI-Assisted Pre-Viz','Generative Asset Support','AI-Accelerated Post','Human-in-the-Loop QA']],
  ['3D Animation','Full CGI, product visualization, and 3D motion — built for brand films, explainers, and product launches.',['Modeling & Texturing','Lighting & Rendering','Rigging & Character Motion','Integration With Live-Action']],
  ['2D Animation','Character, explainer, and brand animation with a distinct, hand-built feel.',['Character Design & Animation','Explainer & Infographic Animation','Brand-Driven Style Frames','Storyboarding']],
  ['Motion Graphics','Titles, data visualization, and kinetic brand systems built to move with intent.',['Title & Credit Sequences','Data & Information Design','Brand Motion Systems','Social-First Cutdowns']],
  ['VFX','Compositing, clean-up, and visual effects work that holds up at full screen and full scrutiny.',['Compositing','Clean-Up & Rig Removal','Environment Extension','Effects Simulation']]
];
const pc=document.getElementById('pillars');
pc.innerHTML=PILLARS.map((p,i)=>`<div class="pill ${i===0?'open':''}" data-i="${i}">
  <div class="pill-head"><div class="px">0${i+1}</div><div class="ph">${p[0]}</div><div class="parr">→</div></div>
  <div class="pill-body"><div class="pill-in"><div class="pd">${p[1]}</div><ul>${p[2].map(o=>`<li>${o}</li>`).join('')}</ul></div></div>
</div>`).join('');
function syncPill(el){const b=el.querySelector('.pill-body');b.style.maxHeight=el.classList.contains('open')?b.scrollHeight+'px':'0px';}
document.querySelectorAll('#pillars .pill').forEach(el=>{
  el.querySelector('.pill-head').addEventListener('click',()=>{const open=el.classList.contains('open');document.querySelectorAll('#pillars .pill').forEach(o=>{o.classList.remove('open');syncPill(o);});if(!open){el.classList.add('open');syncPill(el);}});
});
requestAnimationFrame(()=>document.querySelectorAll('#pillars .pill').forEach(syncPill));
addEventListener('resize',()=>document.querySelectorAll('#pillars .pill.open').forEach(syncPill));

/* ===== The BaseCamp Studio Machine, orbital universe ===== */
(function(){
  const stage=document.getElementById('universe');if(!stage)return;
  const cv=document.getElementById('uniCv'),ctx=cv.getContext('2d'),labels=document.getElementById('uniLabels'),tip=document.getElementById('mcTip'),um=document.getElementById('uniMobile');
  const INPUTS=[['Brief','Where it all begins.'],['Script','Defines the story.'],['Budget','What we have to work with.'],['References','Creates the visual language.'],['Brand Guidelines','Reveals the constraints.'],['Deadline','Sets the corridor.'],['Location','Defines the setting.'],['Talent','Sequences the shoot.'],['Footage','Anchors the edit.'],['Ambition','Sets the ceiling.']];
  const OUTPUTS=[['A Finished Film','Ready to run, anywhere.'],['On-Time Delivery','No surprise delays.'],['Brand Consistency','Impossible to confuse.'],['Social Cutdowns','Built for every placement.'],['Launch-Ready Assets','Nothing left unfinished.'],['Full-Screen Confidence','Holds up at any size.'],['Faster Turnarounds','AI-accelerated pipelines.'],['Fewer Handoffs','One crew, start to finish.'],['Repeat Business','95% client retention.'],['Craft Quality','The number that matters.']];
  const SERVICES=[
    {n:'01',name:'Production',role:'Capture',outs:[0,6,7],on:false},
    {n:'02',name:'Post-Production',role:'Finish',outs:[0,2,9],on:false},
    {n:'03',name:'AI Productions',role:'Accelerate',outs:[6,7,4],on:false},
    {n:'04',name:'2D / 3D Animation',role:'Visualize',outs:[0,3,5],on:false},
    {n:'05',name:'Motion Graphics & VFX',role:'Polish',outs:[2,5,8],on:false}
  ];
  let chefOn=false;
  const core=document.getElementById('uniCore'),hint=document.getElementById('uniHint'),finalEl=document.getElementById('uniFinal'),cap=document.getElementById('uniCap');
  const allOn=()=>chefOn&&SERVICES.every(s=>s.on);
  const activeCount=()=>SERVICES.reduce((a,s)=>a+(s.on?1:0),0);
  const strength=o=>{let tot=0,act=0;SERVICES.forEach(s=>{if(s.outs.includes(o)){tot++;if(s.on)act++;}});return tot?act/tot:0;};
  function wireTip(el,txt){el.addEventListener('mousemove',e=>{tip.textContent=txt;tip.style.left=Math.min(innerWidth-250,e.clientX+14)+'px';tip.style.top=(e.clientY-44)+'px';tip.classList.add('show');});el.addEventListener('mouseleave',()=>tip.classList.remove('show'));}
  /* desktop labels */
  const inEl=INPUTS.map(d=>{const e=document.createElement('div');e.className='uni-node input';e.textContent=d[0];wireTip(e,d[1]);labels.appendChild(e);return e;});
  const outEl=OUTPUTS.map(d=>{const e=document.createElement('div');e.className='uni-node output';e.textContent=d[0];wireTip(e,d[1]);labels.appendChild(e);return e;});
  const svcEl=SERVICES.map((s,i)=>{const e=document.createElement('div');e.className='uni-node svc';e.innerHTML='<span class="sd">'+s.n+'</span><span class="nm">'+s.name+'</span>';e.addEventListener('click',()=>toggle(i));wireTip(e,s.role+', click to switch on/off');labels.appendChild(e);return e;});
  /* mobile fallback */
  um.innerHTML=`<div class="um-row"><button class="um-chef" id="umPlay" style="border-style:dashed">▶ Play the process</button></div>
    <div class="um-row"><div class="um-h">Inputs</div><div class="um-chips">${INPUTS.map(d=>`<span class="um-chip">${d[0]}</span>`).join('')}</div></div>
    <div class="um-arrow">↓ INTO THE KIT® ↓</div>
    <div class="um-row"><button class="um-chef" id="umChef">Power on THE KIT®</button></div>
    <div class="um-row"><div class="um-h">Services, tap to switch on/off</div><div id="umSvc">${SERVICES.map((s,i)=>`<button class="um-svc" data-i="${i}"><span class="sd"></span>${s.n} · ${s.name}</button>`).join('')}</div></div>
    <div class="um-arrow">↓ OUTPUTS ↓</div>
    <div class="um-row"><div class="um-chips" id="umOut">${OUTPUTS.map(d=>`<span class="um-chip">${d[0]}</span>`).join('')}</div></div>
    <div class="um-final" id="umFinal"><div class="q">Every story needs a basecamp.<br><em>For Success.</em></div><a class="cta" href="brief">Start your brief →</a></div>`;
  um.querySelectorAll('.um-svc').forEach(b=>b.addEventListener('click',()=>toggle(+b.dataset.i)));
  um.querySelector('#umChef').addEventListener('click',toggleChef);
  function toggleChef(){stopPlay();chefOn=!chefOn;applyState();}
  core.addEventListener('click',toggleChef);
  function toggle(i){stopPlay();if(!chefOn)return;SERVICES[i].on=!SERVICES[i].on;applyState();}
  /* guided play: power on CHEF, then bring services online one by one */
  let timers=[];const playBtn=document.getElementById('uniPlay'),umPlay=um.querySelector('#umPlay');
  function stopPlay(){timers.forEach(clearTimeout);timers=[];if(playBtn)playBtn.textContent='▶ Play the process';if(umPlay)umPlay.textContent='▶ Play the process';}
  function play(){
    stopPlay();chefOn=false;SERVICES.forEach(s=>s.on=false);applyState();
    if(playBtn)playBtn.textContent='● Running…';if(umPlay)umPlay.textContent='● Running…';
    let d=700;
    timers.push(setTimeout(()=>{chefOn=true;applyState();},d));d+=1500;
    SERVICES.forEach(s=>{timers.push(setTimeout(()=>{s.on=true;applyState();},d));d+=1050;});
    timers.push(setTimeout(stopPlay,d+200));
  }
  if(playBtn)playBtn.addEventListener('click',play);
  if(umPlay)umPlay.addEventListener('click',play);
  function applyState(){
    stage.classList.toggle('powered',chefOn);
    hint.innerHTML=chefOn?'Switch services on, each one organizes the outputs it powers':'Click CHEF® to power the system';
    svcEl.forEach((e,i)=>{e.classList.toggle('on',SERVICES[i].on);e.classList.toggle('off',!SERVICES[i].on);e.classList.toggle('hidden',!chefOn);});
    outEl.forEach((e,i)=>e.classList.toggle('off',!chefOn||strength(i)<=0.001));
    const umChef=um.querySelector('#umChef');if(umChef){umChef.classList.toggle('on',chefOn);umChef.textContent=chefOn?'THE KIT® powered, tap to power off':'Power on THE KIT®';}
    um.querySelectorAll('.um-svc').forEach((e,i)=>{e.classList.toggle('off',!SERVICES[i].on);e.disabled=!chefOn;});
    [...um.querySelectorAll('#umOut .um-chip')].forEach((e,i)=>e.classList.toggle('off',!chefOn||strength(i)<=0.001));
    finalEl.classList.toggle('show',allOn());
    const umf=um.querySelector('#umFinal');if(umf)umf.classList.toggle('show',allOn());
    if(cap){
      const on=SERVICES.filter(s=>s.on);
      if(!chefOn)cap.innerHTML='Tap <b>CHEF®</b> to power the system';
      else if(allOn())cap.innerHTML='All systems online — <b>demand engine fully powered</b>';
      else if(!on.length)cap.innerHTML='Tap the numbered dots to switch <b>services</b> on';
      else cap.innerHTML='On: '+on.map(s=>s.n+' '+s.name.split(/[ &]/)[0]).join(' · ');
    }
  }
  applyState();
  /* canvas universe */
  const PINK=[255,90,46],CYAN=[45,205,224];
  const mix=k=>[Math.round(PINK[0]+(CYAN[0]-PINK[0])*k),Math.round(PINK[1]+(CYAN[1]-PINK[1])*k),Math.round(PINK[2]+(CYAN[2]-PINK[2])*k)];
  const rgba=(c,a)=>'rgba('+c[0]+','+c[1]+','+c[2]+','+a+')';
  const ease=p=>p*p*(3-2*p);
  const SPH=(function(){const n=120,pts=[],ga=Math.PI*(3-Math.sqrt(5));for(let i=0;i<n;i++){const y=1-(i/(n-1))*2,r=Math.sqrt(Math.max(0,1-y*y)),th=ga*i;pts.push([Math.cos(th)*r,y,Math.sin(th)*r]);}
    const seen=new Set(),E=[];pts.forEach((p,i)=>{const d=pts.map((q,j)=>[j,(p[0]-q[0])**2+(p[1]-q[1])**2+(p[2]-q[2])**2]).filter(a=>a[0]!==i).sort((a,b)=>a[1]-b[1]);for(let k=0;k<3;k++){const j=d[k][0],key=Math.min(i,j)+'-'+Math.max(i,j);if(!seen.has(key)){seen.add(key);E.push([Math.min(i,j),Math.max(i,j)]);}}});return{pts,E};})();
  /* scattered "lost" home for each input (fractions of canvas) */
  const SCAT=INPUTS.map(()=>({fx:0.08+Math.random()*0.84,fy:0.10+Math.random()*0.80,wx:Math.random()*6.3,wy:Math.random()*6.3,ws:0.4+Math.random()*0.7}));
  let W,H,dpr,cx,cy,raf,running=false,t=0,rot=0,sphR,R0,R1,R2,power=0,bright=0;
  function size(){const r=cv.getBoundingClientRect();if(!r.width)return;dpr=Math.min(devicePixelRatio||1,2);W=r.width;H=r.height;cv.width=W*dpr;cv.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);const mob=W<=820;cx=W/2;cy=H*(mob?0.47:0.46);const m=Math.min(W,H);sphR=m*(mob?0.085:0.066);R0=m*(mob?0.36:0.40);R1=m*(mob?0.19:0.22);R2=m*(mob?0.28:0.33);}
  function pos(R,ang){return{x:cx+Math.cos(ang)*R,y:cy+Math.sin(ang)*R};}
  function sphere(br){rot+=0.0038;const cR=Math.cos(rot),sR=Math.sin(rot),tl=0.45,ct=Math.cos(tl),st=Math.sin(tl);
    const P=SPH.pts.map(p=>{let x=p[0]*cR+p[2]*sR,z=-p[0]*sR+p[2]*cR,y=p[1];const y2=y*ct-z*st,z2=y*st+z*ct;const pe=1.7/(1.7-z2);return{x:cx+x*sphR*pe,y:cy-y2*sphR*pe,z:z2};});
    SPH.E.forEach(([i,j])=>{const a=P[i],b=P[j],k=((a.z+b.z)/2+1)/2;const col=br>0.5?mix(1-k):[150,150,150];ctx.strokeStyle=rgba(col,(0.04+0.16*k)*(0.35+0.65*br));ctx.lineWidth=0.6;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();});
    P.forEach(p=>{const k=(p.z+1)/2;const col=br>0.5?mix(1-k):[150,150,150];ctx.globalAlpha=(0.18+0.6*k)*(0.4+0.6*br);ctx.fillStyle=rgba(col,1);ctx.beginPath();ctx.arc(p.x,p.y,0.7+1.3*k,0,6.3);ctx.fill();});ctx.globalAlpha=1;}
  function frame(){if(!running)return;t++;power+=((chefOn?1:0)-power)*0.06;const P=ease(power);
    const bt=chefOn?(0.35+0.65*activeCount()/SERVICES.length):0;bright+=(bt-bright)*0.06;ctx.clearRect(0,0,W,H);
    const g1=-t*0.00045, g2=t*0.0007, g3=t*0.0003;
    const dark=document.documentElement.getAttribute('data-theme')!=='light';
    const gcol=dark?[155,155,155]:[110,103,92];
    /* orbit rings fade in with power */
    if(P>0.02)[R0,R1,R2].forEach(R=>{ctx.strokeStyle=rgba(gcol,0.10*P);ctx.lineWidth=1;ctx.beginPath();ctx.arc(cx,cy,R,0,6.3);ctx.stroke();});
    /* input positions: scattered (lost) → orbit, lerped by power */
    const inP=INPUTS.map((d,i)=>{const o=pos(R0,g3+i/INPUTS.length*6.283);const s=SCAT[i];const sx=s.fx*W+Math.sin(t*0.01*s.ws+s.wx)*22,sy=s.fy*H+Math.cos(t*0.012*s.ws+s.wy)*22;return{x:sx+(o.x-sx)*P,y:sy+(o.y-sy)*P};});
    const svP=SERVICES.map((s,i)=>pos(R1,g1+i/SERVICES.length*6.283-1.57));
    const ouP=OUTPUTS.map((d,i)=>pos(R2,g2+i/OUTPUTS.length*6.283+0.2));
    /* inputs → core (only once powered) */
    if(P>0.05)inP.forEach(p=>{ctx.strokeStyle=rgba(CYAN,0.06*P);ctx.lineWidth=0.7;ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(cx,cy);ctx.stroke();
      const u=(t*0.004+(p.x+p.y))%1,fx=p.x+(cx-p.x)*u,fy=p.y+(cy-p.y)*u;ctx.fillStyle=rgba(CYAN,0.5*P);ctx.beginPath();ctx.arc(fx,fy,1.1,0,6.3);ctx.fill();});
    /* services → outputs + core spokes (powered) */
    if(P>0.1)svP.forEach((p,si)=>{const s=SERVICES[si];
      ctx.globalAlpha=P;
      ctx.strokeStyle=s.on?rgba(PINK,0.28):rgba([140,140,140],0.07);ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(p.x,p.y);ctx.stroke();
      if(s.on)s.outs.forEach(oi=>{const o=ouP[oi];const grd=ctx.createLinearGradient(p.x,p.y,o.x,o.y);grd.addColorStop(0,rgba(PINK,0.26));grd.addColorStop(1,rgba(CYAN,0.14));ctx.strokeStyle=grd;ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(o.x,o.y);ctx.stroke();
        const u=(t*0.006+oi*0.13+si*0.07)%1,fx=p.x+(o.x-p.x)*u,fy=p.y+(o.y-p.y)*u;ctx.fillStyle=rgba(mix(u),0.85);ctx.beginPath();ctx.arc(fx,fy,1.4,0,6.3);ctx.fill();});
      ctx.globalAlpha=1;});
    /* input nodes */
    inP.forEach(p=>{ctx.fillStyle=rgba(gcol,0.7+0.25*P);ctx.beginPath();ctx.arc(p.x,p.y,2.4,0,6.3);ctx.fill();});
    /* output nodes (powered) */
    if(P>0.05)ouP.forEach((p,oi)=>{const st=strength(oi);const c=st>0.001?mix(0.35):gcol;ctx.globalAlpha=(0.45+0.55*st)*P;ctx.fillStyle=rgba(c,1);ctx.beginPath();ctx.arc(p.x,p.y,2.6+3*st,0,6.3);ctx.fill();ctx.globalAlpha=1;});
    /* core glow scales with power + active services */
    const gr=sphR*(1.7+1.0*bright),ga=(0.08+0.24*bright+0.03*Math.sin(t*0.05));
    const gl=ctx.createRadialGradient(cx,cy,0,cx,cy,gr);gl.addColorStop(0,'rgba(255,90,46,'+ga+')');gl.addColorStop(0.5,'rgba(255,90,46,'+(ga*0.4)+')');gl.addColorStop(1,'rgba(255,90,46,0)');ctx.fillStyle=gl;ctx.beginPath();ctx.arc(cx,cy,gr,0,6.3);ctx.fill();
    sphere(P*0.55+bright*0.45);
    /* place DOM labels */
    const setp=(el,p,off)=>{el.style.left=p.x+'px';el.style.top=(p.y+(off||0))+'px';};
    inEl.forEach((e,i)=>setp(e,inP[i],-12));
    svcEl.forEach((e,i)=>setp(e,svP[i]));
    outEl.forEach((e,i)=>setp(e,ouP[i],-13));
    raf=requestAnimationFrame(frame);}
  function start(){if(running)return;running=true;size();raf=requestAnimationFrame(frame);}
  function stop(){running=false;cancelAnimationFrame(raf);}
  new IntersectionObserver(es=>es.forEach(e=>e.isIntersecting?start():stop()),{threshold:.04}).observe(cv);
  addEventListener('resize',size);size();
})();

