@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}}
.snum{font-family:var(--font-med);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--pink);margin-bottom:18px;display:block}
.sec{padding-top:clamp(80px,12vh,150px);padding-bottom:clamp(80px,12vh,150px);border-top:1px solid var(--line)}
h2.big{font-family:var(--font-display);font-size:clamp(34px,6vw,88px);text-transform:uppercase;line-height:.93;letter-spacing:-.02em}
.lead{font-size:clamp(16px,1.8vw,24px);line-height:1.5;max-width:820px;margin-top:24px;color:var(--soft)}
/* hero */
.hero{min-height:88vh;display:flex;flex-direction:column;justify-content:center;padding-top:120px;padding-bottom:50px}
.hero h1{font-family:var(--font-display);font-size:clamp(48px,11vw,170px);text-transform:uppercase;line-height:.84;letter-spacing:-.02em}
.hero .lead{max-width:740px}
/* capabilities word wall */
.cap-wall{position:relative;margin-top:46px;text-align:justify;text-justify:inter-word}
.cap-wall span{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(18px,2.4vw,40px);line-height:1.4;color:var(--text);transition:color .25s,transform .25s;cursor:default;display:inline-block}
.cap-wall span.it{font-family:Georgia,'Times New Roman',serif;font-style:italic;text-transform:none}
.cap-wall span:hover{color:var(--pink);transform:scale(1.08)}
.ww-thumb{position:absolute;z-index:6;width:224px;height:149px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,.32);pointer-events:none;opacity:0;transform:translateY(8px) scale(.96);transition:opacity .22s ease,transform .22s ease}
.ww-thumb.show{opacity:1;transform:none}
.ww-thumb img{width:100%;height:100%;object-fit:cover;display:block}
@media(max-width:760px){.ww-thumb{display:none}}
/* growth engine accordion */
.pillars{margin-top:50px}
.pill{border:1px solid var(--line);margin-bottom:12px;overflow:hidden;background:var(--surf);transition:border-color .3s}
.pill.open{border-color:var(--pink)}
.pill-head{display:flex;align-items:center;gap:20px;padding:24px 26px;cursor:pointer}
.pill .px{font-family:var(--font-display);font-size:26px;color:var(--pink);line-height:1;flex:0 0 auto}
.pill .ph{font-family:var(--font-display);font-size:clamp(18px,1.9vw,26px);text-transform:uppercase;line-height:1.05;flex:1}
.pill .parr{flex:0 0 auto;color:var(--muted);transition:transform .3s}
.pill.open .parr{transform:rotate(90deg);color:var(--pink)}
.pill-body{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.4,0,.2,1)}
.pill-in{padding:0 26px 26px;display:grid;grid-template-columns:1.2fr 1fr;gap:26px}
@media(max-width:760px){.pill-in{grid-template-columns:1fr}}
.pill-in .pd{color:var(--soft);font-size:15px;line-height:1.6}
.pill-in ul{list-style:none}
.pill-in li{font-family:var(--font-med);font-size:13.5px;color:var(--muted);padding:7px 0;border-bottom:1px dashed var(--line)}
.pill-in li::before{content:"› ";color:var(--pink)}
/* the elephant skin machine, orbital universe */
.machine{position:relative;width:100vw;margin-left:calc(50% - 50vw);margin-top:48px;height:clamp(720px,94vh,1080px);overflow:hidden;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.machine canvas{position:absolute;inset:0;width:100%;height:100%;z-index:0}
.uni-labels{position:absolute;inset:0;z-index:2;pointer-events:none}
.uni-node{position:absolute;transform:translate(-50%,-50%);white-space:nowrap;font-family:var(--font-med);transition:color .25s,opacity .25s}
.uni-node.input{font-size:11.5px;letter-spacing:.07em;color:var(--text);text-transform:uppercase;pointer-events:auto;cursor:default;opacity:.82}
.uni-node.input:hover{opacity:1}
.uni-node.output{font-size:13px;letter-spacing:.02em;color:var(--text);pointer-events:auto;cursor:default;font-family:var(--font-display);text-transform:uppercase}
.uni-node.output.off{opacity:.2}
/* services = pink buttons that expand to reveal the name on hover / when on */
.uni-node.svc{pointer-events:auto;cursor:pointer;display:flex;align-items:center;background:var(--pink);color:#fff;border-radius:999px;height:32px;max-width:32px;overflow:hidden;white-space:nowrap;user-select:none;transition:max-width .42s cubic-bezier(.5,0,.1,1),background .3s,box-shadow .3s,opacity .25s;box-shadow:0 0 0 rgba(255,90,46,0)}
.uni-node.svc .sd{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-med);font-size:12px;flex:0 0 auto;background:transparent;box-shadow:none}
.uni-node.svc .nm{font-family:var(--font-display);text-transform:uppercase;font-size:12.5px;letter-spacing:.02em;padding-right:18px;opacity:0;transition:opacity .3s}
.uni-node.svc.on{max-width:300px;box-shadow:0 0 22px rgba(255,90,46,.6)}
.uni-node.svc.on .nm{opacity:1}
.uni-node.svc:not(.on):hover{box-shadow:0 0 16px rgba(255,90,46,.45);background:rgba(255,90,46,.3)}
.uni-node.svc.off{background:rgba(255,90,46,.16);border:1.5px solid var(--pink);color:var(--pink)}
.uni-node.hidden{opacity:0!important;pointer-events:none!important}
.uni-core{position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);text-align:center;z-index:2;pointer-events:none;transition:opacity .4s}
.uni-core .cf,.uni-core .poweron{pointer-events:auto;cursor:pointer}
.uni-core::before{content:'';position:absolute;left:50%;top:50%;width:150px;height:150px;border:1.5px solid var(--pink);border-radius:50%;transform:translate(-50%,-50%);opacity:0}
#universe:not(.powered) .uni-core::before{animation:ringpulse 2s ease-out infinite}
@keyframes ringpulse{0%{transform:translate(-50%,-50%) scale(.55);opacity:.55}100%{transform:translate(-50%,-50%) scale(1.5);opacity:0}}
.uni-core .cf{transition:color .4s}
#universe:not(.powered) .uni-core .cf{color:var(--muted)}
#universe:not(.powered) .uni-core .cf sup{color:var(--muted)}
.uni-core .poweron{font-family:var(--font-med);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--pink);margin-top:12px;opacity:0;transition:opacity .4s}
#universe:not(.powered) .uni-core .poweron{opacity:1;animation:mcblink 1.5s infinite}
@keyframes mcblink{0%,100%{opacity:.45}50%{opacity:1}}
.uni-core .cf{font-family:var(--font-display);font-size:clamp(26px,3vw,44px);color:var(--text);line-height:1}
.uni-core .cf sup{color:var(--pink);font-size:.36em;vertical-align:super}
.uni-core .cs{font-family:var(--font-med);font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-top:5px}
.uni-play{position:absolute;top:22px;right:var(--pad);z-index:6;display:inline-flex;align-items:center;gap:9px;padding:12px 24px;border:1.5px solid var(--pink);background:transparent;color:var(--pink);border-radius:999px;font-family:var(--font-med);text-transform:uppercase;font-size:11px;letter-spacing:.12em;cursor:pointer;transition:background .2s,color .2s,transform .2s}
.uni-play:hover{background:var(--pink);color:#fff;transform:translateY(-2px)}
.uni-hint{position:absolute;left:50%;bottom:34px;transform:translateX(-50%);z-index:5;font-family:var(--font-med);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);text-align:center;pointer-events:none}
.uni-final{position:absolute;right:clamp(20px,4vw,64px);top:50%;transform:translateY(-50%) translateX(24px);max-width:320px;z-index:4;text-align:right;opacity:0;pointer-events:none;transition:opacity .6s ease,transform .6s ease}
.uni-final.show{opacity:1;transform:translateY(-50%) translateX(0);pointer-events:auto}
.uni-final .q{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(22px,2.5vw,38px);line-height:1.02;letter-spacing:-.01em;color:var(--text);text-shadow:0 2px 30px rgba(0,0,0,.55)}
[data-theme="light"] .uni-final .q{text-shadow:0 2px 24px rgba(243,241,234,.7)}
.uni-final .q em{color:var(--pink);font-style:normal}
.uni-final .cta{display:inline-flex;margin-top:18px;padding:13px 26px;background:var(--pink);color:#fff;font-family:var(--font-med);text-transform:uppercase;font-size:11px;letter-spacing:.12em;border-radius:999px;transition:transform .2s}
.uni-final .cta:hover{transform:translateY(-2px)}
.mc-tip{position:fixed;z-index:95;pointer-events:none;opacity:0;transition:opacity .14s;background:rgba(10,10,12,.94);border:1px solid rgba(255,90,46,.5);border-radius:8px;padding:8px 12px;font-family:var(--font-med);font-size:12px;color:#fff;max-width:240px}
.mc-tip.show{opacity:1}
.uni-mobile{display:none}
.uni-cap{display:none}
.uni-legend{display:none}
.uni-stage{position:absolute;inset:0;z-index:0}
/* mobile: keep the orbital graphic but clean it up — hide the 20 text labels (the clutter),
   services become fixed numbered dots, a legend keys the dots, and the closing line sits below */
@media(max-width:820px){
  .machine{height:auto;aspect-ratio:auto;min-height:0;max-height:none;margin-top:30px;overflow:visible;display:flex;flex-direction:column}
  .uni-stage{position:relative;width:100%;height:116vw;min-height:440px;max-height:560px;overflow:hidden;flex:0 0 auto}
  .uni-mobile{display:none!important}
  .mc-tip{display:none!important}
  .uni-node.input,.uni-node.output{display:none}
  .uni-node.svc{height:30px;max-width:30px!important;padding:0}
  .uni-node.svc .sd{width:30px;height:30px;font-size:12px}
  .uni-node.svc .nm{display:none}
  .uni-node.svc.on{max-width:30px!important;box-shadow:0 0 18px rgba(255,90,46,.78)}
  .uni-core .cf{font-size:30px}
  .uni-core .cs{font-size:8px}
  .uni-play{top:12px;right:var(--pad);padding:10px 16px;font-size:9.5px;letter-spacing:.1em}
  .uni-hint{display:none}
  .uni-legend{display:flex;gap:13px;position:absolute;left:var(--pad);top:14px;z-index:5;
    font-family:var(--font-med);font-size:8.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
  .uni-legend span{display:flex;align-items:center;gap:5px}
  .uni-legend i{width:8px;height:8px;border-radius:50%;flex:0 0 auto}
  .uni-legend .lg-in{background:#9b9b9b}
