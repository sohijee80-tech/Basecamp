  [...wall.querySelectorAll('span:not(.it)')].forEach((s,i)=>{
    s.addEventListener('mouseenter',()=>{img.src=imgs[i%imgs.length];const wr=wall.getBoundingClientRect(),r=s.getBoundingClientRect();let left=(r.left-wr.left)+r.width/2-112,top=(r.top-wr.top)-160;if(top<8)top=(r.bottom-wr.top)+14;left=Math.max(8,Math.min(left,wall.clientWidth-232));thumb.style.left=left+'px';thumb.style.top=top+'px';thumb.classList.add('show');});
    s.addEventListener('mouseleave',()=>thumb.classList.remove('show'));
