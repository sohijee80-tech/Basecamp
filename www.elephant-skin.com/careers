function shareIG(role){var url=location.href.split('#')[0];
  try{ if(window.esTrack) esTrack('share',{method:'instagram',content_type:'job',item_id:role}); }catch(e){}
  if(navigator.share){navigator.share({title:role+' · BaseCamp Studio Careers',text:'We are hiring: '+role+' at BaseCamp Studio',url:url}).catch(function(){});return;}
  try{if(navigator.clipboard)navigator.clipboard.writeText('We are hiring: '+role+' at BaseCamp Studio — '+url);}catch(e){}
  window.open('https://www.instagram.com/basecampstudio/','_blank','noopener');}
function openJob(i){const j=JOBS[i];const d=JOBDETAILS[j[0]];
  var goApply='document.getElementById(\'applyBox\').scrollIntoView({behavior:\'smooth\',block:\'start\'})';
  var head='<div class="dr-head"><div class="dr-eyebrow">'+j[2]+' · '+j[1]+'</div><div class="dr-title">'+j[0]+'</div>'+
    '<div class="dr-meta"><span>'+j[3]+'</span><span>'+j[2]+'</span><span>'+j[1]+'</span></div>'+(d?'<div class="dr-posted">'+d.posted+'</div>':'')+'</div>';
  var ov=d?d.overview:[j[4]];
  var liUrl='https://www.linkedin.com/sharing/share-offsite/?url='+encodeURIComponent(location.href.split('#')[0]);
  var actions='<div class="dr-actions">'+
    '<button class="btn primary dr-applybtn" type="button" onclick="'+goApply+'">Apply for this role →</button>'+
    '<div class="dr-share"><span class="lbl">Share</span>'+
    '<a class="shbtn" href="'+liUrl+'" target="_blank" rel="noopener" title="Share on LinkedIn">'+IN_SVG+'LinkedIn</a>'+
    '<button class="shbtn shbtn-ig" type="button" title="Share on Instagram">'+IG_SVG+'Instagram</button>'+
    '</div></div>';
  var overview='<div class="dr-overview">'+ov.map(function(p){return '<p>'+p+'</p>';}).join('')+actions+'</div>';
  var company='<div class="dr-company"><div class="k">Inside BaseCamp Studio</div>'+
    '<p>'+ABOUT_ES.replace('<b>About us.</b> ','')+'</p>'+
    '<div class="dr-stats">'+COMPANY_STATS.map(function(s){return '<div class="st"><div class="n">'+s[0]+'</div><div class="l">'+s[1]+'</div></div>';}).join('')+'</div></div>';
  var secs=d?d.sections:(j[5]?[{h:'What we look for',items:j[5]}]:[]);
  var acc='<div class="dr-acc">'+secs.map(function(s,k){return '<div class="dr-acci'+(k===0?' open':'')+'">'+
    '<button class="dr-acch" type="button"><span class="t">'+s.h+'</span><span class="ch"></span></button>'+
    '<div class="dr-accb"><div class="dr-accb-in">'+(s.body?'<div class="sb">'+s.body+'</div>':'')+'<ul>'+s.items.map(function(x){return '<li>'+x+'</li>';}).join('')+'</ul></div></div></div>';}).join('')+'</div>';
  drawerIn.innerHTML='<button class="dr-x" id="drX" aria-label="Close">&times;</button>'+
    '<div class="dr-in">'+head+overview+company+acc+
    '<div class="dr-applywrap">'+applyFormHTML(j[0])+'</div></div>';
  drawerIn.querySelectorAll('.dr-acch').forEach(function(btn){btn.addEventListener('click',function(){btn.closest('.dr-acci').classList.toggle('open');});});
  var igb=drawerIn.querySelector('.shbtn-ig');if(igb)igb.addEventListener('click',function(){shareIG(j[0]);});
  var lib=drawerIn.querySelector('.dr-share a.shbtn');if(lib)lib.addEventListener('click',function(){try{if(window.esTrack)esTrack('share',{method:'linkedin',content_type:'job',item_id:j[0]});}catch(e){}});
  if(window.esTrack)esTrack('view_job',{role:j[0]});
  document.getElementById('drX').addEventListener('click',closeDrawer);
  wireForm(j[0]);
  scrim.classList.add('open');drawer.classList.add('open');drawer.setAttribute('aria-hidden','false');drawer.scrollTop=0;document.body.style.overflow='hidden';
}
function openGeneral(){
  drawerIn.innerHTML='<button class="dr-x" id="drX" aria-label="Close">&times;</button>'+
    '<div class="dr-in"><div class="dr-eyebrow">Open application</div><div class="dr-title">Surprise us.</div>'+
    '<div class="dr-desc">Don\'t see your exact role? Send us your story anyway, when the right moment comes, we\'ll know exactly who to call.</div>'+
    applyFormHTML('Open application')+'</div>';
  document.getElementById('drX').addEventListener('click',closeDrawer);
  wireForm('Open application');
  scrim.classList.add('open');drawer.classList.add('open');drawer.setAttribute('aria-hidden','false');drawer.scrollTop=0;document.body.style.overflow='hidden';
}
function wireForm(role){const f=document.getElementById('applyForm'),box=document.getElementById('applyBox');
  f.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(f);
    const subject='Application: '+role+', '+(d.get('name')||'');
    const body='Role: '+role+'\nName: '+(d.get('name')||'')+'\nEmail: '+(d.get('email')||'')+'\nPortfolio/LinkedIn: '+(d.get('link')||'')+'\n\n'+(d.get('msg')||'')+'\n\n(Please attach your CV / reel before sending.)';
    try{ if(window.esTrack) esTrack('job_application',{role:role}); }catch(err){}
    window.location.href='mailto:hello@basecampstudio.pk?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(body);
    box.classList.add('sent');});
}
function closeDrawer(){scrim.classList.remove('open');drawer.classList.remove('open');drawer.setAttribute('aria-hidden','true');document.body.style.overflow='';}
scrim.addEventListener('click',closeDrawer);
document.getElementById('generalApply').addEventListener('click',openGeneral);

