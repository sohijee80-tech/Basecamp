<style>
:root{
  --pink:#FF5A2E;--pad:clamp(24px,3.5vw,56px);
  --bg:#070707;--text:#f3f1ea;--muted:#8a867d;--soft:#cfcbc0;--line:rgba(255,255,255,.10);--surf:rgba(255,255,255,.03);
  --font-display:'Etna','Helvetica Neue',Arial,sans-serif;
  --font-body:'Aaux Pro Light','Helvetica Neue',Arial,sans-serif;
  --font-med:'Aaux Pro Medium','Helvetica Neue',Arial,sans-serif;
}
html[data-theme="light"]{--bg:#f3f1ea;--text:#16130f;--muted:#6a665d;--soft:#46423a;--line:rgba(0,0,0,.13);--surf:rgba(0,0,0,.025)}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--font-body);-webkit-font-smoothing:antialiased;line-height:1.55;overflow-x:hidden;transition:background .4s,color .4s}
a{color:inherit;text-decoration:none}
::selection{background:var(--pink);color:#fff}
.wrap{max-width:none;margin:0;padding:0 var(--pad)}
.pink{color:var(--pink)}
section{position:relative}
.bar{position:fixed;top:0;left:0;right:0;z-index:60;display:flex;align-items:center;justify-content:space-between;padding:20px var(--pad);transition:background .3s}
.bar.scrolled{background:color-mix(in srgb,var(--bg) 80%,transparent);backdrop-filter:blur(12px)}
.bar .lg img{height:25px;display:block}
.bar-right{display:flex;align-items:center;gap:14px}
.themetog{display:flex;border:1px solid var(--line);border-radius:999px;overflow:hidden}
.themetog button{border:none;background:none;color:var(--muted);padding:7px 11px;cursor:pointer;font-size:13px;line-height:1;transition:.2s}
.themetog button.on{background:var(--text);color:var(--bg)}
.menu-btn{background:none;border:none;color:var(--text);cursor:pointer;font-family:var(--font-display);font-size:20px;letter-spacing:.04em;text-transform:uppercase;transition:color .25s}
.menu-btn:hover{color:var(--pink)}
.menu-overlay{position:fixed;inset:0;z-index:100;background:var(--pink);color:#0a0a0a;padding:54px 56px;display:flex;flex-direction:column;justify-content:space-between;transform:translateY(-102%);opacity:0;visibility:hidden;transition:transform .6s cubic-bezier(.76,0,.24,1),opacity .4s,visibility .6s}
.menu-overlay.open{transform:none;opacity:1;visibility:visible}
.menu-close{position:absolute;top:46px;right:52px;width:46px;height:46px;font-size:38px;cursor:pointer;background:none;border:none;color:#0a0a0a;line-height:1}
.menu-logo{height:26px;align-self:flex-start;margin-bottom:10px}
.menu-nav a{display:inline-block;font-family:var(--font-display);font-size:clamp(28px,4.6vw,54px);color:#fff;text-transform:uppercase;line-height:1.14;transition:padding-left .28s,color .2s}
.menu-nav a:hover{padding-left:18px;color:#0a0a0a}
.menu-foot{max-width:680px}
.menu-foot .slogan{font-family:var(--font-display);font-size:clamp(18px,2.4vw,26px);text-transform:uppercase}
.menu-foot p{margin-top:16px;font-size:13px;color:rgba(10,10,10,.72);max-width:540px;line-height:1.6}
.menu-social{margin-top:20px;display:flex;gap:14px}
.menu-social a{width:36px;height:36px;border:1.5px solid rgba(10,10,10,.55);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-med);font-size:12px;color:#0a0a0a;transition:.2s}
.menu-social a:hover{background:#0a0a0a;color:var(--pink)}
@media(max-width:600px){.menu-overlay{padding:36px 26px}.menu-close{top:30px;right:26px}.menu-logo{height:20px}}
.reveal{opacity:0;transform:translateY(30px);transition:opacity 1s ease,transform 1s ease}
.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}}
.snum{font-family:var(--font-med);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--pink);margin-bottom:18px;display:block}
.sec{padding-top:clamp(80px,12vh,140px);padding-bottom:clamp(80px,12vh,140px);border-top:1px solid var(--line)}
h2.big{font-family:var(--font-display);font-size:clamp(34px,6vw,84px);text-transform:uppercase;line-height:.93;letter-spacing:-.02em}
.lead{font-size:clamp(16px,1.8vw,23px);line-height:1.5;max-width:760px;margin-top:24px;color:var(--soft)}
/* hero */
.chero{min-height:90vh;display:flex;flex-direction:column;justify-content:center;padding-top:120px;padding-bottom:50px}
.chero h1{font-family:var(--font-display);font-size:clamp(46px,11vw,168px);text-transform:uppercase;line-height:.84;letter-spacing:-.02em}
.chero .lead{max-width:720px}
.chero .youin{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(20px,2.4vw,34px);margin-top:30px}
.chero .youin .pink{color:var(--pink)}
.cta-row{margin-top:30px;display:flex;gap:14px;flex-wrap:wrap}
.btn{display:inline-flex;align-items:center;gap:8px;padding:15px 30px;border-radius:999px;font-family:var(--font-med);font-size:12px;letter-spacing:.1em;text-transform:uppercase;transition:transform .2s,background .2s,color .2s,border-color .2s;border:1.5px solid transparent;cursor:pointer}
.btn.primary{background:var(--pink);color:#fff;border-color:var(--pink)}
.btn.primary:hover{transform:translateY(-2px)}
.btn.ghost{border-color:var(--line);color:var(--text)}
.btn.ghost:hover{border-color:var(--pink);color:var(--pink)}
/* showcase carousel */
.showcase{width:100vw;margin-left:calc(50% - 50vw);overflow-x:auto;overflow-y:hidden;cursor:grab;scrollbar-width:none;-ms-overflow-style:none;padding:60px 0 40px;-webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
.showcase::-webkit-scrollbar{display:none}
.showcase.drag{cursor:grabbing}
.sc-track{display:flex;align-items:center;gap:18px;width:max-content;padding:0 var(--pad)}
.sc-tile{position:relative;flex:0 0 auto;width:clamp(170px,17vw,240px);aspect-ratio:4/5;overflow:hidden;background:var(--surf);transition:transform .5s cubic-bezier(.4,0,.1,1),box-shadow .5s;will-change:transform}
.sc-track:hover .sc-tile{transform:scale(.94);opacity:.78;transition:transform .5s,opacity .5s}
.sc-tile:hover{transform:scale(1.22)!important;opacity:1!important;z-index:5;box-shadow:0 30px 60px rgba(0,0,0,.28)}
.sc-tile img{width:100%;height:100%;object-fit:cover;filter:grayscale(1) contrast(1.03);transition:filter .5s ease;pointer-events:none}
.sc-tile:hover img{filter:none}
.sc-tile.proj{cursor:pointer}
.showcase .sc-tile.proj:hover{cursor:pointer}
.sc-cap{position:absolute;left:0;bottom:0;width:100%;padding:14px 14px 12px;background:linear-gradient(0deg,rgba(0,0,0,.72),transparent);opacity:0;transform:translateY(6px);transition:opacity .4s,transform .4s}
.sc-tile:hover .sc-cap{opacity:1;transform:none}
.sc-cap .n{font-family:var(--font-display);text-transform:uppercase;font-size:14px;color:#fff;line-height:1;letter-spacing:.01em}
.sc-cap .t{font-family:var(--font-med);font-size:9.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);margin-top:5px;display:block}
@media(max-width:680px){.sc-tile{width:46vw}.sc-tile:hover{transform:scale(1.08)!important}}
/* remote band */
.remote{display:grid;grid-template-columns:1.4fr 1fr;gap:clamp(24px,5vw,70px);align-items:end}
@media(max-width:820px){.remote{grid-template-columns:1fr;gap:18px}}
.remote .rt{font-size:15px;line-height:1.7;color:var(--soft);max-width:520px}
/* positions app */
.jobs-tools{display:flex;flex-direction:column;gap:14px;margin-top:34px}
.jsearch{display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:var(--surf);padding:12px 16px}
.jsearch input{flex:1;background:none;border:none;outline:none;color:var(--text);font-family:var(--font-body);font-size:15px}
.jsearch input::placeholder{color:var(--muted)}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{font-family:var(--font-med);font-size:12px;border:1px solid var(--line);border-radius:999px;padding:7px 15px;cursor:pointer;color:var(--soft);background:transparent;transition:.2s}
.chip:hover{border-color:var(--pink);color:var(--text)}
.chip.on{background:var(--text);color:var(--bg);border-color:var(--text)}
.chips-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.chips-lbl{font-family:var(--font-med);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-right:4px}
.jcount{font-family:var(--font-med);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-top:26px}
.jobs-list{margin-top:14px;border-top:1px solid var(--line)}
.job{display:grid;grid-template-columns:1.5fr 1fr auto;align-items:center;gap:18px;padding:22px 6px;border-bottom:1px solid var(--line);cursor:pointer;transition:background .2s,padding-left .2s}
.job:hover{background:var(--surf);padding-left:16px}
.job .jt{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(18px,1.9vw,26px);line-height:1.02;letter-spacing:-.01em}
.job .jm{font-family:var(--font-med);font-size:12px;letter-spacing:.06em;color:var(--muted)}
.job .jloc{font-size:12px;color:var(--soft);text-transform:uppercase;letter-spacing:.08em}
.job .jarrow{justify-self:end;color:var(--muted);font-size:20px;transition:transform .2s,color .2s}
.job:hover .jarrow{color:var(--pink);transform:translateX(4px)}
.job .jtag{display:inline-block;font-family:var(--font-med);font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--pink);border:1px solid var(--line);border-radius:999px;padding:3px 9px;margin-left:10px;vertical-align:middle}
.jobs-empty{padding:28px 6px;color:var(--muted);font-size:14px}
@media(max-width:680px){.job{grid-template-columns:1fr auto}.job .jm{display:none}.job .jloc{grid-column:1;color:var(--muted);font-size:11px}}
/* drawer */
.scrim{position:fixed;inset:0;z-index:110;background:rgba(0,0,0,.55);opacity:0;visibility:hidden;transition:opacity .35s,visibility .35s}
.scrim.open{opacity:1;visibility:visible}
.drawer{position:fixed;inset:0;z-index:111;background:var(--bg);overflow-y:auto;opacity:0;visibility:hidden;transform:translateY(22px);transition:opacity .4s ease,visibility .4s,transform .45s cubic-bezier(.4,0,.1,1)}
.drawer.open{opacity:1;visibility:visible;transform:none}
.dr-x{position:fixed;top:18px;right:clamp(16px,3vw,40px);background:var(--bg);border:1px solid var(--line);color:var(--text);width:42px;height:42px;border-radius:50%;font-size:22px;line-height:40px;text-align:center;cursor:pointer;z-index:6;transition:.2s;padding:0}
.dr-x:hover{border-color:var(--pink);color:var(--pink)}
.dr-x:hover{color:var(--pink)}
.dr-in{max-width:860px;margin:0 auto;padding:clamp(58px,8vh,100px) var(--pad) 90px}
.dr-head{margin-bottom:6px}
.dr-posted{font-family:var(--font-med);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:14px}
.dr-overview{margin-top:22px}
.dr-overview p{font-size:15.5px;line-height:1.72;color:var(--soft);margin:0 0 .9em}
.dr-applybtn{justify-content:center}
.dr-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:24px}
.dr-share{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.dr-share .lbl{font-family:var(--font-med);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-right:2px}
.shbtn{display:inline-flex;align-items:center;gap:8px;border:1.5px solid var(--line);border-radius:999px;padding:10px 16px;font-family:var(--font-med);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text);background:none;cursor:pointer;transition:.2s;text-decoration:none}
.shbtn:hover{border-color:var(--pink);color:var(--pink)}
.shbtn svg{width:15px;height:15px;fill:currentColor}
/* company snapshot infographic (home numbers) */
.dr-company{margin-top:34px;border:1px solid var(--line);background:var(--surf);border-radius:14px;padding:clamp(22px,3vw,30px)}
.dr-company>.k{font-family:var(--font-med);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--pink)}
.dr-company p{font-size:13.5px;line-height:1.65;color:var(--soft);margin-top:10px}
.dr-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin-top:24px}
@media(max-width:640px){.dr-stats{grid-template-columns:repeat(3,1fr);gap:20px 14px}}
.dr-stats .n{font-family:var(--font-display);font-size:clamp(26px,3.4vw,40px);line-height:1;color:var(--text);letter-spacing:-.01em}
.dr-stats .n .pk{color:var(--pink)}
.dr-stats .l{font-family:var(--font-med);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:8px}
/* accordions */
.dr-acc{margin-top:34px;border-top:1px solid var(--line)}
.dr-acci{border-bottom:1px solid var(--line)}
.dr-acch{width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;text-align:left;appearance:none;background:none;border:0;cursor:pointer;padding:20px 0;font:inherit;color:var(--text);transition:color .2s}
.dr-acch:hover .t{color:var(--pink)}
.dr-acch .t{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(16px,1.9vw,22px);letter-spacing:-.01em;line-height:1;transition:color .2s}
.dr-acch .ch{flex:0 0 auto;width:28px;height:28px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--muted);transition:.25s}
.dr-acch .ch::before{content:"+";font-family:var(--font-med);font-size:17px;line-height:1}
.dr-acci.open .dr-acch .ch{background:var(--pink);border-color:var(--pink);color:#fff;transform:rotate(45deg)}
.dr-accb{display:grid;grid-template-rows:0fr;transition:grid-template-rows .35s ease}
.dr-acci.open .dr-accb{grid-template-rows:1fr}
.dr-accb-in{overflow:hidden}
.dr-accb .sb{font-size:13.5px;line-height:1.6;color:var(--soft);padding-bottom:4px}
.dr-accb ul{list-style:none;padding-bottom:20px}
.dr-accb li{position:relative;font-size:14px;line-height:1.5;color:var(--soft);padding:7px 0 7px 18px}
.dr-accb li+li{border-top:1px dashed var(--line)}
.dr-accb li::before{content:"›";position:absolute;left:0;color:var(--pink)}
.dr-applywrap{max-width:680px;margin:clamp(26px,3vw,44px) auto 0}
.dr-eyebrow{font-family:var(--font-med);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--pink)}
.dr-title{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(26px,3.4vw,40px);line-height:1;margin-top:8px;letter-spacing:-.01em}
.dr-meta{display:flex;gap:10px;flex-wrap:wrap;margin-top:14px}
.dr-meta span{font-family:var(--font-med);font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--soft);border:1px solid var(--line);border-radius:999px;padding:6px 12px}
.dr-desc{font-size:15px;line-height:1.7;color:var(--soft);margin-top:22px}
.dr-look{margin-top:20px}
.dr-look .k{font-family:var(--font-med);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.dr-look ul{list-style:none;margin-top:10px}
.dr-look li{font-size:14px;color:var(--soft);padding:6px 0;border-bottom:1px dashed var(--line)}
.dr-posted{font-family:var(--font-med);font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:14px}
.dr-about{margin-top:22px;padding:16px 18px;border:1px solid var(--line);background:var(--surf);font-size:13.5px;line-height:1.6;color:var(--soft)}
.dr-about b{font-family:var(--font-med);color:var(--text);font-weight:400}
.dr-sec{margin-top:26px}
.dr-sec>.k{font-family:var(--font-med);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--pink)}
.dr-sec .sb{font-size:14px;line-height:1.65;color:var(--soft);margin-top:9px}
.dr-sec ul{list-style:none;margin-top:11px}
.dr-sec li{position:relative;font-size:14px;line-height:1.5;color:var(--soft);padding:7px 0 7px 18px;border-bottom:1px dashed var(--line)}
.dr-sec li::before{content:"›";position:absolute;left:0;color:var(--pink)}
.dr-divider{height:1px;background:var(--line);margin:30px 0 0}
.dr-look li::before{content:"› ";color:var(--pink)}
/* apply form */
.apply{margin-top:30px;border-top:1px solid var(--line);padding-top:26px}
.apply h3{font-family:var(--font-display);text-transform:uppercase;font-size:20px;letter-spacing:-.01em}
.field{margin-top:16px}
.field label{display:block;font-family:var(--font-med);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:7px}
.field input,.field textarea{width:100%;background:var(--surf);border:1px solid var(--line);color:var(--text);font-family:var(--font-body);font-size:15px;padding:12px 14px;outline:none;transition:border-color .2s}
.field input:focus,.field textarea:focus{border-color:var(--pink)}
.field textarea{resize:vertical;min-height:90px}
.apply .btn.primary{margin-top:20px;width:100%;justify-content:center;border:none}
.apply .note{font-size:12px;color:var(--muted);margin-top:12px;line-height:1.5}
.apply.sent .apply-form{display:none}
.apply-thanks{display:none}
.apply.sent .apply-thanks{display:block}
.apply-thanks .tk{font-family:var(--font-display);text-transform:uppercase;font-size:24px;color:var(--pink)}
.apply-thanks p{font-size:14px;color:var(--soft);margin-top:10px;line-height:1.6}
/* general apply */
.gapply{text-align:center}
.gapply .big{margin:0 auto}
.gapply .lead{margin:24px auto 0}
.gapply .cta-row{justify-content:center}
/* footer */
.site-foot{background:#070707;color:#f3f1ea;border-top:1px solid rgba(255,255,255,.1);padding:clamp(54px,7vw,84px) 0 34px}
.sf-eyebrow{font-family:var(--font-med);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--pink)}
.sf-hi{font-family:var(--font-display);font-size:clamp(26px,4vw,52px);text-transform:uppercase;line-height:.98;letter-spacing:-.02em;margin-top:10px}
.sf-hi #footHi{display:inline-block;transition:opacity .22s ease,transform .22s ease}
.sf-hi #footHi.swap{opacity:0;transform:translateY(8px)}
.sf-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:24px}
.btn-foot{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:999px;font-family:var(--font-med);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;transition:transform .2s,background .2s,color .2s,border-color .2s;border:1.5px solid transparent}
.btn-foot.primary{background:var(--pink);color:#fff;border-color:var(--pink)}
.btn-foot.primary:hover{transform:translateY(-2px)}
.btn-foot.ghost{border-color:rgba(255,255,255,.25);color:#f3f1ea}
.btn-foot.ghost:hover{border-color:var(--pink);color:var(--pink)}
