/* showcase: auto-loop carousel + drag-to-scroll */
(function(){
  const sc=document.getElementById('showcase'),track=document.getElementById('scTrack');if(!sc||!track)return;
  /* duplicate tiles so the loop is seamless */
  track.querySelectorAll('.sc-tile').forEach(t=>track.appendChild(t.cloneNode(true)));
  let down=false,sx=0,sl=0,moved=0,paused=false,half=0;
  const measure=()=>{half=track.scrollWidth/2;};
  measure();window.addEventListener('resize',measure);
  /* auto-advance */
  let last=performance.now();const SPEED=38; /* px per second */
  function tick(now){
    const dt=(now-last)/1000;last=now;
    if(!paused&&!down){
      sc.scrollLeft+=SPEED*dt;
      if(half&&sc.scrollLeft>=half)sc.scrollLeft-=half;
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
  /* pause on hover */
  sc.addEventListener('pointerenter',()=>paused=true);
  sc.addEventListener('pointerleave',()=>paused=false);
  /* drag */
  sc.addEventListener('pointerdown',e=>{down=true;moved=0;sx=e.clientX;sl=sc.scrollLeft;sc.classList.add('drag');sc.setPointerCapture(e.pointerId);});
  sc.addEventListener('pointermove',e=>{if(!down)return;const d=e.clientX-sx;moved=Math.max(moved,Math.abs(d));sc.scrollLeft=sl-d;});
  const end=()=>{down=false;sc.classList.remove('drag');if(half){if(sc.scrollLeft>=half)sc.scrollLeft-=half;else if(sc.scrollLeft<0)sc.scrollLeft+=half;}};
  sc.addEventListener('pointerup',end);sc.addEventListener('pointercancel',end);
  sc.addEventListener('click',e=>{if(moved>6)e.preventDefault();},true);
  sc.addEventListener('wheel',e=>{if(Math.abs(e.deltaX)<Math.abs(e.deltaY)){sc.scrollLeft+=e.deltaY;e.preventDefault();}},{passive:false});
})();

