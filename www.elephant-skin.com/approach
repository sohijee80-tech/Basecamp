<style>
:root{
  --pink:#FF5A2E;--pad:clamp(24px,3.5vw,56px);
  --bg:#070707;--text:#f3f1ea;--muted:#8a867d;--soft:#cfcbc0;--line:rgba(255,255,255,.10);--surf:rgba(255,255,255,.03);
  --font-display:'Etna','Helvetica Neue',Arial,sans-serif;
  --font-body:'Aaux Pro Light','Helvetica Neue',Arial,sans-serif;
  --font-med:'Aaux Pro Medium','Helvetica Neue',Arial,sans-serif;
}
html[data-theme="light"]{--bg:#f3f1ea;--text:#16130f;--muted:#6a665d;--soft:#46423a;--line:rgba(0,0,0,.13);--surf:rgba(0,0,0,.025)}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--font-body);-webkit-font-smoothing:antialiased;line-height:1.55;overflow-x:hidden;transition:background .4s,color .4s}
a{color:inherit;text-decoration:none}
::selection{background:var(--pink);color:#fff}
.wrap{max-width:none;margin:0;padding:0 var(--pad)}
.pink{color:var(--pink)}
section{position:relative}

/* top bar */
.bar{position:fixed;top:0;left:0;right:0;z-index:60;display:flex;align-items:center;justify-content:space-between;padding:20px var(--pad);transition:background .3s}
.bar.scrolled{background:color-mix(in srgb,var(--bg) 80%,transparent);backdrop-filter:blur(12px)}
.bar .lg img{height:25px;display:block}
.bar-right{display:flex;align-items:center;gap:14px}
.themetog{display:flex;border:1px solid var(--line);border-radius:999px;overflow:hidden}
.themetog button{border:none;background:none;color:var(--muted);padding:7px 11px;cursor:pointer;font-size:13px;line-height:1;transition:.2s}
.themetog button.on{background:var(--text);color:var(--bg)}
.menu-btn{background:none;border:none;color:var(--text);cursor:pointer;font-family:var(--font-display);font-size:20px;letter-spacing:.04em;text-transform:uppercase;transition:color .25s}
.menu-btn:hover{color:var(--pink)}

/* menu overlay */
.menu-overlay{position:fixed;inset:0;z-index:100;background:var(--pink);color:#0a0a0a;padding:54px 56px;display:flex;flex-direction:column;justify-content:space-between;transform:translateY(-102%);opacity:0;visibility:hidden;transition:transform .6s cubic-bezier(.76,0,.24,1),opacity .4s,visibility .6s}
.menu-overlay.open{transform:none;opacity:1;visibility:visible}
.menu-close{position:absolute;top:46px;right:52px;width:46px;height:46px;font-size:38px;cursor:pointer;background:none;border:none;color:#0a0a0a;line-height:1}
.menu-logo{height:26px;align-self:flex-start;margin-bottom:10px}
.menu-nav a{display:inline-block;font-family:var(--font-display);font-size:clamp(28px,4.6vw,54px);color:#fff;text-transform:uppercase;line-height:1.14;transition:padding-left .28s,color .2s}
.menu-nav a:hover{padding-left:18px;color:#0a0a0a}
.menu-foot{max-width:680px}
.menu-foot .slogan{font-family:var(--font-display);font-size:clamp(18px,2.4vw,26px);text-transform:uppercase}
.menu-foot p{margin-top:16px;font-size:13px;color:rgba(10,10,10,.72);max-width:540px;line-height:1.6}
.menu-social{margin-top:20px;display:flex;gap:14px}
.menu-social a{width:36px;height:36px;border:1.5px solid rgba(10,10,10,.55);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-med);font-size:12px;color:#0a0a0a;transition:.2s}
.menu-social a:hover{background:#0a0a0a;color:var(--pink)}
@media(max-width:600px){.menu-overlay{padding:36px 26px}.menu-close{top:30px;right:26px}.menu-logo{height:20px}}

/* shared bits */
.reveal{opacity:0;transform:translateY(30px);transition:opacity 1s ease,transform 1s ease}
.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}}
.snum{font-family:var(--font-med);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--pink);margin-bottom:18px;display:block}
.sec{padding-top:clamp(80px,12vh,150px);padding-bottom:clamp(80px,12vh,150px);border-top:1px solid var(--line);position:relative}
h2.big{font-family:var(--font-display);font-size:clamp(34px,6vw,88px);text-transform:uppercase;line-height:.93;letter-spacing:-.02em}
.lead{font-size:clamp(16px,1.8vw,24px);line-height:1.5;max-width:820px;margin-top:24px;color:var(--soft)}

/* hero */
.hero{min-height:92vh;display:flex;flex-direction:column;justify-content:center;padding-top:120px;padding-bottom:60px}
.hero h1{font-family:var(--font-display);font-size:clamp(48px,9vw,150px);text-transform:uppercase;line-height:.86;letter-spacing:-.02em}
.hero .lead{max-width:760px}

/* principles */
.princ{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:54px}
@media(max-width:900px){.princ{grid-template-columns:1fr}}
.pr{border:1px solid var(--line);border-radius:0;padding:30px;background:var(--surf);transition:border-color .3s,transform .3s}
.pr:hover{border-color:var(--pink);transform:translateY(-4px)}
.pr .pn{font-family:var(--font-display);font-size:34px;color:var(--pink);line-height:1}
.pr h3{font-family:var(--font-display);font-size:clamp(19px,1.8vw,24px);text-transform:uppercase;margin-top:16px;line-height:1.05}
.pr p{color:var(--muted);font-size:14.5px;margin-top:12px;line-height:1.6}

/* featured projects, expanding strip */
.pstrip{padding-top:clamp(70px,10vh,120px);padding-bottom:14px;border-top:1px solid var(--line)}
.pstrip-head{padding:0 var(--pad);display:flex;justify-content:space-between;align-items:flex-end;gap:40px;flex-wrap:wrap}
.pstrip-head h2{font-family:var(--font-display);font-size:clamp(30px,5vw,72px);line-height:.95;letter-spacing:-.02em;margin-top:14px;text-transform:none}
.pstrip-head h2 .pink{color:var(--pink)}
.pstrip-sub{max-width:420px;text-align:right;color:var(--muted);font-size:15px;line-height:1.6;padding-bottom:8px}
@media(max-width:760px){.pstrip-sub{text-align:left;max-width:100%}}
.pstrip-row{display:flex;width:100%;height:64vh;min-height:440px;margin-top:44px;gap:6px;padding:0 var(--pad)}
.pcard{position:relative;flex:1;overflow:hidden;border:1px solid transparent;transition:flex .6s cubic-bezier(.7,0,.2,1),border-color .4s;display:flex;align-items:flex-end;text-decoration:none;min-width:0}
.pcard-bg{position:absolute;inset:0;background-image:var(--img);background-size:cover;background-position:var(--pos,50% 50%);transform:scale(1.03);transition:transform .9s ease}
.pcard-shade{position:absolute;inset:0;background:linear-gradient(to top, rgba(5,5,5,.82) 0%, rgba(5,5,5,.25) 24%, transparent 42%)}
.pcard-meta{position:relative;z-index:2;padding:30px 26px;width:100%}
.pcard-idx{font-family:var(--font-med);font-size:12px;letter-spacing:.16em;color:var(--pink)}
.pcard-meta h3{font-family:var(--font-display);font-size:clamp(20px,2vw,34px);text-transform:uppercase;line-height:.95;margin-top:8px;color:#fff;white-space:nowrap}
.pcard-cat{display:block;font-size:13px;color:#cfcbc0;margin-top:10px;opacity:0;transform:translateY(8px);max-height:0;overflow:hidden;transition:opacity .4s ease,transform .4s ease,max-height .4s ease}
.pstrip-row:hover .pcard{flex:.7}
.pstrip-row .pcard:hover{flex:3.4;border-color:rgba(255,90,46,.45)}
.pcard:hover .pcard-bg{transform:scale(1)}
.pcard:hover .pcard-cat{opacity:1;transform:none;max-height:60px}
.pstrip-foot{padding:32px var(--pad) 0}
.pstrip-foot a{font-family:var(--font-med);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);border-bottom:1px solid var(--pink);padding-bottom:4px;transition:gap .2s}
@media(max-width:820px){
  .pstrip-row{flex-direction:column;height:auto;gap:8px}
  .pcard{height:190px;flex:none!important}
  .pcard-cat{opacity:1;transform:none;max-height:60px}
}

/* CHEF framework, interactive letter tiles */
.chips{display:flex;flex-wrap:wrap;gap:9px}
.chips span{font-family:var(--font-med);font-size:12px;letter-spacing:.02em;border:1px solid var(--line);color:var(--text);padding:8px 14px;border-radius:999px;transition:.2s}
.chips span:hover{border-color:var(--pink);color:var(--pink)}
.chef-tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:50px}
@media(max-width:680px){.chef-tiles{grid-template-columns:1fr 1fr}}
.chef-tile{position:relative;border:1px solid var(--line);background:var(--surf);min-height:clamp(150px,16vw,210px);display:flex;flex-direction:column;justify-content:space-between;padding:22px;cursor:pointer;transition:border-color .3s,background .3s}
.chef-tile:hover{border-color:var(--pink)}
.chef-tile.on{border-color:var(--pink);background:rgba(255,90,46,.07)}
.chef-tile .cl{font-family:var(--font-display);font-size:clamp(50px,6vw,98px);line-height:.8;color:var(--text);transition:color .3s}
.chef-tile.on .cl,.chef-tile:hover .cl{color:var(--pink)}
.chef-tile .cn{font-family:var(--font-med);font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--text)}
.chef-tile .cs{font-size:13px;color:var(--muted);margin-top:5px;font-style:italic;font-family:Georgia,serif}
.chef-detail{margin-top:14px;border:1px solid var(--pink);background:var(--surf);padding:clamp(26px,3vw,40px)}
.chef-detail .cdq{font-family:var(--font-display);font-size:clamp(20px,2.4vw,34px);text-transform:uppercase;line-height:1.02;color:var(--text)}
.chef-detail .cdq b{color:var(--pink);font-weight:400}
.chef-detail .cdsub{font-style:italic;color:var(--muted);margin-top:8px;font-size:15px}
.chef-detail .cdgrid{display:grid;grid-template-columns:1.3fr 1fr;gap:30px;margin-top:24px}
@media(max-width:760px){.chef-detail .cdgrid{grid-template-columns:1fr}}
.chef-detail .cdk{font-family:var(--font-med);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:10px}
.chef-detail .cdo{color:var(--soft);font-size:15px;line-height:1.6}
.chef-creates{margin-top:42px;font-family:var(--font-display);font-size:clamp(22px,2.6vw,40px);text-transform:uppercase;text-align:center;color:var(--text);line-height:1.05}
.chef-creates b{color:var(--pink);font-weight:400}
.reg{color:var(--pink);font-size:.26em;vertical-align:top;line-height:1;position:relative;top:.1em;margin-left:.04em}
.reg2{font-size:.62em;vertical-align:super;color:var(--pink)}
/* chef header + trio images */
.chef-top{display:grid;grid-template-columns:1fr;gap:clamp(30px,4vw,56px);align-items:start;margin-top:8px}
.chef-os-head{max-width:720px}
@media(max-width:980px){.chef-top{grid-template-columns:1fr;gap:28px}}
.chef-title{font-family:var(--font-display);font-size:clamp(54px,9vw,128px);line-height:.84;letter-spacing:-.02em;color:var(--text)}
.chef-lead{font-family:var(--font-med);font-size:clamp(15px,1.6vw,18px);letter-spacing:.16em;text-transform:uppercase;color:var(--text);margin-top:20px}
.chef-os-head .lead{margin-top:16px;max-width:560px;font-size:clamp(15px,1.5vw,18px)}
.chef-meta{font-family:var(--font-med);font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--pink);margin-top:22px;opacity:.85}
.chef-trio{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.chef-trio figure{margin:0}
.chef-trio img{width:100%;aspect-ratio:3/4;object-fit:cover;display:block;filter:grayscale(1) contrast(1.04);transition:filter .4s,transform .5s}
.chef-trio figure:hover img{filter:grayscale(1) contrast(1.08) brightness(1.06);transform:scale(1.015)}
.chef-trio figcaption{margin-top:12px;font-family:var(--font-display);font-size:clamp(13px,1.1vw,16px);text-transform:uppercase;color:var(--text);line-height:1.05}
.chef-trio figcaption span{display:block;font-family:var(--font-med);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);margin-bottom:5px}
.chef-tiles{margin-top:46px}
/* Real Estate 101 — particle convergence */
.chef-flow{margin-top:74px;text-align:center}
.cf-eyebrow{font-family:var(--font-med);font-size:12px;letter-spacing:.26em;text-transform:uppercase;color:var(--pink);margin-bottom:6px}
.chef-flow canvas{width:100%;height:clamp(260px,32vw,440px);display:block}
.cf-chips{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:10px;margin-top:6px}
.cf-chips .cfc{font-family:var(--font-med);font-size:13px;padding:9px 18px;border:1px solid var(--line);border-radius:8px;color:var(--text);transition:.2s;background:var(--surf)}
.cf-chips .cfc.on{background:var(--pink);border-color:var(--pink);color:#fff}
.cf-chips .arr{font-family:var(--font-med);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.cf-caption{margin-top:18px;color:var(--muted);font-size:clamp(15px,1.5vw,19px)}
/* phase timeline (CHEF Scope) */
.chef-phases{margin-top:74px;width:100vw;margin-left:calc(50% - 50vw);background:var(--surf);color:var(--text);padding:clamp(28px,4vw,52px) var(--pad);border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.cp-track{display:grid;grid-template-columns:repeat(7,1fr)}
.cp-ph{position:relative;padding:16px 12px 20px;cursor:pointer;border-left:1px solid var(--line);transition:background .3s}
.cp-ph:first-child{border-left:none}
.cp-ph.on{background:rgba(255,90,46,.12)}
.cp-ph .cpn{font-family:var(--font-display);font-size:clamp(30px,3.2vw,54px);color:var(--muted);opacity:.5;line-height:.9;transition:color .3s,opacity .3s}
.cp-ph.scope .cpn{opacity:.75}
.cp-ph.on .cpn{color:var(--pink);opacity:1}
.cp-ph .cpdot{width:9px;height:9px;border-radius:50%;background:var(--muted);opacity:.5;margin:10px 0;transition:.3s}
.cp-ph.on .cpdot{background:var(--pink);opacity:1;box-shadow:0 0 12px var(--pink)}
.cp-ph .cpt{font-family:var(--font-med);font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--text);line-height:1.3}
.cp-ph .cpp{font-size:9.5px;color:var(--muted);margin-top:8px}
.cp-ph .cpp b{color:var(--pink);font-weight:400}
.cp-detail{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-top:30px;flex-wrap:wrap}
.cpd-ph{font-family:var(--font-med);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);display:flex;gap:12px;align-items:center}
.cpd-badge{border:1px solid var(--pink);border-radius:999px;padding:3px 11px;font-size:9px;letter-spacing:.12em}
.cpd-l h3{font-family:var(--font-display);font-size:clamp(28px,4vw,52px);text-transform:uppercase;margin-top:12px;line-height:1}
.cpd-l p{color:var(--muted);font-size:14px;margin-top:10px;max-width:520px;line-height:1.5}
.cpd-nav{display:flex;align-items:center;gap:14px}
.cp-nav-btn{width:46px;height:46px;border-radius:50%;border:1px solid var(--line);background:none;color:var(--text);cursor:pointer;font-size:16px;transition:.2s;display:flex;align-items:center;justify-content:center}
.cp-nav-btn:hover{border-color:var(--pink);color:var(--pink)}
.cp-nav-btn.play{border-color:var(--pink);color:var(--pink)}
.cp-count{font-family:var(--font-med);font-size:13px;letter-spacing:.1em;color:var(--muted)}
@media(max-width:820px){.cp-track{grid-auto-flow:column;grid-template-columns:none;grid-auto-columns:minmax(120px,1fr);overflow-x:auto}}

/* growth engine accordion */
.pillars{margin-top:50px}
.pill{border:1px solid var(--line);border-radius:0;margin-bottom:12px;overflow:hidden;background:var(--surf);transition:border-color .3s}
.pill.open{border-color:var(--pink)}
.pill-head{display:flex;align-items:center;gap:20px;padding:24px 26px;cursor:pointer}
.pill .px{font-family:var(--font-display);font-size:26px;color:var(--pink);line-height:1;flex:0 0 auto}
.pill .ph{font-family:var(--font-display);font-size:clamp(18px,1.9vw,26px);text-transform:uppercase;line-height:1.05;flex:1}
.pill .parr{flex:0 0 auto;color:var(--muted);transition:transform .3s}
.pill.open .parr{transform:rotate(90deg);color:var(--pink)}
.pill-body{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.4,0,.2,1)}
.pill-in{padding:0 26px 26px;display:grid;grid-template-columns:1.2fr 1fr;gap:26px}
@media(max-width:760px){.pill-in{grid-template-columns:1fr}}
.pill-in .pd{color:var(--soft);font-size:15px;line-height:1.6}
.pill-in ul{list-style:none}
.pill-in li{font-family:var(--font-med);font-size:13.5px;color:var(--muted);padding:7px 0;border-bottom:1px dashed var(--line)}
.pill-in li::before{content:"› ";color:var(--pink)}

/* outcomes */
.outcomes{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:50px}
@media(max-width:900px){.outcomes{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.outcomes{grid-template-columns:1fr}}
.oc{border:1px solid var(--line);border-radius:0;padding:26px;background:var(--surf);transition:.3s}
.oc:hover{border-color:var(--pink);transform:translateY(-3px)}
.oc .ocn{font-family:var(--font-med);font-size:11px;letter-spacing:.16em;color:var(--pink);text-transform:uppercase}
.oc h4{font-family:var(--font-display);font-size:clamp(20px,2vw,28px);text-transform:uppercase;margin-top:12px;line-height:1.05}

/* footer */
.site-foot{background:#070707;color:#f3f1ea;border-top:1px solid rgba(255,255,255,.1);padding:clamp(54px,7vw,84px) 0 34px}
.sf-eyebrow{font-family:var(--font-med);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--pink)}
.sf-hi{font-family:var(--font-display);font-size:clamp(26px,4vw,52px);text-transform:uppercase;line-height:.98;letter-spacing:-.02em;margin-top:10px}
.sf-hi #footHi{display:inline-block;transition:opacity .22s ease,transform .22s ease}
.sf-hi #footHi.swap{opacity:0;transform:translateY(8px)}
.sf-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:24px}
.btn-foot{display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:999px;font-family:var(--font-med);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;transition:transform .2s,background .2s,color .2s,border-color .2s;border:1.5px solid transparent}
.btn-foot.primary{background:var(--pink);color:#fff;border-color:var(--pink)}
.btn-foot.primary:hover{transform:translateY(-2px)}
.btn-foot.ghost{border-color:rgba(255,255,255,.25);color:#f3f1ea}
.btn-foot.ghost:hover{border-color:var(--pink);color:var(--pink)}
