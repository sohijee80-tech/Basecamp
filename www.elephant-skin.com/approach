/* Real Estate 101 — interactive funnel: macro → one */
(function(){
  const cv=document.getElementById('chefFlow');if(!cv)return;const ctx=cv.getContext('2d');
  let W,H,dpr,nodes=[],order=[],raf,running=false,t=0,level=0;
  const TARGET=[1,0.4,0.14,0.008]; // fraction of particles kept at each step (ends at ~1)
  function build(){nodes=[];const N=170;for(let i=0;i<N;i++){nodes.push({sx:Math.random()*W*0.8,sy:Math.random()*H,pink:Math.random()<0.24,sz:Math.random()*2.4+0.6,sp:0.2+Math.random()*0.8,ph:Math.random()*6.3,t:Math.random(),pri:Math.random(),a:1,active:true});}
    order=nodes.map((n,i)=>i).sort((x,y)=>nodes[x].pri-nodes[y].pri);applyLevel();}
  function applyLevel(){const K=Math.max(1,Math.round(nodes.length*TARGET[level]));const set=new Set(order.slice(0,K));nodes.forEach((n,i)=>n.active=set.has(i));}
  function size(){const r=cv.getBoundingClientRect();if(!r.width)return;dpr=Math.min(devicePixelRatio||1,2);W=r.width;H=r.height;cv.width=W*dpr;cv.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);build();}
  function col(){return getComputedStyle(document.documentElement).getPropertyValue('--muted').trim();}
  function frame(){if(!running)return;t++;ctx.clearRect(0,0,W,H);const fx=W*0.93,fy=H*0.5;const c=col();
    nodes.forEach(n=>{n.a+=((n.active?1:0)-n.a)*0.08;if(n.a<0.012)return;const mx=(n.sx+fx)/2,my=n.sy+(fy-n.sy)*0.2;
      ctx.strokeStyle=n.pink?'rgba(255,90,46,'+(0.24*n.a)+')':'rgba(140,140,140,'+(0.16*n.a)+')';ctx.lineWidth=0.7;ctx.beginPath();ctx.moveTo(n.sx,n.sy);ctx.quadraticCurveTo(mx,my,fx,fy);ctx.stroke();
      ctx.globalAlpha=n.a*(0.45+0.4*Math.sin(t*0.02*n.sp+n.ph));ctx.fillStyle=n.pink?'#FF5A2E':c;ctx.beginPath();ctx.arc(n.sx,n.sy,n.sz,0,6.3);ctx.fill();ctx.globalAlpha=1;
      const tt=(n.t+t*0.0016*n.sp)%1,u=1-tt,px=u*u*n.sx+2*u*tt*mx+tt*tt*fx,py=u*u*n.sy+2*u*tt*my+tt*tt*fy;
      if(n.pink){ctx.globalAlpha=n.a;ctx.fillStyle='rgba(255,90,46,.55)';ctx.beginPath();ctx.arc(px,py,1.2,0,6.3);ctx.fill();ctx.globalAlpha=1;}});
    const fr=22+(level===3?6:0);const g=ctx.createRadialGradient(fx,fy,0,fx,fy,fr);g.addColorStop(0,'rgba(255,90,46,.92)');g.addColorStop(1,'rgba(255,90,46,0)');ctx.fillStyle=g;ctx.beginPath();ctx.arc(fx,fy,fr,0,6.3);ctx.fill();
    ctx.fillStyle='#FF5A2E';ctx.beginPath();ctx.arc(fx,fy,level===3?5:3.8,0,6.3);ctx.fill();
    raf=requestAnimationFrame(frame);}
  function start(){if(running)return;running=true;size();raf=requestAnimationFrame(frame);}
  function stop(){running=false;cancelAnimationFrame(raf);}
  new IntersectionObserver(es=>es.forEach(e=>e.isIntersecting?start():stop()),{threshold:.05}).observe(cv);
  addEventListener('resize',size);
  /* chips drive the funnel level */
  const CHIPS=['Brief','Craft','Trust','Growth'];
  const CAPS=['Brief creates craft.','Craft creates trust.','Trust creates growth.','Everything converges into one: growth.'];
  const wrap=document.getElementById('cfChips');
  wrap.innerHTML=CHIPS.map((s,i)=>`<span class="cfc" data-i="${i}">${s}</span>${i<3?'<span class="arr">creates →</span>':''}`).join('');
  const cap=document.getElementById('cfCaption'),cfc=[...wrap.querySelectorAll('.cfc')];
  let auto=null;
  function setLevel(i){level=i;applyLevel();cfc.forEach((c,k)=>c.classList.toggle('on',k===i));cap.textContent=CAPS[i];}
  function startAuto(){stopAuto();auto=setInterval(()=>setLevel((level+1)%4),2400);}
  function stopAuto(){if(auto){clearInterval(auto);auto=null;}}
  cfc.forEach((c,i)=>{c.style.cursor='pointer';c.addEventListener('mouseenter',()=>{stopAuto();setLevel(i);});c.addEventListener('click',()=>{stopAuto();setLevel(i);});});
  wrap.addEventListener('mouseleave',startAuto);
  setLevel(0);startAuto();
})();

/* CHEF® Scope, phase timeline */
(function(){
  const PHASES=[
    ['01','Brief','Where it all begins, understanding the brand, audience, and objective.',false,''],
    ['02','Concept','Turning the brief into a story worth telling, script, mood, direction.',true,'KIT Scope'],
    ['03','Production','On set, in-house crew, precision execution, no outsourced gaps.',true,'KIT Scope'],
