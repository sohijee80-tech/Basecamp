    ['05','Animation & AI','2D, 3D, motion graphics, and AI-assisted pipelines, layered in where needed.',true,'KIT Scope'],
    ['06','Delivery','The objective of the whole system, a launch-ready, full-screen-confident piece.',false,'']
  ];
  const track=document.getElementById('cpTrack');if(!track)return;
  track.innerHTML=PHASES.map((p,i)=>`<div class="cp-ph ${p[3]?'scope':''}" data-i="${i}"><div class="cpn">${p[0]}</div><div class="cpdot"></div><div class="cpt">${p[1]}</div><div class="cpp">Powered by <b>THE KIT®</b></div></div>`).join('');
  let pi=2,timer=null;
  function show(i){pi=(i+6)%6;const p=PHASES[pi];
    document.querySelectorAll('#cpTrack .cp-ph').forEach((el,k)=>el.classList.toggle('on',k===pi));
    document.getElementById('cpdPh').innerHTML=`Phase ${p[0]}${p[4]?` <span class="cpd-badge">${p[4]}</span>`:''}`;
    document.getElementById('cpdTitle').textContent=p[1];
    document.getElementById('cpdDesc').textContent=p[2];
    document.getElementById('cpCount').textContent=p[0]+' / 06';}
  document.querySelectorAll('#cpTrack .cp-ph').forEach(el=>el.addEventListener('click',()=>show(+el.dataset.i)));
  document.getElementById('cpPrev').addEventListener('click',()=>show(pi-1));
  document.getElementById('cpNext').addEventListener('click',()=>show(pi+1));
  document.getElementById('cpPlay').addEventListener('click',function(){if(timer){clearInterval(timer);timer=null;this.textContent='▶';}else{this.textContent='❚❚';timer=setInterval(()=>show(pi+1),2200);}});
  show(2);
})();

