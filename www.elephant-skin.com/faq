  try{var t=localStorage.getItem('es_theme')||((new Date().getHours()>=8&&new Date().getHours()<17)?'light':'dark');root.setAttribute('data-theme',t);}catch(e){}
  function syncTog(){var th=root.getAttribute('data-theme');document.querySelectorAll('#themeTog button').forEach(function(b){b.classList.toggle('on',b.dataset.theme===th);});}
  syncTog();
  document.querySelectorAll('#themeTog button').forEach(function(b){b.addEventListener('click',function(){root.setAttribute('data-theme',b.dataset.theme);try{localStorage.setItem('es_theme',b.dataset.theme);}catch(e){}syncTog();});});
  var menu=document.getElementById('menu');
  document.getElementById('menuBtn').addEventListener('click',function(){menu.classList.add('open');});
  document.getElementById('menuClose').addEventListener('click',function(){menu.classList.remove('open');});
  var bar=document.getElementById('bar');
  addEventListener('scroll',function(){bar.classList.toggle('scrolled',scrollY>20);},{passive:true});
  var his=['Hi.','Olá.','Salut.','Ciao.','Hola.','Oi.','Xin chào.','Hallo.'],hi=0,el=document.getElementById('footHi');
  if(el)setInterval(function(){el.classList.add('swap');setTimeout(function(){hi=(hi+1)%his.length;el.textContent=his[hi];el.classList.remove('swap');},220);},2600);
})();

