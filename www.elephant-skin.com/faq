var bySlug={};FAQ.forEach(function(f){bySlug[f.slug]=f;});

/* ===== render ===== */
var main=document.getElementById('faqMain'),emptyEl=document.getElementById('faqEmpty');
function esc(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
CATS.forEach(function(c){
  var items=FAQ.filter(function(f){return f.cat===c[0];});
  var sec=document.createElement('section');sec.className='faq-cat';sec.id='cat-'+c[0];sec.dataset.cat=c[0];
  var h='<div class="faq-cat-h">'+c[1]+'</div>';
  items.forEach(function(f){
    var rel=(f.rel||[]).map(function(s){var t=bySlug[s];return t?'<a href="#'+s+'" data-jump="'+s+'">'+esc(t.q)+'</a>':'';}).join('');
    h+='<article class="faq-card" id="'+f.slug+'" data-slug="'+f.slug+'" data-cat="'+f.cat+'">'
      +'<button class="faq-q" aria-expanded="false" aria-controls="b-'+f.slug+'"><span class="plus" aria-hidden="true"></span><span class="qt">'+esc(f.q)+'</span></button>'
      +'<div class="faq-body" id="b-'+f.slug+'" role="region"><div class="faq-body-in">'
        +'<div class="ans">'+f.a+'</div>'
        +'<div class="faq-meta"><button class="faq-copy" data-slug="'+f.slug+'">Copy link</button></div>'
        +(rel?'<div class="faq-rel"><div class="rh">Related questions</div>'+rel+'</div>':'')
      +'</div></div></article>';
  });
  sec.innerHTML=h;main.appendChild(sec);
});

/* category nav (desktop + mobile) */
var catNav=document.getElementById('catNav'),catMobile=document.getElementById('catMobile');
CATS.forEach(function(c){
  var n=FAQ.filter(function(f){return f.cat===c[0];}).length;
  var a=document.createElement('a');a.href='#cat-'+c[0];a.dataset.cat=c[0];a.innerHTML=c[1]+'<span class="n">'+n+'</span>';catNav.appendChild(a);
  var m=document.createElement('a');m.href='#cat-'+c[0];m.dataset.cat=c[0];m.textContent=c[1];catMobile.appendChild(m);
});

/* ===== accordion ===== */
function setOpen(card,open){
  var body=card.querySelector('.faq-body'),btn=card.querySelector('.faq-q');
  card.classList.toggle('open',open);btn.setAttribute('aria-expanded',open?'true':'false');
  if(open){body.style.maxHeight=body.scrollHeight+'px';}
  else{body.style.maxHeight=body.scrollHeight+'px';requestAnimationFrame(function(){body.style.maxHeight='0px';});}
}
function recalc(){document.querySelectorAll('.faq-card.open .faq-body').forEach(function(b){b.style.maxHeight=b.scrollHeight+'px';});}
addEventListener('resize',function(){clearTimeout(window._rz);window._rz=setTimeout(recalc,120);});

main.addEventListener('click',function(e){
  var q=e.target.closest('.faq-q');
  if(q){var card=q.closest('.faq-card');var open=!card.classList.contains('open');setOpen(card,open);
    if(open){history.replaceState(null,'','#'+card.dataset.slug);(window.esTrack||function(){})('faq_open',{slug:card.dataset.slug});}
    return;}
  var cp=e.target.closest('.faq-copy');
  if(cp){var slug=cp.dataset.slug;var url=location.origin+location.pathname+'#'+slug;
    (navigator.clipboard&&navigator.clipboard.writeText(url).then(done,done)||done());
    function done(){cp.classList.add('done');var o=cp.textContent;cp.textContent='Copied ✓';setTimeout(function(){cp.classList.remove('done');cp.textContent=o;},1600);}
    (window.esTrack||function(){})('faq_copy_link',{slug:slug});return;}
  var jp=e.target.closest('[data-jump]');
  if(jp){e.preventDefault();openBySlug(jp.dataset.jump,true);}
});

function openBySlug(slug,scroll){
  var card=document.getElementById(slug);if(!card)return;
  if(!card.classList.contains('open'))setOpen(card,true);
  history.replaceState(null,'','#'+slug);
  if(scroll)card.scrollIntoView({behavior:'smooth',block:'center'});
  (window.esTrack||function(){})('faq_open',{slug:slug});
}

/* keyboard: arrow keys move between questions, ESC closes */
main.addEventListener('keydown',function(e){
  var btns=[].slice.call(main.querySelectorAll('.faq-card:not([hidden]) .faq-q'));
  var i=btns.indexOf(document.activeElement);
  if(e.key==='ArrowDown'&&i>-1){e.preventDefault();(btns[i+1]||btns[0]).focus();}
  else if(e.key==='ArrowUp'&&i>-1){e.preventDefault();(btns[i-1]||btns[btns.length-1]).focus();}
  else if(e.key==='Escape'){var card=document.activeElement.closest&&document.activeElement.closest('.faq-card');if(card&&card.classList.contains('open'))setOpen(card,false);}
});

/* ===== expand / collapse all ===== */
var expBtn=document.getElementById('faqExpand'),allOpen=false;
expBtn.addEventListener('click',function(){
  allOpen=!allOpen;
  document.querySelectorAll('.faq-card').forEach(function(c){if(!c.hidden)setOpen(c,allOpen);});
  expBtn.textContent=allOpen?'Collapse all':'Expand all';expBtn.setAttribute('aria-expanded',allOpen?'true':'false');
  if(allOpen)(window.esTrack||function(){})('faq_expand_all',{});
});

/* ===== search (instant, highlight) ===== */
var input=document.getElementById('faqInput'),clr=document.getElementById('faqClear'),emptyQ=document.getElementById('emptyQ');
function clearMarks(root){root.querySelectorAll('span[data-mk]').forEach(function(s){s.replaceWith(document.createTextNode(s.textContent));});root.normalize();}
function highlight(root,q){
  clearMarks(root);if(!q)return;
  var rx=new RegExp('('+q.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+')','ig');
  var w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,null),nodes=[];
  while(w.nextNode())nodes.push(w.currentNode);
  nodes.forEach(function(n){if(!n.nodeValue.trim()||!rx.test(n.nodeValue))return;
    var span=document.createElement('span');span.setAttribute('data-mk','1');
    span.innerHTML=n.nodeValue.replace(rx,'<mark class="s">$1</mark>');n.replaceWith(span);});
}
var searchTimer;
function runSearch(){
  var q=input.value.trim().toLowerCase();
  clr.classList.toggle('on',!!q);
  var shown=0;
  FAQ.forEach(function(f){
    var card=document.getElementById(f.slug);
    var hay=(f.q+' '+f.a+' '+(f.kw||[]).join(' ')).toLowerCase();
    var hit=!q||hay.indexOf(q)>-1;
    card.hidden=!hit;if(hit)shown++;
    highlight(card.querySelector('.faq-q .qt'),q);
    var ans=card.querySelector('.ans');highlight(ans,q);
    if(q&&hit){if(!card.classList.contains('open'))setOpen(card,true);}
    else if(q&&!hit){if(card.classList.contains('open'))setOpen(card,false);}
  });
  /* hide empty category headers */
  document.querySelectorAll('.faq-cat').forEach(function(sec){
    var any=[].slice.call(sec.querySelectorAll('.faq-card')).some(function(c){return !c.hidden;});
    sec.hidden=!any;
  });
  emptyEl.classList.toggle('on',shown===0);emptyQ.textContent='“'+input.value.trim()+'”';
  recalc();
  if(q){clearTimeout(searchTimer);searchTimer=setTimeout(function(){(window.esTrack||function(){})('faq_search',{query:q,results:shown});},900);}
}
input.addEventListener('input',runSearch);
clr.addEventListener('click',function(){input.value='';runSearch();input.focus();});

/* ===== scroll-spy categories ===== */
var spy=[].slice.call(document.querySelectorAll('.faq-cat'));
var io=new IntersectionObserver(function(es){
  es.forEach(function(en){if(en.isIntersecting){
    var cat=en.target.dataset.cat;
    document.querySelectorAll('#catNav a,#catMobile a').forEach(function(a){a.classList.toggle('active',a.dataset.cat===cat);});
  }});
},{rootMargin:'-30% 0px -60% 0px'});
spy.forEach(function(s){io.observe(s);});

/* ===== analytics on nav + cta ===== */
document.querySelectorAll('#catNav a,#catMobile a').forEach(function(a){a.addEventListener('click',function(){(window.esTrack||function(){})('faq_category',{category:a.dataset.cat});});});
var cta=document.getElementById('ctaBrief');if(cta)cta.addEventListener('click',function(){(window.esTrack||function(){})('faq_cta',{});});

/* ===== open from URL hash on load ===== */
addEventListener('load',function(){
  var h=(location.hash||'').replace('#','');
  if(h&&bySlug[h]){openBySlug(h,false);setTimeout(function(){document.getElementById(h).scrollIntoView({block:'center'});},200);}
});

/* ===== FAQPage JSON-LD (generated from content) ===== */
(function(){
  function txt(html){var d=document.createElement('div');d.innerHTML=html;return (d.textContent||'').replace(/\s+/g,' ').trim();}
  var ld={"@context":"https://schema.org","@type":"FAQPage","mainEntity":FAQ.map(function(f){
    return {"@type":"Question","name":f.q,"acceptedAnswer":{"@type":"Answer","text":txt(f.a)}};
  })};
  var s=document.createElement('script');s.type='application/ld+json';s.textContent=JSON.stringify(ld);document.head.appendChild(s);
})();
</script>
