function renderStep(s){
  const sc=el('div','screen'+(s.dark?' dark':''));
  const w=el('div','wrap');
  w.appendChild(el('div','eyebrow','Step '+s.num+' · '+s.title.toUpperCase()));
  w.appendChild(el('h2',null,s.title));
  const fields=el('div','fields');
  // group simple text fields in 2-col where it reads well (company / scale)
  fields.appendChild((()=>{const g=document.createDocumentFragment();
    let buffer=[];
    const flush=()=>{ if(!buffer.length)return;
      if(buffer.length>1){const grid=el('div','grid2');buffer.forEach(f=>grid.appendChild(buildField(f)));g.appendChild(grid);}
      else g.appendChild(buildField(buffer[0]));
      buffer=[];
    };
    s.fields.forEach(f=>{
      const simple=(f.type==='text'||f.type==='email'||f.type==='tel'||f.type==='date');
      if(simple)buffer.push(f); else {flush();g.appendChild(buildField(f));}
    });
    flush();
    return g;
  })());
  w.appendChild(fields);
  // nav
  const nav=el('div','nav');
  const back=el('button','btn btn-ghost','← Back');back.addEventListener('click',()=>go(idx-1));
  const next=el('button','btn btn-primary',(idx===steps.length-1?'Submit brief →':'Continue →'));next.id='nextBtn';
