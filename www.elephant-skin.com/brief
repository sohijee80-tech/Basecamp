function validate(){
  const s=steps[idx]; const next=document.getElementById('nextBtn'); if(!next||!s)return;
  let ok=true;
  s.fields.forEach(f=>{
    if(f.req){
      const v=state[f.k];
      if(f.type==='textarea'&&f.min){ if(!v||v.trim().length<f.min)ok=false; }
      else if(!v||(typeof v==='string'&&!v.trim()))ok=false;
    }
  });
  next.disabled=!ok;
}

let cur=null;
function show(node){
  if(cur){const old=cur;old.classList.remove('active');setTimeout(()=>old.remove(),550);}
  stage.appendChild(node);
  // force reflow then activate (for transition)
  void node.offsetWidth;
  node.classList.add('active');
  cur=node;
  stage.scrollTop=0;
}
function go(i){
  idx=i;
  setProgress();
  if(i===-1)show(introScreen());
  else if(i>=steps.length)show(finalScreen());
  else {show(renderStep(steps[i]));validate();}
  window.scrollTo(0,0);
}

/* ---- lead scoring ---- */
function score(){
  let s=0;
  if(['$150K–$500K','$500K+'].includes(state.gdv))s+=20;
  if(state.project_type==='Brand Film')s+=15;
  if(state.project_type==='Commercial')s+=10;
  const sv=state.services||[];
  if(sv.includes('Production'))s+=15;
  if(sv.includes('Post-Production'))s+=10;
  if(sv.includes('3D Animation'))s+=10;
  if(sv.includes('AI Productions'))s+=10;
  if(sv.includes('Full THE KIT (all of the above)'))s+=10;
  if(state.hear==='Referral')s+=15;
  if(state.launch_date){const d=new Date(state.launch_date);const diff=(d-new Date())/86400000;if(diff>=0&&diff<=90)s+=10;}
  let band='Cold Lead';
  if(s>90)band='Strategic'; else if(s>60)band='Priority'; else if(s>30)band='Qualified';
  return {score:s,band};
}

/* ---------- branded PDF of the brief (client-side, jsPDF) ---------- */
var __BRIEF_LOGO='data:image/png;base64,';
function briefFmt(v){ if(Array.isArray(v)) return v.map(function(x){return (x&&typeof x==='object')?(x.name||''):x;}).filter(Boolean).join(', '); return v==null?'':String(v); }
var __briefDoc=null, __briefFname='BaseCamp-Studio-Brief.pdf';
function buildBriefPDF(){
  var JS=(window.jspdf||{}).jsPDF; if(!JS) return null;
  var doc=new JS({unit:'pt',format:'a4',compress:true});
  var W=doc.internal.pageSize.getWidth(), H=doc.internal.pageSize.getHeight(), M=56;
  var dateStr=new Date().toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'});
  /* ---- cover ---- */
  doc.setFillColor(14,14,14); doc.rect(0,0,W,H,'F');
  try{ if(__BRIEF_LOGO){ var lw=168,lh=lw*(280/1741); doc.addImage(__BRIEF_LOGO,'PNG',M,78,lw,lh); } }catch(e){}
  doc.setFont('helvetica','bold'); doc.setFontSize(11); doc.setTextColor(255,90,46);
  doc.text('PROJECT BRIEF', M, 342);
  doc.setFontSize(30); doc.setTextColor(243,241,234);
  doc.text(String(state.company_name||state.contact_name||'New project brief'), M, 378, {maxWidth:W-2*M});
  if(state.project_name){ doc.setFont('helvetica','normal'); doc.setFontSize(13); doc.setTextColor(165,165,165); doc.text(String(state.project_name), M, 406, {maxWidth:W-2*M}); }
  doc.setFont('helvetica','normal'); doc.setFontSize(10); doc.setTextColor(120,120,120);
  doc.text('Prepared by BaseCamp Studio   ·   '+dateStr, M, H-56);
  /* ---- content ---- */
  function paper(){ doc.setFillColor(243,241,234); doc.rect(0,0,W,H,'F'); }
  doc.addPage(); paper(); var y=80;
  function ensure(sp){ if(y+sp>H-60){ doc.addPage(); paper(); y=80; } }
  steps.forEach(function(st){
    var rows=[]; (st.fields||[]).forEach(function(f){ var v=briefFmt(state[f.k]); if(v) rows.push([f.label,v]); });
    if(!rows.length) return;
    ensure(56);
    doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(255,90,46);
    doc.text('STEP '+st.num+'    —    '+String(st.title).toUpperCase(), M, y); y+=13;
    doc.setDrawColor(214,210,200); doc.line(M,y,W-M,y); y+=24;
    rows.forEach(function(r){
      var ans=doc.splitTextToSize(String(r[1]), W-2*M);
      ensure(17+ans.length*14+16);
      doc.setFont('helvetica','bold'); doc.setFontSize(10); doc.setTextColor(38,38,38); doc.text(String(r[0]), M, y); y+=15;
      doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(92,92,92); doc.text(ans, M, y); y+=ans.length*14+16;
    });
    y+=12;
  });
  /* ---- internal: lead score ---- */
  var sc=score(); ensure(58);
  doc.setDrawColor(214,210,200); doc.line(M,y,W-M,y); y+=24;
  doc.setFont('helvetica','bold'); doc.setFontSize(9); doc.setTextColor(255,90,46); doc.text('INTERNAL', M, y); y+=17;
  doc.setFont('helvetica','normal'); doc.setFontSize(11); doc.setTextColor(38,38,38);
  doc.text('Lead score: '+(sc&&sc.score!=null?sc.score:'-')+'   ·   '+((sc&&sc.band)||''), M, y);
  /* ---- footer page numbers ---- */
  var n=doc.internal.getNumberOfPages();
  for(var i=2;i<=n;i++){ doc.setPage(i); doc.setFont('helvetica','normal'); doc.setFontSize(8); doc.setTextColor(150,150,150); doc.text('BaseCamp Studio · Project Brief', M, H-34); doc.text((i-1)+' / '+(n-1), W-M, H-34, {align:'right'}); }
  return doc;
}
