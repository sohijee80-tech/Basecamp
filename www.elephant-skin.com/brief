    function renderList(){list.innerHTML='';state[f.k].forEach((fl,i)=>{
      const r=el('div','fr');r.innerHTML='<span><b>'+fl.name+'</b></span><span>'+(fl.size?(fl.size/1048576).toFixed(1)+' MB':'')+'</span>';
      const rm=el('button',null,'✕');rm.addEventListener('click',()=>{state[f.k].splice(i,1);renderList();});
