<script>
const HEAR=['Referral','Social Media','Google','Event','Existing Client','Other'];
const PTYPE=['Brand Film','Commercial','Documentary','Social Content','Explainer Video','Product Launch','Music Video','Corporate Video','Other'];
const STAGE=['Just an Idea','Script/Concept Ready','Ready to Shoot','Mid-Production','Post-Production Only','Ongoing Content Needs'];
const GDV=['Under $10K','$10K–$50K','$50K–$150K','$150K–$500K','$500K+'];
const OBJ=['Launch a Brand Film','Improve Production Quality','Reduce Turnaround Time','Add Animation or VFX','Explore AI-Assisted Production','Ongoing Content Partnership','Rebrand Existing Content','Other'];
const BUYER=['Consumers','B2B / Trade','Investors','Internal / Employees','General Public','Other'];
const MARKETS=['Social Media','TV / Broadcast','Cinema','Web / Digital','Internal / Corporate','Other'];
const SERVICES=['Production','Post-Production','AI Productions','3D Animation','2D Animation','Motion Graphics','VFX','Full THE KIT (all of the above)'];

const steps=[
 {key:'company',num:'01',title:'Company',fields:[
   {k:'company_name',label:'Company name',type:'text',req:true},
   {k:'contact_name',label:'Contact name',type:'text',req:true},
   {k:'email',label:'Email',type:'email',req:true},
   {k:'phone',label:'Phone number',type:'tel'},
   {k:'country',label:'Country',type:'text'},
   {k:'hear',label:'How did you hear about BaseCamp Studio?',type:'single',options:HEAR}
 ]},
 {key:'project',num:'02',title:'Project',fields:[
   {k:'project_name',label:'Project name',type:'text',req:true},
   {k:'project_location',label:'Where will this shoot, if applicable',type:'text'},
   {k:'project_type',label:'Project type',type:'single',options:PTYPE},
   {k:'stage',label:'Project stage',type:'single',options:STAGE}
 ]},
 {key:'scale',num:'03',title:'Project scale',fields:[
   {k:'gdv',label:'Estimated budget',type:'single',options:GDV},
   {k:'launch_date',label:'Target delivery date',type:'date'}
 ]},
 {key:'challenge',num:'04',title:'Challenge',fields:[
   {k:'challenge',label:'What is the biggest challenge facing this project today?',type:'textarea',min:100,req:true,big:true}
 ]},
 {key:'goals',num:'05',title:'Goals & Audience',fields:[
   {k:'objectives',label:'What are you trying to achieve?',type:'multi',options:OBJ},
   {k:'buyer',label:"Who's this for?",type:'multi',options:BUYER},
   {k:'markets',label:'Where will this run?',type:'multi',options:MARKETS},
   {k:'services',label:'What services are you looking for?',type:'multi',options:SERVICES}
 ]},
 {key:'references',num:'06',title:'References & Documents',fields:[
   {k:'references',label:'Reference links',type:'links',opt:'Optional · up to 10 links'},
   {k:'documents',label:'Upload references or project documents',type:'files',big:true,
     opt:'Optional · Script · Storyboard · Brand Guidelines · Deck'}
 ]},
 {key:'bigquestion',num:'07',title:'The Big Question',dark:true,fields:[
   {k:'bigquestion',label:'If this became the piece everyone in your industry talked about, what would be the reason?',type:'textarea',big:true,hint:'Take your time. This is probably the most valuable answer in the brief.'}
 ]}
];

const state={};
let idx=-1; // -1 intro, 0..9 steps, 10 final
const stage=document.getElementById('stage');
const pbar=document.getElementById('pbar');
const stepcount=document.getElementById('stepcount');

function setProgress(){
  let pct=0, label='';
  if(idx===-1){pct=0;label='';}
  else if(idx>=steps.length){pct=100;label='Complete';}
  else {pct=Math.round(((idx+1)/steps.length)*100);label='Step <b>'+(idx+1)+'</b> of '+steps.length;}
  pbar.style.width=pct+'%';
  stepcount.innerHTML=label?label+' &nbsp;·&nbsp; '+pct+'%':'';
}

function el(t,c,h){const e=document.createElement(t);if(c)e.className=c;if(h!==undefined)e.innerHTML=h;return e;}

function buildField(f){
  const wrap=el('div','field');
  if(f.type!=='textarea' && f.type!=='single' && f.type!=='multi'){
    // simple input, label handled in grid wrapper for company step; here generic
  }
  const lab=el('label','flab',f.label+(f.opt?' <span class="opt">· '+f.opt+'</span>':''));
  if(f.type==='text'||f.type==='email'||f.type==='tel'||f.type==='date'){
    wrap.appendChild(lab);
    const i=el('input','inp');i.type=f.type==='date'?'date':(f.type==='email'?'email':(f.type==='tel'?'tel':'text'));
    i.placeholder=f.type==='date'?'':'Type your answer…';
    if(state[f.k])i.value=state[f.k];
    i.addEventListener('input',()=>{state[f.k]=i.value;validate();});
    wrap.appendChild(i);
  } else if(f.type==='textarea'){
    wrap.appendChild(lab);
    const ta=el('textarea','inp');ta.placeholder='Write here…';if(f.big)ta.style.minHeight='200px';
    if(state[f.k])ta.value=state[f.k];
    wrap.appendChild(ta);
    if(f.min){const c=el('div','counter','0 / '+f.min+' min');wrap.appendChild(c);
      const upd=()=>{const n=ta.value.trim().length;c.textContent=n+' / '+f.min+' min';c.classList.toggle('ok',n>=f.min);};
      ta.addEventListener('input',()=>{state[f.k]=ta.value;upd();validate();});upd();
    } else { ta.addEventListener('input',()=>{state[f.k]=ta.value;validate();}); }
    if(f.hint)wrap.appendChild(el('div','qhint',f.hint));
  } else if(f.type==='single'||f.type==='multi'){
    wrap.appendChild(lab);
    const ps=el('div','pills');
    if(f.type==='multi' && !Array.isArray(state[f.k]))state[f.k]=[];
    f.options.forEach(o=>{
      const p=el('div','pill',o);
      const isSel=f.type==='multi'?state[f.k].includes(o):state[f.k]===o;
      if(isSel)p.classList.add('sel');
      p.addEventListener('click',()=>{
        if(f.type==='single'){state[f.k]=o;ps.querySelectorAll('.pill').forEach(x=>x.classList.remove('sel'));p.classList.add('sel');}
        else{const a=state[f.k];const i=a.indexOf(o);if(i>=0){a.splice(i,1);p.classList.remove('sel');}else{a.push(o);p.classList.add('sel');}}
        validate();
      });
