var BRIEF_ENDPOINT='https://usebasin.com/f/284b75a8d818';

/* build a self-contained "brief object" + a shareable view link (data travels in the URL hash) */
var ES_PROJECTS={tempo:'Tempo',allard:'Allard',colette:'Colette',dora:'Dóra',movala:'Movala','parc-autodromo':'Parc Autódromo',biltmore:'Biltmore','boca-raton':'Boca Raton','quinta-amoras':'Quinta das Amoras','mansao-seara':'Mansão Seara','okan-tower':'Okan Tower',frontier:'Frontier'};
function briefObject(){
  var sc=score(), sections=[], admire=[];
  steps.forEach(function(st){ var rows=[]; (st.fields||[]).forEach(function(f){
    if(f.type==='esgallery'){ (state[f.k]||[]).forEach(function(k){ admire.push({key:k,name:(ES_PROJECTS[k]||k)}); }); return; }
    var v=briefFmt(state[f.k]); if(v) rows.push([f.label,v]);
  }); if(rows.length) sections.push({num:st.num,title:st.title,rows:rows}); });
  return {company:state.company_name||state.contact_name||'New project brief', project:state.project_name||'', email:state.email||'', date:new Date().toISOString(), lead:sc, admire:admire, sections:sections};
}
function briefLink(obj){ try{ return location.origin+'/brief-view#'+btoa(unescape(encodeURIComponent(JSON.stringify(obj)))); }catch(e){ return ''; } }

function submit(){
  var sc=score();
  var obj=briefObject();
  var link=briefLink(obj);
  function mailFallback(){ try{
    var lines=[]; (obj.sections||[]).forEach(function(s){ s.rows.forEach(function(r){ lines.push(r[0]+': '+r[1]); }); });
    if(obj.admire&&obj.admire.length){ lines.push('Projects you admire from our work: '+obj.admire.map(function(a){return a.name;}).join(', ')); }
    lines.push(''); lines.push('Lead score: '+(sc&&sc.score!=null?sc.score:'')+' ('+((sc&&sc.band)||'')+')');
    if(link){ lines.push(''); lines.push('View the formatted brief: '+link); }
    var subj='New project brief'+(state.company_name?' — '+state.company_name:'');
    var a=document.createElement('a'); a.href='mailto:hello@basecampstudio.pk?subject='+encodeURIComponent(subj)+'&body='+encodeURIComponent(lines.join('\n')); document.body.appendChild(a); a.click(); a.remove();
  }catch(e){} }
  if(BRIEF_ENDPOINT){
    try{
      var fd=new FormData();
      (obj.sections||[]).forEach(function(s){ s.rows.forEach(function(r){ fd.append(r[0], r[1]); }); });
      if(obj.admire&&obj.admire.length) fd.append('Projects you admire from our work', obj.admire.map(function(a){return a.name;}).join(', '));
      fd.append('Lead score',(sc&&sc.score!=null?sc.score:'')+' ('+((sc&&sc.band)||'')+')');
      if(link) fd.append('View the formatted brief', link);
      fd.append('_subject','New project brief'+(state.company_name?' — '+state.company_name:''));
      if(state.email) fd.append('email', state.email);
      fetch(BRIEF_ENDPOINT,{method:'POST',body:fd,headers:{'Accept':'application/json'}})
        .then(function(r){ if(!r.ok) mailFallback(); })
        .catch(function(){ mailFallback(); });
    }catch(e){ mailFallback(); }
  } else { mailFallback(); }
  try{ if(window.esTrack) esTrack('generate_lead',{method:'project_brief', lead_score:(sc&&sc.score!=null?sc.score:undefined)}); }catch(e){}
  go(steps.length);
}

