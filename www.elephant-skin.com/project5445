  function apply(v){var r=1;for(var k in RATE){if(v.currentSrc&&v.currentSrc.indexOf('/'+k+'/')>-1){r=RATE[k];break;}}if(v.src&&!v.currentSrc){for(var k2 in RATE){if(v.src.indexOf('/'+k2+'/')>-1){r=RATE[k2];break;}}}try{v.playbackRate=r;}catch(e){}}
  document.querySelectorAll('video').forEach(function(v){
    if(!((v.currentSrc||v.src||'').indexOf('brochure-flip.mp4')>-1))return;
    apply(v);
    v.addEventListener('loadedmetadata',function(){apply(v);});
    v.addEventListener('play',function(){apply(v);});
  });
})();
