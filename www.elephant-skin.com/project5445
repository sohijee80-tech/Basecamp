<script>
/* ===== FIND CAPI — reusable collectible hunt ===== */
(function(){
  if(!document.querySelector('.cap-land'))return;            // parc case only
  var KEY='parc_findcapi_v2';
  var FALLBACK='data:image/svg+xml;utf8,'+encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 92"><g fill="#9a7b53" stroke="#5e4a2f" stroke-width="2"><path d="M30 64c-9 0-15-8-12-17-3-3-3-8 1-10-2-6 5-10 9-7 3-8 14-10 21-5 9-6 26-6 35 0 10-3 19 1 21 10 6 3 7 11 2 15 1 8-6 14-13 14H30z"/><path d="M27 40c-3-6-2-10 3-12 3 3 3 9-1 12M99 42c3-6 2-10-3-12-3 3-3 9 1 12"/></g><circle cx="43" cy="46" r="3"/><circle cx="92" cy="46" r="3"/><path d="M43 64v20M56 64v18M82 64v18M95 64v20" stroke="#9a7b53" stroke-width="7" stroke-linecap="round" fill="none"/></svg>');
  var PACK='projects/parc/capi-pack/index.html';
  var CAPIS=[
    {id:'reader',name:'Runner Capi',tag:'Always on the move.',sel:'.s-broch',idx:0,edge:'bl',diff:'medium',fact:'At 560,000 m², more than half of Parc is open, public space, built to be walked, run and cycled, calm, green and car-free.'},
    {id:'architect',name:'Architect Capi',tag:'Plans the perfect block.',sel:'.story-ch',idx:1,edge:'tr',diff:'medium',fact:'Parc is the final masterplan of Jaime Lerner, one of the world’s great urban thinkers, brought to life by Bairru, an ambitious neighbourhood built entirely around people.'},
    {id:'explorer',name:'Explorer Capi',tag:'Ready for adventure.',sel:'.lc-04',idx:0,edge:'bl',diff:'easy',fact:'Eighteen minutes from downtown Curitiba on Avenida Iraí, Parc keeps the green and the calm of a planned neighbourhood with the city right next door.'},
    {id:'gardener',name:'Gardener Capi',tag:'Grows the neighbourhood, literally.',sel:'.story-ch',idx:5,edge:'tr',diff:'hard',fact:'More than half of Parc is green, open space, with native landscaping and a shared urban garden, part of what makes it the world’s most sustainable neighbourhood.'},
    {id:'family',name:'Family Capi',tag:'For every generation.',sel:'.story-ch',idx:7,edge:'bl',diff:'easy',fact:'Parc was designed as a place for the whole family, every generation, with shared squares and safe, walkable streets where people actually live together.'},
    {id:'lake',name:'Lake Capi',tag:'Water lover. Professional relaxer.',sel:'.cres',idx:0,edge:'tr',diff:'easy',fact:'More than half of Parc is open, public space, the lake, parks and green for families and kids to actually use.'},
    {id:'cinema',name:'Pista Capi',tag:'Always building what’s next.',sel:'.pista-sec',idx:0,edge:'bl',diff:'medium',fact:'Pista is Parc’s innovation hub, where the city meets what’s next, technology, entrepreneurship and new ideas built into the neighbourhood.'},
    {id:'innovator',name:'Scholar Capi',tag:'Class is right downstairs.',sel:'.box-sec',idx:0,edge:'tr',diff:'hard',fact:'BOX was the experience center on the site itself, immersive E_SC rooms and a cinema that let visitors feel the whole neighbourhood before a single brick was laid.'},
    {id:'cyclist',name:'Cyclist Capi',tag:'No cars. Just good paths.',sel:'.s-news',idx:0,edge:'bl',diff:'medium',fact:'Parc made headlines, named the world’s most sustainable neighbourhood and winner of the Top de Marketing 2025 (ADVB-PR).'},
    {id:'barista',name:'Barista Capi',tag:'Everything, a short walk away.',sel:'.pstats',idx:0,edge:'tr',diff:'medium',fact:'40+ buildings and phases, $2.5 Bi in projected gross sales, and a launch that sold most of its inventory within hours.'}
  ];
  var state={started:false,dismissed:false,found:{}};
  try{localStorage.removeItem(KEY);}catch(e){} /* reset the hunt on every page load */
  function save(){try{localStorage.setItem(KEY,JSON.stringify(state));}catch(e){}}
  var foundCount=function(){return Object.keys(state.found).length;};

  // build img with fallback
  function capImg(id){var i=new Image();i.src=PACK+id+'.png';i.onerror=function(){i.onerror=null;i.src=FALLBACK;};i.alt='';return i;}

  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)e.target.classList.add('show');});},{threshold:.2});
  var placed=false;
  function place(){
    if(placed)return;placed=true;
    var posMap={bl:'left:3%;bottom:-16px',br:'right:4%;bottom:-16px',tl:'left:4%;top:-8px',tr:'right:5%;top:-8px'};
    var peekMap={top:'left:11%;top:0;--pk:translateY(-66%)',right:'right:0;top:26%;--pk:translateX(60%)',left:'left:0;top:26%;--pk:translateX(-60%)',bottom:'left:13%;bottom:0;--pk:translateY(66%)'};
    CAPIS.forEach(function(c){
      var b=document.createElement('button');b.className='fc-capi '+c.diff+(c.behind?' fc-behind':'');b.dataset.id=c.id;b.setAttribute('aria-label','You found '+c.name);
      b.appendChild(capImg(c.id));
      if(state.found[c.id]){b.classList.add('found');}
      b.addEventListener('click',function(){find(c,b);});
      var host;
      if(c.behind){
        host=document.querySelectorAll(c.behind)[c.bidx||0];if(!host)return;
        if(getComputedStyle(host).position==='static')host.style.position='relative';
        host.style.overflow='visible';
        var media=host.matches('img,video')?host:host.querySelector('img,video');
        if(media){media.style.position='relative';media.style.zIndex='2';}
        b.style.cssText+=';z-index:1;'+peekMap[c.peek||'top'];
      } else {
        host=document.querySelectorAll(c.sel)[c.idx||0];if(!host)return;
        if(getComputedStyle(host).position==='static')host.style.position='relative';
        b.style.cssText+=';'+posMap[c.edge];
      }
      if(c.diff==='hard'){host.addEventListener('mouseenter',function(){b.classList.add('show');});}
      host.appendChild(b);io.observe(b);
    });
  }

  // UI: widget + panel + modal
  var widget,panel,scrim,modal,progFill,grid;
  function buildUI(){
    widget=el('button','fc-widget','<span class="ic">🔎</span><span>FIND CAPI &nbsp;<b><span id="fcN">'+foundCount()+'</span>/'+CAPIS.length+'</b></span>');
    widget.addEventListener('click',openPanel);document.body.appendChild(widget);
    scrim=el('div','fc-scrim','');scrim.addEventListener('click',closePanel);document.body.appendChild(scrim);
    panel=el('div','fc-panel','<div class="fc-panel-h"><div><div class="e">The hunt</div><h3>Find Capi.</h3></div><button class="fc-x">×</button></div><div class="fc-prog"><i id="fcProg"></i></div><div class="fc-grid" id="fcGrid"></div><button class="fc-reset">Reset progress</button>');
    document.body.appendChild(panel);
    panel.querySelector('.fc-x').addEventListener('click',closePanel);
    panel.querySelector('.fc-reset').addEventListener('click',function(){state.found={};save();location.reload();});
    progFill=panel.querySelector('#fcProg');grid=panel.querySelector('#fcGrid');
    modal=el('div','fc-modal','');document.body.appendChild(modal);
    modal.addEventListener('click',function(e){if(e.target===modal)modal.classList.remove('on');});
    refreshGrid();
  }
  function el(t,c,h){var e=document.createElement(t);e.className=c;e.innerHTML=h;return e;}
  function refreshGrid(){
    grid.innerHTML='';CAPIS.forEach(function(c){
      var got=!!state.found[c.id];var s=document.createElement('div');s.className='fc-slot'+(got?'':' locked');
      s.innerHTML='<div class="nm">'+(got?c.name:'Hidden')+'</div>';
      var im=capImg(c.id);s.insertBefore(im,s.firstChild);grid.appendChild(s);
    });
    progFill.style.right=(100-foundCount()/CAPIS.length*100)+'%';
    var n=document.getElementById('fcN');if(n)n.textContent=foundCount();
  }
  function openPanel(){panel.classList.add('on');scrim.classList.add('on');}
  function closePanel(){panel.classList.remove('on');scrim.classList.remove('on');}

  function find(c,b){
    if(state.found[c.id])return;
    state.found[c.id]=1;save();if(b)b.classList.add('found');
    widget.classList.add('pop');setTimeout(function(){widget.classList.remove('pop');},500);
    refreshGrid();
    var n=foundCount(),left=CAPIS.length-n;
    var nx=n>=CAPIS.length?'':(left===1?'One more hidden nearby.':'Keep exploring · '+left+' still hidden.');
    var art=document.createElement('div');art.className='art';art.appendChild(capImg(c.id));
    modal.innerHTML='<div class="fc-card"><div class="st">Capi found · '+n+'/'+CAPIS.length+'</div><h4>'+c.name+'</h4><div class="tag">&ldquo;'+c.tag+'&rdquo;</div><div class="rw"><b>Did you know</b>'+c.fact+'</div><button class="ok">Keep exploring</button>'+(nx?'<div class="nx">'+nx+'</div>':'')+'</div>';
    modal.querySelector('.fc-card').insertBefore(art,modal.querySelector('.st'));
    modal.querySelector('.ok').addEventListener('click',function(){modal.classList.remove('on');});
    modal.classList.add('on');
    if(n>=CAPIS.length)setTimeout(complete,900);
  }
  function complete(){
    modal.classList.add('fc-done');
    modal.innerHTML='<div class="fc-card"><div class="st">Hunt complete</div><h4>You found<br>every Capi.</h4><div class="tag">&ldquo;Even the capybaras would move.&rdquo;</div><div class="rw">You explored every corner of Parc Autódromo, and met all ten Capis along the way. Now show off your title.</div><div class="fc-badge">★ Official Parc Explorer</div><div class="fc-share"><button class="sh sh-li">Share on LinkedIn</button><button class="sh sh-ig">Share</button></div><button class="ok">Close</button></div>';
    var SHURL=location.href.split("#")[0], SHTXT="I just found all 10 Capis hidden across Parc Autódromo, the neighbourhood by Bairru, with go-to-market and storytelling by BaseCamp Studio. I\'m an Official Parc Explorer 🦫";
    modal.querySelector(".sh-li").addEventListener("click",function(){window.open("https://www.linkedin.com/sharing/share-offsite/?url="+encodeURIComponent(SHURL),"_blank","noopener");});
    modal.querySelector(".sh-ig").addEventListener("click",function(){if(navigator.share){navigator.share({title:"Parc Autódromo · Find Capi",text:SHTXT,url:SHURL}).catch(function(){});}else{navigator.clipboard&&navigator.clipboard.writeText(SHTXT+" "+SHURL);this.textContent="Link copied!";}});
    modal.querySelector('.ok').addEventListener('click',function(){modal.classList.remove('on');modal.classList.remove('fc-done');});
    modal.classList.add('on');
  }

  function startGame(){buildUI();place();setTimeout(function(){widget.classList.add('on');},200);}

  // intro — Capi ID card, shown on load until the hunt is started
  function showIntro(){
    var m=el('div','fc-modal fc-introm','');
    m.innerHTML='<div class="fc-card fc-id">'
      +'<div class="fc-id-top"><div class="fc-id-av"><img loading="lazy" decoding="async" src="'+PACK+'capi-face.png" alt="Capi" onerror="this.src=&quot;'+PACK+'explorer.png&quot;"></div>'
      +'<div class="fc-id-meta"><div class="st">Wanted · around Parc</div><h4>Capi</h4><div class="tag">The first resident of Parc</div></div></div>'
      +'<div class="fc-id-data"><div><b>Species</b><span>Capybara, CGI</span></div><div><b>Versions</b><span>10 to find</span></div><div><b>Last seen</b><span>All over Parc</span></div><div><b>Your mission</b><span>Catch them all</span></div></div>'
      +'<p class="fc-id-desc">Capi is hiding around Parc. Every version you spot reveals a real piece of the neighbourhood, a fact, a number, a detail of the project. Find all ten and you&rsquo;ll know Parc by heart. Watch the edges, the galleries and the quiet corners.</p>'
      +'<div class="fc-id-btns"><button class="yes">Start the hunt</button><button class="later">Maybe later</button></div></div>';
    document.body.appendChild(m);
    requestAnimationFrame(function(){m.classList.add('on');});
    m.addEventListener('click',function(e){if(e.target===m){m.classList.remove('on');setTimeout(function(){m.remove();},300);}});
    m.querySelector('.yes').addEventListener('click',function(){state.started=true;save();m.classList.remove('on');setTimeout(function(){m.remove();},300);startGame();});
    m.querySelector('.later').addEventListener('click',function(){m.classList.remove('on');setTimeout(function(){m.remove();},300);});
  }

  if(state.started){startGame();}
  else{setTimeout(showIntro,1100);}
})();
/* Jaime Lerner — profile card (click the architect credit) */
(function(){
  var card=document.querySelector('.sc-arch');if(!card)return;
  card.style.cursor='pointer';card.setAttribute('role','button');card.setAttribute('tabindex','0');
  card.insertAdjacentHTML('beforeend','<span class="sc-arch-more">Profile →</span>');
  var CV=[['Curitiba','3× Mayor'],['Paraná','2× Governor'],['Pioneered','Bus Rapid Transit'],['Signature idea','Urban acupuncture']];
  function open(){
    var m=document.createElement('div');m.className='fc-modal';
    m.innerHTML='<div class="fc-card fc-id" style="max-width:500px;text-align:left">'
      +'<div class="fc-id-top"><div class="fc-id-av"><img loading="lazy" decoding="async" src="projects/parc/lerner.jpg?v=2" alt="Jaime Lerner"></div>'
      +'<div class="fc-id-meta"><div class="st">Architect &amp; urbanist</div><h4 style="font-size:clamp(30px,5vw,46px)">Jaime Lerner</h4><div class="tag">Curitiba, 1937–2021</div></div></div>'
      +'<div class="fc-id-data">'+CV.map(function(c){return '<div><b>'+c[0]+'</b><span>'+c[1]+'</span></div>';}).join('')+'</div>'
      +'<p class="fc-id-desc">One of the most influential urban thinkers of his time. As architect, urban planner and three-time mayor of Curitiba, Jaime Lerner turned the city into a global reference for sustainable, people-first urbanism, pioneering Bus Rapid Transit, pedestrian streets and the idea of &ldquo;urban acupuncture&rdquo;. Parc Autódromo is among his final masterplans.</p>'
      +'<div class="fc-id-btns"><button class="yes">Close</button></div></div>';
    document.body.appendChild(m);requestAnimationFrame(function(){m.classList.add('on');});
    function close(){m.classList.remove('on');setTimeout(function(){m.remove();},300);}
    m.addEventListener('click',function(e){if(e.target===m)close();});
    m.querySelector('.yes').addEventListener('click',close);
  }
  card.addEventListener('click',open);
  card.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();open();}});
})();
/* sustainability pillars — accordion synced with the chapter image */
(function(){
  var accs=document.querySelectorAll('.sc-acc');if(!accs.length)return;
  var img=accs[0].closest('.story-ch');img=img&&img.querySelector('.sc-media img');
  accs.forEach(function(a){a.addEventListener('click',function(){
    var wasOpen=a.classList.contains('open');
    accs.forEach(function(x){x.classList.toggle('open',x===a&&!wasOpen);});
    if(img&&a.dataset.img&&!wasOpen){img.style.opacity='0';setTimeout(function(){img.src=a.dataset.img;img.style.opacity='';},220);}
  });});
})();
