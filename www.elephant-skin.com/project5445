/* small 3D continents globe with a pulsing location ping */
(function(){
  const cv=document.getElementById('pcGlobe'); if(!cv) return;
  /* coarse continent outlines [lat,lon], simplified */
  const LAND=[
    [[71,-156],[70,-100],[60,-64],[47,-52],[40,-62],[25,-80],[18,-95],[23,-110],[37,-122],[55,-130],[70,-145]],
    [[12,-71],[6,-50],[-5,-35],[-23,-41],[-40,-62],[-53,-69],[-33,-71],[-15,-76],[-2,-80],[6,-78]],
    [[83,-30],[78,-17],[70,-22],[68,-50],[78,-58]],
    [[60,-9],[62,12],[70,28],[60,40],[45,30],[37,-2],[43,-9],[51,-4]],
    [[36,-6],[33,11],[31,33],[12,44],[-5,42],[-26,35],[-34,20],[-28,15],[5,-9],[21,-17],[33,-10]],
    [[70,42],[76,100],[68,160],[60,170],[52,142],[38,128],[22,120],[8,98],[14,80],[20,70],[24,58],[38,46],[55,45]],
    [[28,72],[20,73],[8,77],[15,80],[22,88]],
    [[-1,95],[6,118],[-2,140],[-9,142],[-10,118]],
    [[-12,114],[-12,142],[-25,153],[-38,146],[-35,118],[-22,113]]
  ];
  function inPoly(la,lo,poly){let c=false;for(let i=0,j=poly.length-1;i<poly.length;j=i++){const yi=poly[i][0],xi=poly[i][1],yj=poly[j][0],xj=poly[j][1];if(((yi>la)!=(yj>la))&&(lo<(xj-xi)*(la-yi)/(yj-yi)+xi))c=!c;}return c;}
  function isLand(la,lo){for(const p of LAND)if(inPoly(la,lo,p))return true;return false;}
  const D=Math.PI/180;
  /* fibonacci sphere → tag land */
  const N=1500, pts=[];
  for(let i=0;i<N;i++){const y=1-2*(i+0.5)/N, r=Math.sqrt(1-y*y), th=i*2.399963229;
    const x=Math.cos(th)*r, z=Math.sin(th)*r;
    const la=Math.asin(y)/D, lo=Math.atan2(z,x)/D;
    pts.push({x,y,z,land:isLand(la,lo)});}
  /* location ping vector */
  const ll=p.ll||[0,0], la=ll[0]*D, lo=ll[1]*D;
  const pv={x:Math.cos(la)*Math.cos(lo), y:Math.sin(la), z:Math.cos(la)*Math.sin(lo)};
  const ctx=cv.getContext('2d'); let DPR=Math.min(2,window.devicePixelRatio||1);
  const CSS=96; cv.width=CSS*DPR; cv.height=CSS*DPR; cv.style.width=CSS+'px'; cv.style.height=CSS+'px';
  const cx=CSS*DPR/2, cy=CSS*DPR/2, R=CSS*DPR*0.46;
  const PINK='#FF5A2E';
  function col(){return getComputedStyle(document.documentElement).getPropertyValue('--soft')||'#cfcbc0';}
  /* rotate so the ping faces front: start angle aligns ping lon to viewer, then slow spin */
  let ang=-lo - Math.PI/2, t=0, raf;
  function rotY(v,a){return {x:v.x*Math.cos(a)+v.z*Math.sin(a), y:v.y, z:-v.x*Math.sin(a)+v.z*Math.cos(a)};}
  const TILT=-18*D;
  function rotX(v,a){return {x:v.x, y:v.y*Math.cos(a)-v.z*Math.sin(a), z:v.y*Math.sin(a)+v.z*Math.cos(a)};}
  let on=true;
  function frame(){
    if(!on)return; t++; ang+=0.0016;
    ctx.clearRect(0,0,cv.width,cv.height);
    const soft=col();
    /* sphere outline */
    ctx.beginPath();ctx.arc(cx,cy,R,0,7);ctx.strokeStyle='rgba(140,134,125,.25)';ctx.lineWidth=DPR;ctx.stroke();
    for(const p2 of pts){
      let v=rotY(p2,ang); v=rotX(v,TILT);
      const sx=cx+v.x*R, sy=cy-v.y*R, front=v.z>0;
      const depth=(v.z+1)/2;
      if(p2.land){ctx.globalAlpha=front?0.35+depth*0.6:0.08;ctx.fillStyle=front?PINK:soft;ctx.beginPath();ctx.arc(sx,sy,DPR*(front?1.15:0.8),0,7);ctx.fill();}
      else{ctx.globalAlpha=front?0.16+depth*0.18:0.05;ctx.fillStyle=soft;ctx.beginPath();ctx.arc(sx,sy,DPR*0.7,0,7);ctx.fill();}
    }
    /* ping */
    let pvr=rotY(pv,ang); pvr=rotX(pvr,TILT);
    const px=cx+pvr.x*R, py=cy-pvr.y*R;
    if(pvr.z>-0.1){
      const pulse=(Math.sin(t*0.08)+1)/2;
      ctx.globalAlpha=0.5*(1-pulse);ctx.strokeStyle=PINK;ctx.lineWidth=DPR*1.5;ctx.beginPath();ctx.arc(px,py,DPR*(3+pulse*9),0,7);ctx.stroke();
      ctx.globalAlpha=1;ctx.fillStyle=PINK;ctx.beginPath();ctx.arc(px,py,DPR*2.6,0,7);ctx.fill();
    }
    ctx.globalAlpha=1; raf=requestAnimationFrame(frame);
  }
  const io=new IntersectionObserver(es=>es.forEach(e=>{on=e.isIntersecting;if(on)frame();else cancelAnimationFrame(raf);}),{threshold:.05});
  io.observe(cv);
})();

