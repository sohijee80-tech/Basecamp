<style>
:root{
  --pink:#FF5A2E;--pad:clamp(24px,3.5vw,56px);
  --bg:#070707;--text:#f3f1ea;--muted:#8a867d;--soft:#cfcbc0;--line:rgba(255,255,255,.10);--surf:rgba(255,255,255,.03);
  --font-display:'Etna','Helvetica Neue',Arial,sans-serif;
  --font-body:'Aaux Pro Light','Helvetica Neue',Arial,sans-serif;
  --font-med:'Aaux Pro Medium','Helvetica Neue',Arial,sans-serif;
}
html[data-theme="light"]{--bg:#f3f1ea;--text:#16130f;--muted:#6a665d;--soft:#46423a;--line:rgba(0,0,0,.13);--surf:rgba(0,0,0,.025)}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;overflow-x:clip}
body{background:var(--bg);color:var(--text);font-family:var(--font-body);-webkit-font-smoothing:antialiased;line-height:1.55;overflow-x:hidden;transition:background .4s,color .4s}
a{color:inherit;text-decoration:none}
::selection{background:var(--pink);color:#fff}
.wrap{max-width:none;margin:0;padding:0 var(--pad)}
.pink{color:var(--pink)}
section{position:relative}
.bar{position:fixed;top:0;left:0;right:0;z-index:60;display:flex;align-items:center;justify-content:space-between;padding:20px var(--pad);transition:background .3s}
.bar.scrolled{background:color-mix(in srgb,var(--bg) 80%,transparent);backdrop-filter:blur(12px)}
/* over the hero (not scrolled) the bar sits on a dark image scrim — force light controls so the Menu is always visible in any theme */
.bar:not(.scrolled) .menu-btn{color:#fff}
.bar:not(.scrolled) .menu-btn:hover{color:var(--pink)}
.bar:not(.scrolled) .bar-projects{color:#fff;border-color:rgba(255,255,255,.5)}
.bar:not(.scrolled) .bar-projects:hover{border-color:#fff;color:#fff}
.bar:not(.scrolled) .themetog{border-color:rgba(255,255,255,.5)}
.bar:not(.scrolled) .themetog button{color:rgba(255,255,255,.72)}
.bar:not(.scrolled) .themetog button.on{background:#fff;color:#0a0a0a}
.bar .lg img{height:25px;display:block}
.bar-right{display:flex;align-items:center;gap:14px}
.themetog{display:flex;border:1px solid var(--line);border-radius:999px;overflow:hidden}
.themetog button{border:none;background:none;color:var(--muted);padding:7px 11px;cursor:pointer;font-size:13px;line-height:1;transition:.2s}
.themetog button.on{background:var(--text);color:var(--bg)}
.bar-projects{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:999px;padding:8px 16px;font-family:var(--font-med);font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--text);white-space:nowrap;transition:border-color .25s,color .25s}
.bar-projects:hover{border-color:var(--pink);color:var(--pink)}
@media(max-width:560px){.bar-projects{padding:7px 11px;font-size:9.5px}.bar-right{gap:9px}.bp-t{display:none}}
.menu-btn{background:none;border:none;color:var(--text);cursor:pointer;font-family:var(--font-display);font-size:20px;letter-spacing:.04em;text-transform:uppercase;transition:color .25s}
.menu-btn:hover{color:var(--pink)}
.menu-overlay{position:fixed;inset:0;z-index:100;background:var(--pink);color:#0a0a0a;padding:54px 56px;display:flex;flex-direction:column;justify-content:space-between;transform:translateY(-102%);opacity:0;visibility:hidden;transition:transform .6s cubic-bezier(.76,0,.24,1),opacity .4s,visibility .6s}
.menu-overlay.open{transform:none;opacity:1;visibility:visible}
.menu-close{position:absolute;top:46px;right:52px;width:46px;height:46px;font-size:38px;cursor:pointer;background:none;border:none;color:#0a0a0a;line-height:1}
.menu-logo{height:26px;align-self:flex-start;margin-bottom:10px}
.menu-nav a{display:inline-block;font-family:var(--font-display);font-size:clamp(28px,4.6vw,54px);color:#fff;text-transform:uppercase;line-height:1.14;transition:padding-left .28s,color .2s}
.menu-nav a:hover{padding-left:18px;color:#0a0a0a}
.menu-foot{max-width:680px}
.menu-foot .slogan{font-family:var(--font-display);font-size:clamp(18px,2.4vw,26px);text-transform:uppercase}
.menu-foot p{margin-top:16px;font-size:13px;color:rgba(10,10,10,.72);max-width:540px;line-height:1.6}
.menu-social{margin-top:20px;display:flex;gap:14px}
.menu-social a{width:36px;height:36px;border:1.5px solid rgba(10,10,10,.55);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-med);font-size:12px;color:#0a0a0a;transition:.2s}
.menu-social a:hover{background:#0a0a0a;color:var(--pink)}
@media(max-width:600px){.menu-overlay{padding:36px 26px}.menu-close{top:30px;right:26px}.menu-logo{height:20px}}
.reveal{opacity:0;transform:translateY(30px);transition:opacity 1s ease,transform 1s ease}
.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}}
.snum{font-family:var(--font-med);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--pink);margin-bottom:18px;display:block}

/* ---------- project hero ---------- */
.phero{position:relative;height:92vh;min-height:560px;width:100vw;margin-left:calc(50% - 50vw);overflow:hidden;display:flex;align-items:flex-end}
.phero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
.phero::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(0deg,rgba(0,0,0,.82) 0%,rgba(0,0,0,.30) 42%,rgba(0,0,0,.12) 70%,rgba(0,0,0,.35) 100%)}
.phero-in{position:relative;z-index:2;width:100%;padding:0 var(--pad) clamp(36px,5vw,64px);color:#f3f1ea}
.phero-eyebrow{font-family:var(--font-med);font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:#fff;opacity:.86;margin-bottom:14px}
.phero-eyebrow .dot{color:var(--pink);margin:0 8px}
.phero h1{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(48px,11vw,150px);line-height:.86;letter-spacing:-.02em}
.phero .tag{font-family:Georgia,serif;font-style:italic;font-size:clamp(17px,2.1vw,27px);color:#f3f1ea;opacity:.92;margin-top:18px;max-width:680px}
.pback{position:fixed;top:18px;left:50%;transform:translateX(-50%);z-index:61;font-family:var(--font-med);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);opacity:0;pointer-events:none;transition:opacity .3s}

/* ---------- meta strip ---------- */
.pmeta{display:grid;grid-template-columns:repeat(5,1fr);gap:1px;background:var(--line);border-bottom:1px solid var(--line)}
.pmeta .mi{background:var(--bg);padding:clamp(22px,3vw,38px) var(--pad);min-width:0}
.pmeta .mi:not(:first-child){padding-left:clamp(16px,2vw,30px)}
.pmeta .k{font-family:var(--font-med);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.pmeta .v{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(15px,1.5vw,21px);margin-top:10px;line-height:1.05;letter-spacing:-.01em}
@media(max-width:880px){.pmeta{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.pmeta{grid-template-columns:1fr}}

/* ---------- body ---------- */
.sec{padding-top:clamp(70px,10vw,120px);padding-bottom:clamp(70px,10vw,120px)}
.pbody{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(30px,6vw,90px);align-items:start}
@media(max-width:880px){.pbody{grid-template-columns:1fr;gap:24px}}
.pbody h2{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(28px,3.6vw,50px);line-height:.95;letter-spacing:-.02em}
.pbody .lede{font-size:clamp(17px,1.5vw,21px);color:var(--text);line-height:1.5;margin-bottom:22px}
.pbody p{color:var(--soft);font-size:15.5px;line-height:1.75;margin-bottom:18px;max-width:640px}

/* scope */
.pscope{margin-top:14px;border-top:1px solid var(--line)}
.pscope .row{display:flex;align-items:baseline;gap:18px;padding:18px 4px;border-bottom:1px solid var(--line)}
.pscope .n{font-family:var(--font-med);font-size:11px;color:var(--pink);letter-spacing:.1em;min-width:34px}
.pscope .s{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(16px,1.6vw,22px);letter-spacing:-.01em}

/* full image band */
.pband{width:100vw;margin-left:calc(50% - 50vw);height:clamp(360px,60vh,680px);overflow:hidden}
.pband img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 1.2s ease}

/* stats */
.pstats{border-top:1px solid var(--line);border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap}
.pstats .st{flex:1 1 0;min-width:180px}
.pstats .st{padding:clamp(34px,5vw,64px) var(--pad);border-right:1px solid var(--line)}
.pstats .st:last-child{border-right:none}
.pstats .num{font-family:var(--font-display);font-size:clamp(40px,6vw,86px);line-height:.9;letter-spacing:-.03em;color:var(--pink)}
.pstats .lab{font-family:var(--font-med);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-top:14px}
@media(max-width:760px){.pstats{grid-template-columns:1fr}.pstats .st{border-right:none;border-bottom:1px solid var(--line)}}

/* credits */
.pcred{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-top:clamp(30px,5vw,60px)}
.pcred .cr{background:var(--bg);padding:clamp(20px,2.4vw,32px) var(--pad)}
.pcred .cr .k{font-family:var(--font-med);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--pink)}
.pcred .cr .v{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(15px,1.4vw,20px);margin-top:9px;line-height:1.05;letter-spacing:-.01em}
@media(max-width:760px){.pcred{grid-template-columns:1fr 1fr}}
@media(max-width:440px){.pcred{grid-template-columns:1fr}}
/* gallery */
.pgal-wrap{padding:0 var(--pad) clamp(20px,4vw,40px)}
.pgal{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.pgal figure{position:relative;overflow:hidden;margin:0;background:var(--surf);aspect-ratio:3/2}
.pgal img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .7s ease}
.pgal figure:hover img{transform:scale(1.05)}
.pgal figcaption{position:absolute;left:0;bottom:0;width:100%;padding:14px;font-family:var(--font-med);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#fff;background:linear-gradient(0deg,rgba(0,0,0,.62),transparent);opacity:0;transition:opacity .4s}
.pgal figure:hover figcaption{opacity:1}
@media(max-width:760px){.pgal{grid-template-columns:1fr 1fr}}
/* amenities */
.pamen{display:flex;flex-wrap:wrap;gap:10px}
.pamen span{font-family:var(--font-med);font-size:12px;letter-spacing:.04em;color:var(--soft);border:1px solid var(--line);border-radius:999px;padding:9px 16px;transition:.2s}
.pamen span:hover{border-color:var(--pink);color:var(--text)}
/* life, word wall */
.twa-h{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(30px,4.4vw,64px);line-height:.95;letter-spacing:-.02em;margin-top:14px}
.tw-wall{margin-top:clamp(34px,5vw,64px);font-size:clamp(24px,3.4vw,56px);line-height:1.16;text-align:left;color:var(--text);height:8.12em;overflow:hidden}
.tw-wall span{display:inline;cursor:default;transition:color .25s}
.tw-wall .b{font-family:var(--font-display);text-transform:uppercase;letter-spacing:-.01em;cursor:pointer}
.tw-wall .i{font-family:Georgia,'Times New Roman',serif;font-style:italic}
.tw-wall .b:hover{color:var(--pink)}
.tw-wall.pw-wall{height:auto;overflow:visible}
.tw-thumb{position:fixed;left:0;top:0;width:clamp(200px,20vw,320px);aspect-ratio:3/2;object-fit:cover;pointer-events:none;opacity:0;transform:translate(18px,-50%) scale(.96);transition:opacity .25s ease,transform .25s ease;z-index:60;box-shadow:0 18px 50px rgba(0,0,0,.45)}
.tw-thumb.on{opacity:1;transform:translate(18px,-50%) scale(1)}
@media(max-width:680px){.tw-wall{font-size:clamp(20px,7vw,34px);height:auto;overflow:visible}.tw-thumb{display:none}}
/* ===== CASE STUDY (post-overview) ===== */
.stud-eyebrow{font-family:var(--font-med);font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--pink)}
.stud-h{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(30px,4.4vw,64px);line-height:.95;letter-spacing:-.02em;margin-top:14px}
/* editorial spread (magazine) */
.s-edit{padding-top:clamp(70px,10vw,130px);padding-bottom:clamp(70px,10vw,130px);border-top:1px solid var(--line)}
.edit-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(28px,4.5vw,64px);align-items:stretch}
@media(max-width:900px){.edit-grid{grid-template-columns:1fr;gap:36px}}
.edit-left{display:flex;flex-direction:column}
.edit-body{font-size:clamp(15px,1.5vw,19px);line-height:1.65;color:var(--soft);max-width:440px;margin-top:clamp(22px,3vw,40px)}
.edit-titlegroup{margin-top:auto;display:flex;flex-direction:column;padding-top:clamp(40px,6vw,80px)}
.edit-tag{display:flex;align-items:center;gap:14px}
.edit-tag .en{font-family:var(--font-display);font-size:22px;color:var(--text)}
.edit-tag .el{font-family:var(--font-med);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--pink)}
.edit-pre{font-family:var(--font-body);font-weight:300;font-size:clamp(13px,1.6vw,23px);line-height:1;letter-spacing:.02em;color:var(--text);margin-top:clamp(18px,2.5vw,34px);margin-bottom:0;margin-left:0}
.edit-word{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(48px,10vw,160px);line-height:.82;letter-spacing:-.03em;margin-top:clamp(-14px,-1vw,-4px);margin-left:-.055em;color:var(--text)}
.edit-word.ew-parc{transform:translateY(.06em)}
.pl-parc{align-items:stretch}
.pl-parc .edit-right{display:flex}
.pl-parc .cmos{aspect-ratio:auto;height:100%;flex:1}
/* 03 — The story (brochure structure index) */
.s-story{padding-top:clamp(70px,10vw,130px);padding-bottom:clamp(70px,10vw,130px);border-top:1px solid var(--line)}
.story-head{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,4.5vw,64px);align-items:end;margin:16px 0 clamp(38px,5vw,70px)}
.story-head h2{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(40px,7vw,104px);line-height:.84;letter-spacing:-.025em;margin:0;color:var(--text)}
.story-head p{color:var(--soft);font-size:clamp(15px,1.4vw,18px);line-height:1.62;max-width:460px;margin:0 0 .35em}
.story-title{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(34px,5vw,76px);line-height:.9;letter-spacing:-.025em;color:var(--text);margin:14px 0 clamp(34px,4.5vw,60px)}
.story-chs{border-top:1px solid var(--line)}
.s-story>.story-chs:first-child{border-top:none}
.sc-arch{display:flex;align-items:center;gap:15px;margin-top:1.7em;padding-top:1.35em;border-top:1px solid var(--line)}
.sc-arch img{width:66px;height:66px;object-fit:cover;object-position:center;border-radius:50%;filter:grayscale(1);flex:none}
.sc-arch-meta b{display:block;font-family:var(--font-med);color:var(--text);font-size:15px;letter-spacing:.01em}
.sc-arch-meta span{color:var(--muted);font-size:12.5px;letter-spacing:.03em}
/* chapter 04 — interactive location map */
.story-ch.lc-04{display:grid;grid-template-columns:minmax(290px,390px) 1fr;gap:clamp(16px,2.2vw,40px);align-items:center;padding-bottom:clamp(40px,6vw,92px);width:100vw;margin-left:calc(50% - 50vw);padding-left:var(--pad)}
.lc-04 .sc-body{max-width:390px;margin-bottom:0}
.locmap{width:100%;max-width:none;margin:0}
.lm-stage{position:relative;width:100%;line-height:0}
.lm-img{width:100%;height:auto;display:block}
.lm-glow{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;mix-blend-mode:screen;opacity:.5;-webkit-mask:linear-gradient(115deg,transparent 32%,#000 46%,#000 54%,transparent 68%);mask:linear-gradient(115deg,transparent 32%,#000 46%,#000 54%,transparent 68%);-webkit-mask-size:230% 230%;mask-size:230% 230%;animation:lmsweep 6.5s linear infinite}
[data-theme="light"] .lm-glow{mix-blend-mode:multiply;opacity:.5}
@keyframes lmsweep{0%{-webkit-mask-position:120% 120%;mask-position:120% 120%}100%{-webkit-mask-position:-20% -20%;mask-position:-20% -20%}}
.lm-hot{position:absolute;width:19px;height:19px;transform:translate(-50%,-50%);cursor:pointer;z-index:2;transition:opacity .3s}
.lm-hot i{position:absolute;inset:0;border-radius:50%;border:2px solid transparent;background:transparent;transition:transform .3s,background .3s,border-color .3s}
.lm-hot::after{content:attr(data-n) ' · ' attr(data-t);position:absolute;left:50%;bottom:138%;transform:translateX(-50%);background:var(--text);color:var(--bg);font-family:var(--font-med);font-size:11px;letter-spacing:.03em;padding:6px 10px;white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .25s;z-index:5}
.lm-hot:hover{z-index:6}
.lm-hot:hover i{transform:scale(1.4);background:#4fb14e;border-color:#4fb14e}
.lm-hot:hover::after{opacity:1}
.lm-stage:has(.lm-hot:hover) .lm-hot:not(:hover){opacity:.32}
@media(max-width:760px){.lm-hot{width:30px;height:30px}.lm-hot::after{font-size:13px}}
.story-ch{display:grid;grid-template-columns:1fr 1fr;gap:clamp(26px,4.5vw,68px);align-items:center;padding:clamp(40px,6vw,92px) 0;border-bottom:1px solid var(--line)}
.story-ch.rev .sc-media{order:2}
.sc-media{margin:0;position:relative;overflow:hidden;aspect-ratio:4/3;background:var(--surf)}
.sc-media img{width:100%;height:100%;object-fit:cover;display:block;filter:contrast(1.02);transition:transform .9s ease,opacity .22s ease}
.story-ch:hover .sc-media img{transform:scale(1.045)}
.sc-eyebrow{font-family:var(--font-med);text-transform:uppercase;letter-spacing:.2em;font-size:11px;color:var(--pink);margin-bottom:1.1em}
/* editorial variation blocks (Boca-style, full-bleed images) */
.b-state{display:grid;grid-template-columns:1fr 1.1fr;gap:clamp(28px,4vw,64px);align-items:center;width:100vw;margin-left:calc(50% - 50vw);padding:clamp(40px,6vw,90px) var(--pad);border-top:1px solid var(--line)}
.b-state .bs-text{display:flex;flex-direction:column;align-self:stretch}
.bs-eye{font-family:var(--font-med);text-transform:uppercase;letter-spacing:.2em;font-size:11px;color:var(--pink)}
.bs-h{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(28px,3.9vw,58px);line-height:1.0;letter-spacing:-.01em;margin:18px 0 auto;color:var(--text);max-width:15ch}
