.fc-widget{position:fixed;right:18px;bottom:18px;z-index:280;background:var(--text);color:var(--bg);border:0;border-radius:999px;padding:11px 17px 11px 13px;display:flex;align-items:center;gap:11px;cursor:pointer;box-shadow:0 12px 34px rgba(0,0,0,.3);font-family:var(--font-med);font-size:12.5px;letter-spacing:.04em;opacity:0;transform:translateY(20px);transition:.4s}
.fc-widget.on{opacity:1;transform:none}
.fc-widget .ic{width:26px;height:26px;border-radius:50%;background:var(--pink);display:flex;align-items:center;justify-content:center;font-size:14px}
.fc-widget b{color:var(--pink)}
.fc-widget.pop{animation:fcpop .5s ease}
@keyframes fcpop{40%{transform:scale(1.12)}}
/* side panel */
.fc-panel{position:fixed;top:0;right:0;height:100%;width:min(420px,92vw);background:var(--bg);border-left:1px solid var(--line);z-index:320;transform:translateX(100%);transition:transform .45s cubic-bezier(.4,0,.1,1);display:flex;flex-direction:column;padding:clamp(22px,3vw,34px)}
.fc-panel.on{transform:none}
.fc-scrim{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:315;opacity:0;pointer-events:none;transition:.4s}
.fc-scrim.on{opacity:1;pointer-events:auto}
.fc-panel-h{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px}
.fc-panel-h .e{font-family:var(--font-med);text-transform:uppercase;letter-spacing:.2em;font-size:11px;color:var(--pink)}
.fc-panel-h h3{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(26px,4vw,40px);line-height:.95;margin-top:6px;color:var(--text)}
.fc-x{background:none;border:0;font-size:26px;cursor:pointer;color:var(--muted);line-height:1}
.fc-prog{height:4px;background:var(--line);margin:18px 0 22px;position:relative;overflow:hidden}
.fc-prog i{position:absolute;inset:0 100% 0 0;background:var(--pink);transition:right .6s}
.fc-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;overflow:auto;flex:1}
.fc-slot{border:1px solid var(--line);background:var(--surf);aspect-ratio:1/1.06;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;text-align:center;padding:12px;position:relative}
.fc-slot img{width:58%;height:auto;filter:none}
.fc-slot.locked img{filter:grayscale(1) brightness(.25);opacity:.5}
.fc-slot .nm{font-family:var(--font-med);font-size:11px;letter-spacing:.04em;color:var(--text)}
.fc-slot.locked .nm{color:var(--muted)}
.fc-slot.locked::after{content:"?";position:absolute;font-family:var(--font-display);font-size:34px;color:var(--muted);opacity:.5}
.fc-reset{margin-top:16px;background:none;border:1px solid var(--line);color:var(--muted);font:inherit;font-size:12px;padding:11px;border-radius:999px;cursor:pointer;letter-spacing:.06em}
.fc-reset:hover{color:var(--text)}
/* reward modal */
.fc-modal{position:fixed;inset:0;z-index:340;display:none;align-items:center;justify-content:center;padding:5vw;background:rgba(8,9,7,.6);backdrop-filter:blur(4px)}
.fc-modal.on{display:flex}
.fc-card{background:var(--bg);border:1px solid var(--line);border-radius:28px;max-width:420px;width:100%;padding:clamp(26px,4vw,40px);text-align:center;position:relative;animation:fcup .5s cubic-bezier(.2,.8,.2,1)}
@keyframes fcup{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
.fc-card .art{width:100%;height:clamp(150px,22vh,188px);margin:0 auto 16px;display:flex;align-items:flex-end;justify-content:center}
.fc-card .art img{width:auto;height:100%;max-width:100%;object-fit:contain;filter:drop-shadow(0 12px 24px rgba(0,0,0,.28))}
.fc-card .st{font-family:var(--font-med);text-transform:uppercase;letter-spacing:.2em;font-size:11px;color:var(--pink)}
.fc-card h4{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(24px,3.6vw,38px);line-height:1;margin:8px 0 4px;color:var(--text)}
.fc-card .tag{font-family:Georgia,serif;font-style:italic;color:var(--soft);font-size:16px;margin-bottom:14px}
.fc-card .rw{border-top:1px solid var(--line);padding-top:14px;color:var(--muted);font-size:13.5px;line-height:1.6}
.fc-card .rw b{color:var(--pink);font-family:var(--font-med);display:block;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:5px}
.fc-card .ok{margin-top:20px;background:var(--text);color:var(--bg);border:0;font:inherit;font-size:12px;letter-spacing:.06em;padding:12px 22px;border-radius:999px;cursor:pointer}
.fc-card .nx{margin-top:9px;font-size:11px;color:var(--muted);letter-spacing:.04em}
/* completion */
.fc-done .fc-card{max-width:520px}
.fc-done .dls{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:16px}
.fc-done .dl{font-family:var(--font-med);font-size:11px;letter-spacing:.04em;border:1px solid var(--line);color:var(--soft);padding:8px 12px;border-radius:999px}
.fc-badge{display:inline-flex;align-items:center;gap:8px;margin-top:16px;background:var(--pink);color:#fff;font-family:var(--font-med);font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:9px 16px;border-radius:999px}
.fc-share{display:flex;gap:10px;justify-content:center;margin:20px 0 4px;flex-wrap:wrap}
.fc-share .sh{font-family:var(--font-med);font-size:12.5px;letter-spacing:.03em;padding:12px 20px;border-radius:999px;cursor:pointer;border:1px solid var(--line);background:transparent;color:var(--text);transition:.2s}
.fc-share .sh-li{background:#0a66c2;border-color:#0a66c2;color:#fff}
.fc-share .sh:hover{transform:translateY(-1px)}
.sc-arch{cursor:pointer}
.sc-arch-more{margin-left:auto;font-family:var(--font-med);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--pink);white-space:nowrap;opacity:.7;transition:opacity .25s,transform .25s}
.sc-arch:hover .sc-arch-more{opacity:1;transform:translateX(3px)}
@media(max-width:760px){.fc-widget{right:12px;bottom:12px}}
