    t0=performance.now();if(bar)bar.style.width='0';
  }
  function tick(){
    if(!vis||hov){raf=requestAnimationFrame(tick);return;}
    var p=Math.min(1,(performance.now()-t0)/DUR);if(bar)bar.style.width=(p*100)+'%';
    if(p>=1){go(cur+1);}raf=requestAnimationFrame(tick);
  }
  rows.forEach(function(r){
    r.addEventListener('click',function(){go(+r.dataset.i);});
    r.addEventListener('mouseenter',function(){go(+r.dataset.i);});
  });
  lab.addEventListener('mouseenter',function(){hov=true;});
  lab.addEventListener('mouseleave',function(){hov=false;t0=performance.now();});
  if('IntersectionObserver' in window){
    new IntersectionObserver(function(es){es.forEach(function(e){vis=e.isIntersecting;if(vis)t0=performance.now();});},{threshold:.25}).observe(lab);
  } else vis=true;
