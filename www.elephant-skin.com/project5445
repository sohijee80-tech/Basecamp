      capS=lab.querySelector('.mvs-season'),capSub=lab.querySelector('.mvs-sub'),bar=lab.querySelector('.mvs-bar');
  var n=rows.length,cur=0,raf=null,t0=0,DUR=5200,vis=false,hov=false;
  function go(i){
    i=((i%n)+n)%n;cur=i;
    imgs.forEach(function(im){im.classList.toggle('on',+im.dataset.i===i);});
    rows.forEach(function(r){r.classList.toggle('on',+r.dataset.i===i);});
