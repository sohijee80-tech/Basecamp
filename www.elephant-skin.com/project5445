(function(){
  var stage=document.getElementById('panoStage');if(!stage)return;
  var img=document.getElementById('panoImg'),bar=document.getElementById('panoBar'),
      capT=document.getElementById('panoT'),capH=document.getElementById('panoH'),thumbs=document.querySelectorAll('.pano-thumb');
  var target=0,cur=0,maxPan=0;
  function recompute(){maxPan=Math.max(0,img.offsetWidth-stage.offsetWidth);if(target>maxPan)target=maxPan;}
  function setBar(){if(!bar||!img.offsetWidth)return;var f=stage.offsetWidth/img.offsetWidth;if(f>1)f=1;bar.style.width=(f*100)+'%';var pp=maxPan>0?cur/maxPan:0;bar.style.marginLeft=(pp*(1-f)*100)+'%';}
  function loop(){cur+=(target-cur)*0.1;img.style.transform='translateX('+(-cur)+'px)';setBar();requestAnimationFrame(loop);}
  function pan(x){var r=stage.getBoundingClientRect();var pp=Math.min(1,Math.max(0,(x-r.left)/r.width));target=pp*maxPan;}
  stage.addEventListener('pointermove',function(e){pan(e.clientX);});
  stage.addEventListener('touchmove',function(e){if(e.touches[0])pan(e.touches[0].clientX);},{passive:true});
  img.addEventListener('load',recompute);
  window.addEventListener('resize',recompute);
  thumbs.forEach(function(t){t.addEventListener('click',function(){
    thumbs.forEach(function(x){x.classList.toggle('on',x===t);});
    img.src=t.dataset.src;target=0;cur=0;
    if(capT)capT.textContent=t.dataset.t;if(capH)capH.textContent=t.dataset.h;
  });});
  recompute();requestAnimationFrame(loop);
})();
