    const img=new Image();img.loading='lazy';img.alt='';img.src='life/'+order[k]+'.jpg';img.style.objectPosition=FOCUS[order[k]]||'50% 40%';fig.appendChild(img);g.appendChild(fig);return {fig,img,cur:order[k]};});
