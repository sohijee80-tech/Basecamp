  /* bands that each fill a full 6-col row → even spacing, closed last row, mixed shapes */
  function buildSpans(n){const A=[[2,2],[2,2],[2,2]],Bb=[[3,2],[3,2]],Cc=[[2,3],[2,3],[2,3]];let rem=n,two=0;while(rem%3!==0){two++;rem-=2;if(rem<0){rem=n;two=0;break;}}const three=Math.floor(rem/3);const ord=[];let bi=0;for(let i=0;i<three;i++){ord.push(i%2?Cc:A);if(bi<two&&i%3===1){ord.push(Bb);bi++;}}while(bi<two){ord.push(Bb);bi++;}const s=[];ord.forEach(b=>b.forEach(x=>s.push(x)));while(s.length<n)s.push([2,2]);return s.slice(0,n);}
  const spans=buildSpans(TOTAL);
  function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]];}return a;}
