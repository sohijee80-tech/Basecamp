/* ---------- 01 HERO, name constellation around a particle globe ---------- */
(function(){
  const stage=document.getElementById('top'),host=document.getElementById('herdNames'),cv=document.getElementById('herdCanvas'),core=document.getElementById('herdCore');
  if(!stage||!cv)return;const ctx=cv.getContext('2d');
  const cnt=document.getElementById('herdCount');if(cnt)cnt.textContent=EMP.length;
  const PINK=[255,90,46],CYAN=[45,205,224];
  const mix=k=>[Math.round(PINK[0]+(CYAN[0]-PINK[0])*k),Math.round(PINK[1]+(CYAN[1]-PINK[1])*k),Math.round(PINK[2]+(CYAN[2]-PINK[2])*k)];
  const rgba=(c,a)=>'rgba('+c[0]+','+c[1]+','+c[2]+','+a+')';
  const SPH=(function(){const n=140,pts=[],ga=Math.PI*(3-Math.sqrt(5));for(let i=0;i<n;i++){const y=1-(i/(n-1))*2,r=Math.sqrt(Math.max(0,1-y*y)),th=ga*i;pts.push([Math.cos(th)*r,y,Math.sin(th)*r]);}
    const seen=new Set(),E=[];pts.forEach((p,i)=>{const d=pts.map((q,j)=>[j,(p[0]-q[0])**2+(p[1]-q[1])**2+(p[2]-q[2])**2]).filter(a=>a[0]!==i).sort((a,b)=>a[1]-b[1]);for(let k=0;k<3;k++){const j=d[k][0],key=Math.min(i,j)+'-'+Math.max(i,j);if(!seen.has(key)){seen.add(key);E.push([Math.min(i,j),Math.max(i,j)]);}}});return{pts,E};})();
  function scat(){let x,y,tr=0;do{x=0.04+Math.random()*0.92;y=0.07+Math.random()*0.86;tr++;}while(tr<40 && ((x-0.5)*(x-0.5)/0.020 + (y-0.5)*(y-0.5)/0.055) < 1);return[x,y];}
  const items=EMP.map((e,i)=>{const el=document.createElement('div');el.className='hdot'+(e[4]?' ld':'');el.dataset.i=i;
    el.innerHTML=(e[3]?'<img loading="lazy" decoding="async" alt="" src="people/'+e[3]+'.png?v=17" onerror="this.remove()">':'')+'<span class="ini">'+initials(e[0])+'</span>';
    el.style.animationDelay=(Math.random()*2.8).toFixed(2)+'s';host.appendChild(el);
    const s=scat();
    return {el,ld:e[4],sx:s[0],sy:s[1],wph:Math.random()*6.28,wsp:0.0004+Math.random()*0.0009,wam:6+Math.random()*12};});
  const leaders=items.filter(it=>it.ld), others=items.filter(it=>!it.ld);
  leaders.forEach((it,k)=>{it.ring=0;it.ang=k/leaders.length*6.283;});
  const per=Math.ceil(others.length/3);
  others.forEach((it,k)=>{const r=Math.floor(k/per);it.ring=1+r;it.ang=(k%per)/per*6.283+r*0.5;});
  let W,H,cx,cy,dpr,sphR,RR=[],raf,running=false,t=0,rot=0,power=0,on=false;
  function size(){const r=cv.getBoundingClientRect();dpr=Math.min(devicePixelRatio||1,2);W=r.width;H=r.height;cv.width=W*dpr;cv.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);cx=W/2;cy=H/2;const m=Math.min(W,H);sphR=m*0.075;const mr=m/2-50;RR=[Math.max(m*0.205,mr*0.50),mr*0.68,mr*0.84,mr];
    items.forEach(it=>{if(it.px===undefined){it.px=it.sx*W;it.py=it.sy*H;const a=Math.random()*6.283,sp=0.14+Math.random()*0.28;it.vx=Math.cos(a)*sp;it.vy=Math.sin(a)*sp;}else{it.px=Math.min(Math.max(it.px,30),W-30);it.py=Math.min(Math.max(it.py,30),H-30);}});}
  const ease=p=>p*p*(3-2*p);
  core.addEventListener('click',()=>{on=!on;stage.classList.toggle('on',on);});
  function frame(){if(!running)return;t++;power+=((on?1:0)-power)*0.045;const P=ease(power);rot+=0.0006;ctx.clearRect(0,0,W,H);
    if(P>0.03){ctx.strokeStyle=rgba([140,140,140],0.05*P);ctx.lineWidth=1;RR.forEach(R=>{ctx.beginPath();ctx.arc(cx,cy,R,0,6.283);ctx.stroke();});}
    if(P<0.985){const mgn=34,exR=Math.min(W,H)*0.22;items.forEach(it=>{it.px+=it.vx;it.py+=it.vy;
      if(it.px<mgn){it.px=mgn;it.vx=Math.abs(it.vx);}if(it.px>W-mgn){it.px=W-mgn;it.vx=-Math.abs(it.vx);}
      if(it.py<mgn){it.py=mgn;it.vy=Math.abs(it.vy);}if(it.py>H-mgn){it.py=H-mgn;it.vy=-Math.abs(it.vy);}
      const dx=it.px-cx,dy=it.py-cy,d=Math.hypot(dx,dy)||1;if(d<exR){const nx=dx/d,ny=dy/d;it.px=cx+nx*exR;it.py=cy+ny*exR;const dp=it.vx*nx+it.vy*ny;it.vx-=2*dp*nx;it.vy-=2*dp*ny;}});}
    items.forEach(it=>{const R=RR[it.ring],a=it.ang+rot*(it.ring%2?-1:1);
      const ox=cx+Math.cos(a)*R,oy=cy+Math.sin(a)*R;
      it.el.style.left=(it.px+(ox-it.px)*P)+'px';it.el.style.top=(it.py+(oy-it.py)*P)+'px';it.el.style.transform='translate(-50%,-50%)';});
    const br=0.12+0.88*P;
    const gl=ctx.createRadialGradient(cx,cy,0,cx,cy,sphR*2.6);gl.addColorStop(0,'rgba(255,90,46,'+(0.18*P)+')');gl.addColorStop(1,'rgba(255,90,46,0)');ctx.fillStyle=gl;ctx.beginPath();ctx.arc(cx,cy,sphR*2.6,0,6.283);ctx.fill();
    const cR=Math.cos(rot*2),sR=Math.sin(rot*2),tl=0.45,ct=Math.cos(tl),st=Math.sin(tl);
    const Pp=SPH.pts.map(p=>{let x=p[0]*cR+p[2]*sR,z=-p[0]*sR+p[2]*cR,yy=p[1];const y2=yy*ct-z*st,z2=yy*st+z*ct;const pe=1.7/(1.7-z2);return{x:cx+x*sphR*pe,y:cy-y2*sphR*pe,z:z2};});
    SPH.E.forEach(([i,j])=>{const a=Pp[i],b=Pp[j],k=((a.z+b.z)/2+1)/2;const col=br>0.5?mix(1-k):[150,150,150];ctx.strokeStyle=rgba(col,(0.05+0.16*k)*(0.4+0.6*br));ctx.lineWidth=0.6;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();});
    Pp.forEach(p=>{const k=(p.z+1)/2;const col=br>0.5?mix(1-k):[150,150,150];ctx.globalAlpha=(0.2+0.6*k)*(0.4+0.6*br);ctx.fillStyle=rgba(col,1);ctx.beginPath();ctx.arc(p.x,p.y,0.7+1.3*k,0,6.283);ctx.fill();});ctx.globalAlpha=1;
    raf=requestAnimationFrame(frame);}
  function start(){if(running)return;running=true;size();raf=requestAnimationFrame(frame);}
  function stop(){running=false;cancelAnimationFrame(raf);}
  new IntersectionObserver(es=>es.forEach(e=>e.isIntersecting?start():stop()),{threshold:.01}).observe(cv);
  addEventListener('resize',size);size();
  host.addEventListener('mouseover',ev=>{const el=ev.target.closest('.hdot');if(el)showCard(EMP[+el.dataset.i]);});
  host.addEventListener('mouseout',ev=>{if(ev.target.closest('.hdot'))hideCard();});
  host.addEventListener('click',ev=>{const el=ev.target.closest('.hdot');if(el)openDrawer(+el.dataset.i);});
})();

