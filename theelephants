(function(){
  const V=[
   ['We take ownership.','When something is ours, we own it end to end, the wins, the misses and the fix. Shit happens; we own it, fix it, move forward.'],
   ['We solve before we ask.','We arrive with a point of view and a proposed solution, not just a problem. Initiative over hand-raising.'],
   ['We care about the details.','The 1% that nobody asked for is often the reason a project feels premium. We sweat it.'],
   ['We challenge the obvious.','Strategy creates differentiation. We question the default and look for the angle nobody else sees.'],
   ['We move fast.','Momentum compounds. We ship, learn and iterate instead of polishing in the dark.'],
   ['We build together.','One herd, many disciplines. The best work happens when strategy, creative and tech move as one.'],
   ['We have BaseCamp Studio.','Thick skin, long memory, big heart. The world is full of dogs, be an elephant.']
  ];
  const vt=document.getElementById('valTrack');
  vt.innerHTML=V.map(([t,x],i)=>`<div class="vitem${i===0?' lit':''}"><div class="vt">${t.replace('.','<span class="dot">.</span>')}</div><div class="vx">${x}</div></div>`).join('');
  /* drag to scroll */
  let down=false,sx=0,sl=0,moved=0;
  vt.addEventListener('mousedown',e=>{down=true;moved=0;sx=e.pageX;sl=vt.scrollLeft;vt.classList.add('drag');});
  addEventListener('mouseup',()=>{down=false;vt.classList.remove('drag');});
  addEventListener('mousemove',e=>{if(!down)return;const d=e.pageX-sx;moved+=Math.abs(d);vt.scrollLeft=sl-d;});
  vt.addEventListener('wheel',e=>{if(Math.abs(e.deltaX)<Math.abs(e.deltaY)){vt.scrollLeft+=e.deltaY;e.preventDefault();}},{passive:false});
  /* slider + markers */
  const sld=document.getElementById('valSlider'),marks=document.getElementById('valMarks');
  const maxScroll=()=>vt.scrollWidth-vt.clientWidth;
  function buildMarks(){const m=maxScroll();if(m<=0){marks.innerHTML='';return;}
    marks.innerHTML=[...vt.children].map(it=>{const pct=Math.min(100,Math.max(0,it.offsetLeft/m*100));return '<i class="val-mark" data-x="'+it.offsetLeft+'" style="left:'+pct+'%"></i>';}).join('');
    marks.querySelectorAll('.val-mark').forEach(mk=>mk.addEventListener('click',()=>vt.scrollTo({left:+mk.dataset.x,behavior:'smooth'})));}
  let slDrag=false;
  sld.addEventListener('pointerdown',()=>slDrag=true);
  addEventListener('pointerup',()=>slDrag=false);
  function sync(){const m=maxScroll();if(!slDrag)sld.value=m>0?vt.scrollLeft/m*100:0;
    const center=vt.scrollLeft+vt.clientWidth/2;let best=0,bd=1e9;const items=[...vt.children];
    items.forEach((it,i)=>{const c=it.offsetLeft+it.offsetWidth/2,d=Math.abs(c-center);if(d<bd){bd=d;best=i;}});
    items.forEach((it,i)=>it.classList.toggle('lit',i===best));
    [...marks.children].forEach((mk,i)=>mk.classList.toggle('on',i===best));}
  sld.addEventListener('input',()=>{vt.scrollLeft=maxScroll()*(sld.value/100);});
  vt.addEventListener('scroll',sync,{passive:true});
  addEventListener('resize',()=>{buildMarks();sync();});
  setTimeout(()=>{buildMarks();sync();},120);
})();

