<style>
:root{
  --pink:#FF5A2E;--pad:clamp(24px,3.5vw,56px);
  --bg:#070707;--text:#f3f1ea;--muted:#8a867d;--soft:#cfcbc0;--line:rgba(255,255,255,.10);--surf:rgba(255,255,255,.03);
  --font-display:'Etna','Helvetica Neue',Arial,sans-serif;
  --font-body:'Aaux Pro Light','Helvetica Neue',Arial,sans-serif;
  --font-med:'Aaux Pro Medium','Helvetica Neue',Arial,sans-serif;
}
html[data-theme="light"]{--bg:#f3f1ea;--text:#16130f;--muted:#6a665d;--soft:#46423a;--line:rgba(0,0,0,.13);--surf:rgba(0,0,0,.025)}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--font-body);-webkit-font-smoothing:antialiased;line-height:1.55;overflow-x:hidden;transition:background .4s,color .4s}
a{color:inherit;text-decoration:none}
::selection{background:var(--pink);color:#fff}
.wrap{max-width:none;margin:0;padding:0 var(--pad)}
.pink{color:var(--pink)}
section{position:relative}
.bar{position:fixed;top:0;left:0;right:0;z-index:60;display:flex;align-items:center;justify-content:space-between;padding:20px var(--pad);transition:background .3s}
.bar.scrolled{background:color-mix(in srgb,var(--bg) 80%,transparent);backdrop-filter:blur(12px)}
.bar .lg img{height:25px;display:block}
.bar-right{display:flex;align-items:center;gap:14px}
.themetog{display:flex;border:1px solid var(--line);border-radius:999px;overflow:hidden}
.themetog button{border:none;background:none;color:var(--muted);padding:7px 11px;cursor:pointer;font-size:13px;line-height:1;transition:.2s}
.themetog button.on{background:var(--text);color:var(--bg)}
.menu-btn{background:none;border:none;color:var(--text);cursor:pointer;font-family:var(--font-display);font-size:20px;letter-spacing:.04em;text-transform:uppercase;transition:color .25s}
.menu-btn:hover{color:var(--pink)}
.menu-overlay{position:fixed;inset:0;z-index:100;background:var(--pink);color:#0a0a0a;padding:54px 56px;display:flex;flex-direction:column;justify-content:space-between;transform:translateY(-102%);opacity:0;visibility:hidden;transition:transform .6s cubic-bezier(.76,0,.24,1),opacity .4s,visibility .6s}
.menu-overlay.open{transform:none;opacity:1;visibility:visible}
.menu-close{position:absolute;top:46px;right:52px;width:46px;height:46px;font-size:38px;cursor:pointer;background:none;border:none;color:#0a0a0a;line-height:1}
.menu-logo{height:26px;align-self:flex-start;margin-bottom:10px}
.menu-nav a{display:inline-block;font-family:var(--font-display);font-size:clamp(28px,4.6vw,54px);color:#fff;text-transform:uppercase;line-height:1.14;transition:padding-left .28s,color .2s}
.menu-nav a:hover{padding-left:18px;color:#0a0a0a}
.menu-foot{max-width:680px}
.menu-foot .slogan{font-family:var(--font-display);font-size:clamp(18px,2.4vw,26px);text-transform:uppercase}
.menu-foot p{margin-top:16px;font-size:13px;color:rgba(10,10,10,.72);max-width:540px;line-height:1.6}
.menu-social{margin-top:20px;display:flex;gap:14px}
.menu-social a{width:36px;height:36px;border:1.5px solid rgba(10,10,10,.55);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-med);font-size:12px;color:#0a0a0a;transition:.2s}
.menu-social a:hover{background:#0a0a0a;color:var(--pink)}
@media(max-width:600px){.menu-overlay{padding:36px 26px}.menu-close{top:30px;right:26px}.menu-logo{height:20px}}
.reveal{opacity:0;transform:translateY(30px);transition:opacity 1s ease,transform 1s ease}
.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}}
.snum{font-family:var(--font-med);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--pink);margin-bottom:18px;display:block}
.sec{padding-top:clamp(80px,12vh,140px);padding-bottom:clamp(80px,12vh,140px);border-top:1px solid var(--line)}
h2.big{font-family:var(--font-display);font-size:clamp(34px,6vw,84px);text-transform:uppercase;line-height:.93;letter-spacing:-.02em}
.lead{font-size:clamp(16px,1.8vw,23px);line-height:1.5;max-width:820px;margin-top:24px;color:var(--soft)}

/* ===== 01 HERO, THE HERD constellation ===== */
.herd{position:relative;width:100vw;margin-left:calc(50% - 50vw);height:100vh;overflow:hidden;background:radial-gradient(120% 90% at 50% 30%,rgba(255,90,46,.06),transparent 60%)}
.herd canvas{position:absolute;inset:0;width:100%;height:100%;z-index:1}
.herd-names{position:absolute;inset:0;z-index:3}
.hdot{position:absolute;width:46px;height:46px;border-radius:50%;overflow:hidden;cursor:pointer;transform:translate(-50%,-50%);background:#140a10;border:1.5px solid var(--pink);display:flex;align-items:center;justify-content:center;will-change:left,top;animation:dotpulse 2.8s ease-in-out infinite}
.hdot img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top center;transform-origin:top center;transform:scale(1.22);filter:grayscale(.15)}
.hdot .ini{font-family:var(--font-med);font-size:13px;color:var(--soft)}
.hdot:has(img) .ini,.hcard .hc-av:has(img) .ini,.dr-ph:has(img) .ini{opacity:0}
[data-theme="light"] .hdot{background:var(--bg)}
[data-theme="light"] .dr-ph{background:var(--bg)}
[data-theme="light"] .hcard .hc-av{background:var(--bg)}
.hdot.ld{width:66px;height:66px;border-width:2px}
.hdot:hover{box-shadow:0 0 22px 4px rgba(255,90,46,.55);z-index:20;border-color:#fff}
.hdot:hover img{filter:none}
@keyframes dotpulse{0%,100%{box-shadow:0 0 0 0 rgba(255,90,46,0)}50%{box-shadow:0 0 0 5px rgba(255,90,46,.12)}}
.herd-core{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:5;cursor:pointer;width:clamp(220px,24vw,340px);height:clamp(220px,24vw,340px);display:flex;align-items:center;justify-content:center;text-align:center}
.herd-core .hc-title{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(20px,2.4vw,34px);line-height:.92;letter-spacing:.01em;color:var(--text);transition:color .4s}
.herd:not(.on) .herd-core .hc-title{color:var(--muted)}
.herd-core .hc-power{position:absolute;left:50%;bottom:16%;transform:translateX(-50%);white-space:nowrap;font-family:var(--font-med);font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--pink);transition:opacity .4s}
.herd.on .herd-core .hc-power{opacity:0;pointer-events:none}
.herd:not(.on) .herd-core .hc-power{animation:hpulse 1.6s infinite}
@keyframes hpulse{0%,100%{opacity:.4}50%{opacity:1}}
.herd-core::before{content:"";position:absolute;left:50%;top:50%;width:160px;height:160px;border:1.5px solid var(--pink);border-radius:50%;transform:translate(-50%,-50%);opacity:0}
.herd:not(.on) .herd-core::before{animation:ringpulse 2s ease-out infinite}
@keyframes ringpulse{0%{transform:translate(-50%,-50%) scale(.5);opacity:.5}100%{transform:translate(-50%,-50%) scale(1.5);opacity:0}}
.herd-hint{position:absolute;left:50%;bottom:26px;transform:translateX(-50%);z-index:5;font-family:var(--font-med);font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);pointer-events:none;animation:hfade 2.6s ease-in-out infinite;text-align:center;width:90%}
.herd-cta{position:absolute;right:clamp(24px,4vw,70px);top:50%;transform:translateY(-50%) translateX(22px);z-index:6;max-width:300px;text-align:right;opacity:0;pointer-events:none;transition:opacity .6s ease,transform .6s ease}
.herd.on .herd-cta{opacity:1;transform:translateY(-50%);pointer-events:auto}
.hcta-q{font-family:var(--font-display);text-transform:uppercase;font-size:clamp(22px,2.4vw,36px);line-height:1.02;letter-spacing:-.01em;color:var(--text);text-shadow:0 2px 26px rgba(0,0,0,.7)}
[data-theme="light"] .hcta-q{text-shadow:0 2px 22px rgba(243,241,234,.8)}
.hcta-q em{color:var(--pink);font-style:normal}
.hcta-btn{display:inline-flex;margin-top:18px;padding:14px 28px;background:var(--pink);color:#fff;font-family:var(--font-med);text-transform:uppercase;font-size:11px;letter-spacing:.12em;border-radius:999px;transition:transform .2s}
.hcta-btn:hover{transform:translateY(-2px)}
@media(max-width:680px){.herd-cta{right:50%;transform:translate(50%,0);bottom:104px;top:auto;text-align:center;max-width:80vw}.herd.on .herd-cta{transform:translate(50%,0)}.hcta-btn{margin-top:24px}}
@keyframes hfade{0%,100%{opacity:.35}50%{opacity:.9}}
/* hover card */
.hcard{position:fixed;z-index:80;display:flex;align-items:center;gap:14px;background:color-mix(in srgb,var(--bg) 84%,transparent);border:1px solid var(--line);backdrop-filter:blur(14px);border-radius:999px;padding:8px 28px 8px 8px;opacity:0;transform:translateY(8px) scale(.97);transition:opacity .18s,transform .2s;pointer-events:none;white-space:nowrap;box-shadow:0 14px 44px rgba(0,0,0,.42)}
.hcard.show{opacity:1;transform:none}
.hcard .hc-av{width:60px;height:60px;border-radius:50%;overflow:hidden;position:relative;background:linear-gradient(135deg,var(--pink),#7a0d3a);display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.hcard .hc-av img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top center;transform-origin:top center;transform:scale(1.22)}
.hcard .hc-av .ini{font-family:var(--font-display);font-size:22px;color:#fff}
.hcard .hc-n{font-family:var(--font-med);font-size:18px;line-height:1.1;color:var(--text)}
.hcard .hc-p{font-size:13px;color:var(--muted);margin-top:3px}

/* ===== PROFILE DRAWER ===== */
.scrim{position:fixed;inset:0;z-index:110;background:rgba(0,0,0,.55);opacity:0;visibility:hidden;transition:opacity .35s,visibility .35s}
.scrim.open{opacity:1;visibility:visible}
/* ===== Herd Pass card (centered collectible modal) ===== */
.drawer{position:fixed;inset:0;z-index:111;display:flex;align-items:center;justify-content:center;padding:18px;pointer-events:none;opacity:0;transition:opacity .35s}
.drawer.open{pointer-events:auto;opacity:1}
#drawerIn{width:min(430px,100%);max-height:94vh;overflow-y:auto;overflow-x:hidden;background:var(--bg);border:1px solid var(--line);border-radius:22px;box-shadow:0 50px 120px rgba(0,0,0,.5);position:relative;transform:translateY(26px) scale(.955);transition:transform .42s cubic-bezier(.2,.75,.2,1)}
.drawer.open #drawerIn{transform:none}
[data-theme="light"] #drawerIn{background:#f3f1ea}
.dr-x{position:absolute;top:13px;right:13px;z-index:6;background:rgba(0,0,0,.32);border:none;color:#fff;width:28px;height:28px;border-radius:50%;font-size:17px;line-height:28px;text-align:center;cursor:pointer;transition:.2s;padding:0}
.dr-x:hover{background:var(--pink)}
/* hero */
.ec2-hero{position:relative;height:300px;overflow:hidden;background:linear-gradient(150deg,#7a1540 0%,#3a1122 42%,#120a0f 100%)}
.ec2-photo{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;z-index:0}
.ec2-hero::after{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(180deg,rgba(10,6,9,.5) 0%,rgba(10,6,9,0) 24%,rgba(10,6,9,0) 46%,rgba(10,6,9,.9) 100%)}
.ec2-ghost{position:absolute;right:0;top:50%;transform:translateY(-56%);font-family:var(--font-display);font-size:280px;line-height:.7;color:rgba(255,255,255,.06);z-index:0;pointer-events:none}
.ec2-top{position:absolute;top:0;left:0;right:0;z-index:3;display:flex;align-items:center;justify-content:space-between;padding:16px 50px 0 17px}
.ec2-brand{display:flex;align-items:center;gap:9px;font-family:var(--font-med);font-size:10.5px;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.93)}
.ec2-brand img{height:16px;width:auto;filter:brightness(0) invert(1);opacity:.95}
.ec2-cardno{font-family:'Aaux Pro Medium',monospace;font-size:12px;letter-spacing:.13em;color:#fff;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.22);padding:7px 13px;border-radius:999px;white-space:nowrap}
.ec2-id{position:absolute;left:0;right:0;bottom:0;z-index:3;padding:0 20px 20px}
.ec2-name{font-family:var(--font-display);text-transform:uppercase;color:#fff;font-size:clamp(28px,7vw,40px);line-height:.92;letter-spacing:.01em}
.ec2-role{font-family:var(--font-med);font-size:14px;color:rgba(255,255,255,.86);margin-top:9px}
/* body */
.ec2-body{padding:30px 24px 30px;display:flex;flex-direction:column;min-height:308px}
.ec2-content{flex:1;display:flex;flex-direction:column;justify-content:center;padding:6px 0 4px}
.ec2-content>:first-child{margin-top:0}
.ec2-k{font-family:var(--font-med);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--pink)}
.ec2-quote{border-left:2px solid var(--pink);padding-left:15px;margin-top:13px}
.ec2-quote blockquote{margin:0;font-family:Georgia,'Times New Roman',serif;font-style:italic;font-size:clamp(19px,5vw,23px);line-height:1.36;color:var(--text)}
.ec2-about{margin-top:14px;font-size:14.5px;line-height:1.66;color:var(--soft)}
.ec2-sec{margin-top:26px}
.ec2-marks{margin-top:15px;display:flex;flex-direction:column;gap:13px}
.ec2-mark{display:flex;align-items:center;gap:13px}
.ec2-dot{flex:0 0 auto;width:22px;height:22px;border-radius:50%;border:2px solid var(--pink);position:relative}
.ec2-dot::after{content:"";position:absolute;inset:5px;border-radius:50%;background:var(--pink)}
.ec2-mt{font-family:var(--font-med);font-size:15.5px;color:var(--text)}
.ec2-cat{margin-left:auto;font-family:var(--font-med);font-size:10.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted)}
.ec2-div{height:1px;background:var(--line);margin:14px 0 0}
.ec2-stats{margin-top:16px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.ec2-stat .n{font-family:var(--font-display);font-size:clamp(24px,7vw,32px);line-height:1;color:var(--text)}
.ec2-stat .l{font-family:var(--font-med);font-size:9px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:6px}
.ec2-btns{margin-top:24px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.ec2-btn{padding:15px 10px;border-radius:12px;font-family:var(--font-med);font-size:12px;letter-spacing:.13em;text-transform:uppercase;cursor:pointer;transition:.2s;border:1.5px solid var(--line);background:none;color:var(--text);text-align:center}
.ec2-btn.pri{background:var(--pink);border-color:var(--pink);color:#fff}
.ec2-btn.pri:hover{filter:brightness(1.08)}
#ecShare{width:100%;margin-top:48px}
.ec2-btn.gho:hover{border-color:var(--text)}
.ec2-btn.gho.on{border-color:var(--pink);color:var(--pink)}
.ec2-ln{display:block;text-align:center;margin-top:15px;font-family:var(--font-med);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);text-decoration:none;transition:.2s}
.ec2-ln:hover{color:var(--pink)}
@keyframes ecUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
.ec2-anim{animation:ecUp .5s both}

/* ===== DIRECTORY ===== */
.dir-tools{display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin-top:34px}
.dir-search{flex:1;min-width:220px;display:flex;align-items:center;gap:10px;border:1px solid var(--line);background:var(--surf);padding:12px 16px}
.dir-search input{flex:1;background:none;border:none;outline:none;color:var(--text);font-family:var(--font-body);font-size:15px}
.dir-search input::placeholder{color:var(--muted)}
.dir-chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
.dchip{font-family:var(--font-med);font-size:12px;border:1px solid var(--line);border-radius:999px;padding:7px 14px;cursor:pointer;color:var(--soft);background:transparent;transition:.2s;text-transform:capitalize}
.dchip:hover{border-color:var(--pink);color:var(--text)}
.dchip.on{background:var(--text);color:var(--bg);border-color:var(--text)}
.dir-table{margin-top:26px;border-top:1px solid var(--line)}
.dir-row{display:grid;grid-template-columns:1.4fr 1fr;align-items:center;gap:14px;padding:16px 6px;border-bottom:1px solid var(--line);cursor:pointer;transition:background .2s,padding-left .2s}
.dir-row:hover{background:var(--surf);padding-left:14px}
.dir-row .ravatar{width:34px;height:34px;border-radius:50%;overflow:hidden;background:#0a0a0a;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.dir-row .ravatar img{width:100%;height:100%;object-fit:cover;object-position:top;filter:grayscale(.3)}
.dir-row .ravatar .ini{font-family:var(--font-med);font-size:11px;color:var(--muted)}
.dir-row .rn{font-family:var(--font-med);font-size:15.5px;color:var(--text)}
.dir-row .rp{font-size:13.5px;color:var(--muted)}
.dir-row .rld{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--pink);margin-left:8px;vertical-align:middle}
.dir-empty{padding:26px 6px;color:var(--muted);font-size:14px}
.dir-more-wrap{margin-top:24px;text-align:center}
.dir-more{background:none;border:1.5px solid var(--line);color:var(--text);font-family:var(--font-med);font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:13px 30px;border-radius:999px;cursor:pointer;transition:border-color .2s,color .2s}
.dir-more:hover{border-color:var(--pink);color:var(--pink)}
@media(max-width:600px){.dir-row{grid-template-columns:1fr;gap:3px;padding:14px 6px}.dir-row .rp{grid-column:1;color:var(--muted)}}

/* ===== LIFE gallery ===== */
.life-head{display:grid;grid-template-columns:1.5fr 1fr;gap:clamp(24px,5vw,72px);align-items:end}
@media(max-width:860px){.life-head{grid-template-columns:1fr;gap:22px;align-items:start}}
.life-sub{font-size:15px;line-height:1.72;color:var(--soft);max-width:480px}
.life-wrap{position:relative;margin-top:40px}
.life-wrap.collapsed .life-grid{max-height:clamp(360px,42vw,600px);overflow:hidden}
.life-more-wrap{text-align:center;margin-top:22px}
.life-more{background:none;border:1.5px solid var(--line);color:var(--text);font-family:var(--font-med);font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:13px 30px;border-radius:999px;cursor:pointer;transition:border-color .2s,color .2s}
.life-more:hover{border-color:var(--pink);color:var(--pink)}
.life-grid{display:grid;grid-template-columns:repeat(6,1fr);grid-auto-rows:clamp(80px,11vw,150px);gap:10px}
.life-grid figure{margin:0;position:relative;overflow:hidden;background:#0d0d0d}
.life-grid img{width:100%;height:100%;object-fit:cover;display:block;filter:grayscale(1);transition:opacity .55s ease,transform .6s ease,filter .45s ease}
.life-grid figure:hover img{filter:grayscale(0);transform:scale(1.05)}
.life-grid figure.swapping img{opacity:0}
@media(max-width:980px){.life-grid{grid-template-columns:repeat(3,1fr);grid-auto-rows:auto;gap:9px}.life-grid figure{grid-column:auto!important;grid-row:auto!important;aspect-ratio:1}}
@media(max-width:560px){.life-grid{grid-template-columns:repeat(2,1fr);gap:8px}}

/* ===== HUBS ===== */
