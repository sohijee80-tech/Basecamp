/* ===== Share Card → 1080×1920 Instagram-Story image ===== */
function wrapLines(ctx,text,maxW){const words=(text||'').split(' '),lines=[];let ln='';
  for(const w of words){const test=ln?ln+' '+w:w;if(ctx.measureText(test).width>maxW&&ln){lines.push(ln);ln=w;}else ln=test;}
  if(ln)lines.push(ln);return lines;}
function shareStory(e,cardno,quote,btn){
  const W=1080,H=1920,cv=document.createElement('canvas');cv.width=W;cv.height=H;const ctx=cv.getContext('2d');
  const _ne=document.querySelector('.ec2-name'),_re=document.querySelector('.ec2-role');
  const DISP=(_ne&&getComputedStyle(_ne).fontFamily)||'"Etna",sans-serif';
  const MED=(_re&&getComputedStyle(_re).fontFamily)||'"Aaux Pro Medium",sans-serif';
  const draw=img=>{
    // background gradient
    let g=ctx.createLinearGradient(0,0,W*0.5,H);g.addColorStop(0,'#6e1339');g.addColorStop(.45,'#2a0f1c');g.addColorStop(1,'#080507');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
    const photoH=1240;
    if(img){const s=Math.max(W/img.width,photoH/img.height),iw=img.width*s,ih=img.height*s;ctx.drawImage(img,(W-iw)/2,0,iw,ih);}
    else{ctx.save();ctx.font='900 760px '+DISP;ctx.fillStyle='rgba(255,255,255,.06)';ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText((e[0]||'')[0]||'E',W/2,photoH*0.5);ctx.restore();}
    // scrim
    let sc=ctx.createLinearGradient(0,photoH-560,0,photoH);sc.addColorStop(0,'rgba(8,5,7,0)');sc.addColorStop(1,'#080507');ctx.fillStyle=sc;ctx.fillRect(0,photoH-560,W,560);
    ctx.fillStyle='#080507';ctx.fillRect(0,photoH,W,H-photoH);
    // header
    ctx.textAlign='left';ctx.textBaseline='alphabetic';ctx.fillStyle='rgba(255,255,255,.92)';ctx.font='600 26px '+MED;ctx.letterSpacing='3px';
    ctx.fillText('ELEPHANT SKIN · HERD PASS',64,80);
    ctx.textAlign='right';ctx.fillText(cardno,W-64,80);ctx.letterSpacing='0px';ctx.textAlign='left';
    // name
    let y=photoH-150;ctx.fillStyle='#fff';ctx.font='400 108px '+DISP;
    const nm=(e[0]||'').toUpperCase(),nLines=wrapLines(ctx,nm,W-128);
    nLines.forEach((l,k)=>ctx.fillText(l,64,y+k*104));
    y+=(nLines.length-1)*104+64;
    ctx.fillStyle='rgba(255,255,255,.85)';ctx.font='500 38px '+MED;ctx.fillText(e[1]||'',64,y);
    // quote
    y+=110;
    if(quote){ctx.fillStyle='#FF5A2E';ctx.fillRect(64,y-44,5,0);
      ctx.font='italic 46px Georgia, serif';ctx.fillStyle='#f3f1ea';
      const qLines=wrapLines(ctx,'“'+quote.replace(/^["“]+|["”]+$/g,'')+'”',W-180);
      const qy0=y;qLines.forEach((l,k)=>ctx.fillText(l,96,y+k*62));
      const qh=qLines.length*62;ctx.fillStyle='#FF5A2E';ctx.fillRect(64,qy0-40,5,qh-6);
      y+=qh;}
    // footer
    ctx.fillStyle='rgba(255,255,255,.55)';ctx.font='600 26px '+MED;ctx.letterSpacing='3px';
    ctx.fillText('THE HERD',64,H-90);ctx.textAlign='right';ctx.fillStyle='#FF5A2E';ctx.fillText('ELEPHANT-SKIN.COM',W-64,H-90);ctx.letterSpacing='0px';ctx.textAlign='left';
    finish();
  };
  const finish=()=>{
    const slug=(e[0]||'card').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'');
    try{
      cv.toBlob(async blob=>{
        if(!blob){fallback();return;}
        const file=new File([blob],'elephant-skin-'+slug+'.png',{type:'image/png'});
        if(navigator.canShare&&navigator.canShare({files:[file]})){
          try{await navigator.share({files:[file],title:e[0]+' · BaseCamp Studio'});btn.textContent='Share card';return;}catch(x){}
        }
        const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=file.name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1500);
        btn.textContent='Image saved ✓';setTimeout(()=>btn.textContent='Share card',1800);
      },'image/png');
    }catch(x){fallback();}
  };
  const fallback=()=>{btn.textContent='Open the live site to share';setTimeout(()=>btn.textContent='Share card',2200);};
  btn.textContent='Generating…';
  const run=()=>{ if(e[3]){const img=new Image();img.crossOrigin='anonymous';img.onload=()=>draw(img);img.onerror=()=>draw(null);img.src='people/'+e[3]+'.png?v=17';} else draw(null); };
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(run);else run();
}
