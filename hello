/* ===== 06 system — pink particle globe; click to expand & reveal the big numbers ===== */
const sys=(function(){
  const D=Math.PI/180;let cv,ctx,W,H,dpr,raf,running=false,inited=false,rot=0,t=0,parts=[],sphere=[];
  for(let lat=-78;lat<=78;lat+=10){const r=Math.cos(lat*D);const n=Math.max(6,Math.round(28*r));for(let k=0;k<n;k++)sphere.push([lat,(k/n)*360-180]);}
  const ll=(la,lo)=>{const a=la*D,b=lo*D;return{x:Math.cos(a)*Math.cos(b),y:Math.sin(a),z:Math.cos(a)*Math.sin(b)};};
  const METRICS=[['365','+','Projects'],['100','+','Specialists'],['37','','Cities'],['10','','Offices'],['5','B+','Sales impact','$']];
  let expanded=false, ef=0;
  function size(){const r=cv.getBoundingClientRect();if(!r.width)return;dpr=Math.min(devicePixelRatio||1,2);W=r.width;H=r.height;cv.width=W*dpr;cv.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);build();placeMetrics();}
  function cx(){return W/2;}function cy(){return H/2;}
  function Rg(){return Math.min(W,H)*0.155;}
  function build(){parts=[];for(let i=0;i<220;i++){const a=Math.random()*6.3;parts.push({a,r0:Math.sqrt(Math.random())*Rg()*1.05,r1:Rg()*1.7+Math.random()*Math.min(W,H)*0.30,sp:0.3+Math.random()*0.8,r:Math.random()*1.7+0.6});}}
  function placeMetrics(){const host=document.getElementById('sysMetrics');if(!host)return;const R=Math.min(W,H)*0.42;host.innerHTML=METRICS.map((m,i)=>{const a=(-90+i*(360/METRICS.length))*D;const x=50+Math.cos(a)*(R/W*100),y=50+Math.sin(a)*(R/H*100);return `<div class="sys-m" style="left:${x}%;top:${y}%"><div class="mv">${m[3]||''}<span class="num" data-t="${m[0]}">0</span>${m[1]}</div><div class="ml">${m[2]}</div></div>`;}).join('');
    if(counted)host.querySelectorAll('.num').forEach(el=>{el.textContent=el.dataset.t;});}
  function proj(v){const cR=Math.cos(rot),sR=Math.sin(rot);let x=v.x*cR+v.z*sR,z=-v.x*sR+v.z*cR,y=v.y;return{x:cx()+x*Rg(),y:cy()-y*Rg(),z};}
  function frame(){if(!running)return;t++;ef+=((expanded?1:0)-ef)*0.06;ctx.clearRect(0,0,W,H);
    // pink glow
    const gg=ctx.createRadialGradient(cx(),cy(),0,cx(),cy(),Rg()*1.7);gg.addColorStop(0,'rgba(255,90,46,'+(0.18+0.06*ef)+')');gg.addColorStop(1,'rgba(255,90,46,0)');ctx.fillStyle=gg;ctx.beginPath();ctx.arc(cx(),cy(),Rg()*1.7,0,6.3);ctx.fill();
    // expanding particle cloud
    parts.forEach(p=>{p.a+=0.0010*p.sp;const rad=p.r0+(p.r1-p.r0)*ef;const x=cx()+Math.cos(p.a)*rad,y=cy()+Math.sin(p.a)*rad*0.92;ctx.globalAlpha=0.4+0.45*ef;ctx.fillStyle='#FF5A2E';ctx.beginPath();ctx.arc(x,y,p.r,0,6.3);ctx.fill();});
    ctx.globalAlpha=1;
    // pink particle globe (fades open as it expands)
    rot+=0.0018;
    sphere.forEach(([la,lo])=>{const p=proj(ll(la,lo));if(p.z<-0.05)return;ctx.globalAlpha=(0.18+0.62*((p.z+1)/2))*(1-0.78*ef);ctx.fillStyle='#FF5A2E';ctx.beginPath();ctx.arc(p.x,p.y,1.5,0,6.3);ctx.fill();});
    ctx.globalAlpha=1;raf=requestAnimationFrame(frame);}
  let counted=false;
  function count(){if(counted)return;counted=true;document.querySelectorAll('#sysMetrics .num').forEach((el,i)=>{const tv=+el.dataset.t,dur=1500,st=performance.now()+i*100;function tk(now){if(now<st){requestAnimationFrame(tk);return;}const pr=Math.min(1,(now-st)/dur),e=1-Math.pow(1-pr,3);el.textContent=Math.round(e*tv);if(pr<1)requestAnimationFrame(tk);}requestAnimationFrame(tk);});}
  function setExpanded(v){expanded=v;const host=document.getElementById('sysMetrics'),hint=document.getElementById('sysHint');if(host)host.classList.toggle('show',v);if(hint)hint.classList.toggle('hide',v);if(v)count();}
  function start(){if(running)return;running=true;size();raf=requestAnimationFrame(frame);}
  function stop(){running=false;cancelAnimationFrame(raf);}
  return {init(){if(inited)return;cv=document.getElementById('sysCv');if(!cv)return;ctx=cv.getContext('2d');
    cv.addEventListener('click',()=>setExpanded(!expanded));
    new IntersectionObserver(es=>es.forEach(e=>{e.isIntersecting?start():stop();if(e.isIntersecting&&innerWidth<=760&&!expanded)setTimeout(()=>setExpanded(true),700);})).observe(cv);
    addEventListener('resize',size);inited=true;size();start();}};
})();

