<style>
:root{
  --pink:#FF5A2E;--pad:clamp(24px,3.5vw,56px);--ink:#070707;--panel:#101012;--paper:#f3f1ea;
  --bg:#070707;--text:#f3f1ea;--muted:#8a867d;--soft:#cfcbc0;--line:rgba(255,255,255,.10);
  --font-display:'Etna','Helvetica Neue',Arial,sans-serif;
  --font-body:'Aaux Pro Light','Helvetica Neue',Arial,sans-serif;
  --font-med:'Aaux Pro Medium','Helvetica Neue',Arial,sans-serif;
}
html[data-theme="light"]{--bg:#f3f1ea;--text:#16130f;--muted:#6a665d;--soft:#46423a;--line:rgba(0,0,0,.14)}
/* only the cinematic openers stay forced-dark; everything (incl. radar/globe) follows the theme */
html[data-theme="light"] #intro,html[data-theme="light"] #postit{background:#070707;color:#f3f1ea;--text:#f3f1ea;--muted:#8a867d;--soft:#cfcbc0;--line:rgba(255,255,255,.10)}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--text);font-family:var(--font-body);-webkit-font-smoothing:antialiased;line-height:1.55;overflow-x:hidden;transition:background .4s,color .4s}
body.intro-active{overflow:hidden;height:100vh}
a{color:inherit;text-decoration:none}
::selection{background:var(--pink);color:#fff}
.wrap{max-width:none;margin:0;padding:0 var(--pad)}
.eyebrow{font-family:var(--font-med);font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:var(--pink)}
.pink,.pk{color:var(--pink)}
section{position:relative}

/* top bar */
.bar{position:fixed;top:0;left:0;right:0;z-index:60;display:flex;align-items:center;justify-content:space-between;padding:20px var(--pad);transition:background .3s,opacity .5s}
.bar.scrolled{background:rgba(7,7,7,.72);backdrop-filter:blur(12px)}
html[data-theme="light"] .bar.scrolled{background:rgba(243,241,234,.82)}
.bar{z-index:95}
.bar .lg img{height:25px;display:block}
.bar-right{display:flex;align-items:center;gap:14px}
.themetog{display:flex;border:1px solid var(--line);border-radius:999px;overflow:hidden}
.themetog button{border:none;background:none;color:var(--muted);padding:7px 11px;cursor:pointer;font-size:13px;line-height:1;transition:.2s}
.themetog button.on{background:var(--text);color:var(--bg)}
body.intro-active .themetog{display:none}
.menu-btn{background:none;border:none;color:var(--text);cursor:pointer;font-family:var(--font-display);font-size:20px;letter-spacing:.04em;text-transform:uppercase;transition:color .25s}
.menu-btn:hover{color:var(--pink)}

/* menu overlay */
.menu-overlay{position:fixed;inset:0;z-index:100;background:var(--pink);color:#0a0a0a;padding:54px 56px;display:flex;flex-direction:column;justify-content:space-between;transform:translateY(-102%);opacity:0;visibility:hidden;transition:transform .6s cubic-bezier(.76,0,.24,1),opacity .4s,visibility .6s}
.menu-overlay.open{transform:none;opacity:1;visibility:visible}
.menu-close{position:absolute;top:46px;right:52px;width:46px;height:46px;font-size:38px;cursor:pointer;background:none;border:none;color:#0a0a0a;line-height:1}
.menu-logo{height:26px;align-self:flex-start;margin-bottom:10px}
.menu-nav a{display:inline-block;font-family:var(--font-display);font-size:clamp(28px,4.6vw,54px);color:#fff;text-transform:uppercase;line-height:1.14;transition:padding-left .28s,color .2s}
.menu-nav a:hover{padding-left:18px;color:#0a0a0a}
.menu-foot{max-width:680px}
.menu-foot .slogan{font-family:var(--font-display);font-size:clamp(18px,2.4vw,26px);text-transform:uppercase}
.menu-foot p{margin-top:16px;font-size:13px;color:rgba(10,10,10,.72);max-width:540px;line-height:1.6}
.menu-social{margin-top:20px;display:flex;gap:14px}
.menu-social a{width:36px;height:36px;border:1.5px solid rgba(10,10,10,.55);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--font-med);font-size:12px;color:#0a0a0a;transition:.2s}
.menu-social a:hover{background:#0a0a0a;color:var(--pink)}
@media(max-width:600px){.menu-overlay{padding:36px 26px}.menu-close{top:30px;right:26px}.menu-logo{height:20px}}

/* reveal */
.reveal{opacity:0;transform:translateY(34px);transition:opacity 1s ease,transform 1s ease}
.reveal.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){.reveal{opacity:1;transform:none}}

.sec{padding:clamp(90px,14vh,170px) 0;border-top:1px solid var(--line);position:relative}
.sec.full{min-height:100vh;display:flex;flex-direction:column;justify-content:center}
.sec.center{text-align:center}
.sec.light{background:var(--paper);color:#0e0e0e}
.snum{font-family:var(--font-med);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--pink);margin-bottom:18px;display:block}
h2.big{font-family:var(--font-display);font-size:clamp(34px,6.2vw,92px);text-transform:uppercase;line-height:.93;letter-spacing:-.02em}
.lead{font-size:clamp(17px,2.1vw,27px);line-height:1.45;max-width:760px;margin-top:24px;color:var(--soft)}
.sec.light .lead{color:#3a3a3a}

/* ===== 01 INTRO ===== */
.intro{position:fixed;inset:0;z-index:90;background:#040405;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;transition:opacity 1s ease,visibility 1s}
.intro.gone{opacity:0;visibility:hidden;pointer-events:none}
.intro-head{height:clamp(40px,5vw,64px);margin-bottom:26px;opacity:0;transform:translateY(10px) scale(.9);transition:opacity .7s ease,transform .7s ease}
.intro-head.show{opacity:1;transform:none}
.intro-line{font-family:var(--font-display);font-size:clamp(54px,12vw,150px);text-transform:uppercase;line-height:.9;letter-spacing:-.02em;color:#fff;opacity:0;transform:translateY(20px);transition:opacity .7s ease,transform .7s ease;min-height:1.1em;padding:0 24px}
.intro-line.show{opacity:1;transform:none}
.intro-sub{font-family:var(--font-med);font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--muted);margin-top:26px;opacity:0;transition:opacity .6s}
.intro-sub.show{opacity:1}
.intro-q{margin-top:48px;display:flex;gap:16px;opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease;pointer-events:none}
.intro-q.show{opacity:1;transform:none;pointer-events:auto}
.iq{background:none;border:1.5px solid rgba(255,255,255,.3);color:#fff;font-family:var(--font-display);font-size:clamp(20px,2.4vw,30px);text-transform:uppercase;letter-spacing:.02em;padding:14px 44px;border-radius:999px;cursor:pointer;transition:.25s}
.iq:hover{background:var(--pink);border-color:var(--pink)}
.intro-skip{position:absolute;bottom:30px;left:50%;transform:translateX(-50%);font-family:var(--font-med);font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#4a4a4a;background:none;border:none;cursor:pointer}
.intro-skip:hover{color:var(--pink)}

/* ===== 02 POST-IT ===== */
#postit{overflow:hidden;background:#0a0a0a;min-height:100vh;display:flex;flex-direction:column;justify-content:center}
.postit-bg{position:absolute;inset:0;z-index:0;background:#1a1416 url('postit.jpg') 57% 70%/cover no-repeat;filter:blur(16px) brightness(.5) saturate(1.1);transform:scale(1.08);transition:filter 1.2s ease,transform 1.2s ease;will-change:filter,transform}
#postit.focus .postit-bg{filter:blur(2px) brightness(.82);transform:scale(1.05)}
@media(max-width:760px){.postit-bg{filter:blur(2.5px) brightness(.72) saturate(1.1)!important;transform:scale(1.04)!important}.postit-veil{background:linear-gradient(180deg,rgba(7,7,7,.5) 0%,rgba(7,7,7,.32) 42%,rgba(7,7,7,.72) 100%)}}
.postit-veil{position:absolute;inset:0;z-index:1;background:linear-gradient(90deg,rgba(7,7,7,.92) 0%,rgba(7,7,7,.5) 46%,rgba(7,7,7,.12) 100%)}
.postit-copy{position:relative;z-index:3;max-width:680px}
.postit-copy em{font-family:Georgia,serif;font-style:italic;color:#fff}
.pi-note{position:absolute;z-index:2;font-family:var(--font-med);font-size:clamp(12px,1.2vw,15px);letter-spacing:.04em;color:#fff;text-transform:uppercase;opacity:0;transform:translateY(8px);transition:opacity .5s ease,transform .5s ease;pointer-events:none;text-shadow:0 2px 14px rgba(0,0,0,.8)}
.pi-note::before{content:"";position:absolute;left:-14px;top:50%;width:7px;height:7px;border-radius:50%;background:var(--pink);transform:translateY(-50%);box-shadow:0 0 14px var(--pink)}
.pi-note.near{opacity:1;transform:none}
.postit-final{font-family:var(--font-display);font-size:clamp(26px,3.4vw,46px);text-transform:uppercase;line-height:1;margin-top:34px;letter-spacing:-.01em}
/* clickable post-it → Giovana's ID card */
.gio-note{display:inline-flex;align-items:center;gap:12px;margin-top:32px;background:none;border:none;padding:0;color:var(--text);font-family:var(--font-med);font-size:14px;letter-spacing:.04em;cursor:pointer;transition:color .2s}
.gio-note:hover{color:var(--pink)}
.gio-note .gp{width:12px;height:12px;border-radius:50%;background:var(--pink);box-shadow:0 0 16px var(--pink);animation:pulse 1.8s infinite;flex:0 0 auto}
.gio-modal{position:fixed;inset:0;z-index:90;background:rgba(4,4,5,.86);backdrop-filter:blur(7px);display:flex;align-items:center;justify-content:center;padding:30px;opacity:0;visibility:hidden;transition:.3s}
.gio-modal.open{opacity:1;visibility:visible}
.gio-card{position:relative;max-width:540px;width:100%;background:var(--paper);color:#16130f;border-radius:14px;overflow:hidden;box-shadow:0 50px 110px rgba(0,0,0,.6);transform:translateY(14px) scale(.97);transition:transform .35s cubic-bezier(.2,.7,.2,1)}
.gio-modal.open .gio-card{transform:none}
.gio-close{position:absolute;top:12px;right:14px;background:none;border:none;font-size:24px;line-height:1;color:#16130f;cursor:pointer;z-index:3}
.gio-id{display:flex;gap:22px;align-items:center;padding:28px 30px;background:linear-gradient(120deg,#fbe3ec,#f3f1ea);border-bottom:2px solid var(--pink)}
.gio-photo{width:98px;height:124px;flex:0 0 auto;border-radius:8px;background:#3a2230 center/cover no-repeat;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-size:56px;color:#fff;box-shadow:0 10px 26px rgba(255,90,46,.4);overflow:hidden}
.gio-meta .gio-org{font-family:var(--font-med);font-size:9.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--pink)}
.gio-meta h3{font-family:var(--font-display);font-size:clamp(28px,3.4vw,38px);text-transform:uppercase;line-height:.9;margin:6px 0 8px}
.gio-meta .gio-role{font-family:var(--font-med);font-size:12px;letter-spacing:.03em;color:#3a3a3a}
.gio-meta .gio-loc{font-size:12px;color:#8a7f6a;margin-top:5px;letter-spacing:.05em}
.gio-quote{font-family:Georgia,serif;font-style:italic;font-size:clamp(16px,1.6vw,19px);line-height:1.62;padding:26px 30px 6px;color:#2a2620}
.gio-quote b{font-style:normal;color:var(--pink)}
.gio-sign{font-family:var(--font-med);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#8a7f6a;padding:0 30px 28px}

/* ===== 03 JOURNEY ===== */
.jrail{margin-top:50px;display:flex;gap:clamp(20px,2vw,34px);overflow-x:auto;padding:10px var(--pad) 40px;scroll-snap-type:x proximity;scrollbar-width:none;cursor:grab}
.jrail::-webkit-scrollbar{display:none}
.jrail.drag{cursor:grabbing}
.jtimeline{margin:34px var(--pad) 0;padding:14px 0}
.jtrack{height:3px;background:var(--line);position:relative;border-radius:3px;cursor:pointer}
.jtrack i{position:absolute;left:0;top:0;height:100%;width:0;background:var(--pink);border-radius:3px;transition:width .08s linear;box-shadow:0 0 14px rgba(255,90,46,.65)}
.jknob{position:absolute;top:50%;left:0;width:20px;height:20px;border-radius:50%;background:var(--pink);border:3px solid var(--bg);box-shadow:0 0 0 1px var(--pink),0 0 18px rgba(255,90,46,.7);transform:translate(-50%,-50%);cursor:grab;transition:left .08s linear;touch-action:none}
.jknob:active{cursor:grabbing}
.jknob::after{content:"DRAG";position:absolute;top:-26px;left:50%;transform:translateX(-50%);font-family:var(--font-med);font-size:8px;letter-spacing:.18em;color:var(--pink);white-space:nowrap;opacity:.8}
.jticks{position:absolute;inset:0;pointer-events:none}
.jtick{position:absolute;top:50%;width:6px;height:6px;border-radius:50%;background:var(--line);transform:translate(-50%,-50%)}
.jtick.on{background:var(--pink)}
.jcard{flex:0 0 auto;width:clamp(280px,32vw,440px);scroll-snap-align:center;padding-left:26px;position:relative;opacity:.3;transition:opacity .6s ease}
.jcard::before{content:"";position:absolute;left:0;top:0;bottom:0;width:1px;background:var(--line);transition:background .5s}
.jcard::after{content:"";position:absolute;left:-4px;top:0;width:9px;height:9px;border-radius:50%;background:#3a3a3a;transition:background .4s,box-shadow .4s}
.jcard.lit{opacity:1}
.jcard.lit::before{background:rgba(255,90,46,.45)}
.jcard.lit::after{background:var(--pink);box-shadow:0 0 12px var(--pink)}
.jcard .yr{font-family:var(--font-display);font-size:clamp(48px,7vw,108px);line-height:.9;color:#5c5c5c;transition:color .5s}
.jcard.lit .yr{color:var(--pink)}
.jcard .jt{font-family:var(--font-display);font-size:clamp(20px,2vw,28px);text-transform:uppercase;margin-top:14px;line-height:1.05}
.jcard p{color:var(--muted);font-size:14.5px;margin-top:12px;max-width:340px;line-height:1.6}
.jcard .jmeta{margin-top:18px;font-family:var(--font-med);font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:#5c5c5c;transition:color .5s}
.jcard.lit .jmeta{color:var(--pink)}
.jhint{font-family:var(--font-med);font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-top:8px}

/* ===== 04 VALUES (are you an elephant) ===== */
.vgrid{margin-top:48px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
@media(max-width:1100px){.vgrid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.vgrid{grid-template-columns:1fr}}
.vq{position:relative;border:1px solid var(--line);border-radius:14px;padding:22px;background:rgba(127,127,127,.05);min-height:238px;display:flex;flex-direction:column;overflow:hidden;transition:border-color .4s,background .4s}
.vq.done{border-color:rgba(255,90,46,.5);background:rgba(255,90,46,.06)}
.vq .vqn{font-family:var(--font-med);font-size:10px;letter-spacing:.16em;color:var(--muted);margin-bottom:10px}
.vq .vqh{font-family:var(--font-display);font-size:clamp(17px,1.5vw,22px);text-transform:uppercase;line-height:1.05}
.vopts{display:flex;flex-direction:column;gap:9px;margin-top:auto}
.vopt{text-align:left;background:none;border:1px solid var(--line);color:var(--soft);font-family:var(--font-med);font-size:13.5px;padding:12px 15px;border-radius:9px;cursor:pointer;transition:.2s}
.vopt:hover{border-color:var(--pink);color:var(--text)}
.vopt.good{background:var(--pink);border-color:var(--pink);color:#fff}
.vopt.bad{opacity:.35}
.vresult{position:absolute;inset:0;background:linear-gradient(160deg,#1a0a12,#0a0a0c);color:#fff;padding:24px;display:flex;flex-direction:column;justify-content:center;opacity:0;visibility:hidden;transform:scale(.98);transition:opacity .5s,transform .5s,visibility .5s}
.vresult.show{opacity:1;visibility:visible;transform:none}
.vresult .vr-h{font-family:var(--font-display);font-size:clamp(18px,1.6vw,24px);text-transform:uppercase;line-height:1.05;color:var(--pink)}
.vresult small{display:block;font-family:var(--font-body);text-transform:none;font-size:13.5px;color:#cfcbc0;margin-top:12px;letter-spacing:0;line-height:1.5}
.vresult .vr-again{margin-top:16px;align-self:flex-start;font-family:var(--font-med);font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);background:none;border:none;cursor:pointer}
.vresult .vr-again:hover{color:var(--pink)}

/* ===== 05 HERD, living global system (full-bleed map, from the home) ===== */
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(255,90,46,.6)}70%{box-shadow:0 0 0 10px rgba(255,90,46,0)}100%{box-shadow:0 0 0 0 rgba(255,90,46,0)}}
#herd.herd-live{position:relative;overflow:hidden;min-height:122vh;display:block;padding:0}
.herd-live #herdCanvas{position:absolute;inset:0;width:100%;height:100%;z-index:0;display:block}
.herd-copy{position:relative;z-index:2;width:100%;padding-top:clamp(86px,12vh,150px);pointer-events:none}
.herd-copy h2.big{margin-top:6px}
.herd-copy .herd-sub{max-width:560px;margin-top:20px}
.herd-pops{position:absolute;inset:0;z-index:2;pointer-events:none}
.herd-pop{position:absolute;display:flex;align-items:center;gap:9px;background:rgba(14,14,14,.62);border:1px solid var(--line);backdrop-filter:blur(6px);padding:8px 13px;font-family:var(--font-med);font-size:12px;color:#cfcbc0;letter-spacing:.02em;white-space:nowrap;opacity:0;transform:translateY(10px) scale(.97);transition:opacity .55s ease,transform .55s ease;transform-origin:left center}
.herd-pop.in{opacity:1;transform:none}
.herd-pop i{width:7px;height:7px;border-radius:50%;background:var(--pink);box-shadow:0 0 0 0 rgba(255,90,46,.6);animation:pulse 2s infinite;flex:0 0 auto}
.herd-pop b{color:#fff;font-weight:400}
.herd-panel{position:absolute;top:88px;right:18px;z-index:4;width:288px;max-width:calc(100% - 36px);background:none;border:none;padding:0;opacity:0;visibility:hidden;transform:translateY(8px);transition:opacity .25s ease,transform .25s ease,visibility .25s}
.herd-panel.show{opacity:1;visibility:visible;transform:none}
.herd-panel .hp-status{display:flex;align-items:center;gap:8px;font-family:var(--font-med);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--pink)}
.herd-panel .hp-status i{width:8px;height:8px;border-radius:50%;background:var(--pink)}
.herd-panel .hp-status.rest i{background:#5a5a5a}
.herd-panel .hp-status.rest{color:#8a867d}
.herd-panel h4{font-family:var(--font-display);font-size:26px;text-transform:uppercase;margin-top:12px;line-height:1}
.herd-panel .hp-time{font-family:var(--font-display);font-size:34px;color:var(--text);line-height:1;margin-top:8px}
.herd-panel .hp-row{margin-top:16px;border-top:1px solid var(--line);padding-top:12px}
.herd-panel .hp-k{font-family:var(--font-med);font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#8a867d}
.herd-panel .hp-v{font-size:14px;color:var(--text);margin-top:4px;line-height:1.5}
.herd-panel .hp-v .pp{color:var(--pink)}
.herd-facts{position:absolute;left:0;right:0;bottom:clamp(56px,10vh,120px);z-index:2;width:calc(100% - clamp(48px,7vw,112px));max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(24px,4vw,72px);pointer-events:none}
.herd-facts .hf{position:relative;max-width:330px;pointer-events:auto}
.hf-n{display:block;font-family:var(--font-display);font-size:14px;color:var(--pink);letter-spacing:.05em;margin-bottom:11px}
.hf-body{position:relative;border-top:1px solid var(--line);padding-top:14px}
.hf-body::before{content:"";position:absolute;top:-1px;left:0;width:0;height:2px;background:var(--pink);transition:width .6s cubic-bezier(.2,.7,.2,1)}
