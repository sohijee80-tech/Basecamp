/* ===== 03 journey drag ===== */
(function(){
  const rail=document.getElementById('jrail');let down=false,sx=0,sl=0;
  rail.addEventListener('pointerdown',e=>{down=true;sx=e.clientX;sl=rail.scrollLeft;rail.classList.add('drag');try{rail.setPointerCapture(e.pointerId)}catch(_){}});
  rail.addEventListener('pointermove',e=>{if(down){rail.scrollLeft=sl-(e.clientX-sx);paint();}});
  const end=()=>{down=false;rail.classList.remove('drag');};
  rail.addEventListener('pointerup',end);rail.addEventListener('pointercancel',end);
  /* horizontal wheel still scrolls the rail; vertical wheel scrolls the page normally */
  rail.addEventListener('wheel',e=>{if(Math.abs(e.deltaX)>Math.abs(e.deltaY)){rail.scrollLeft+=e.deltaX;}},{passive:true});
  /* draggable timeline scrubber, lights up content as the knob passes */
  const cards=[...rail.querySelectorAll('.jcard')],fill=document.getElementById('jfill'),knob=document.getElementById('jknob'),track=document.getElementById('jtrack'),ticks=document.getElementById('jticks');
  const N=cards.length;
  ticks.innerHTML=cards.map((c,i)=>`<span class="jtick" style="left:${N>1?i/(N-1)*100:0}%"></span>`).join('');
  const tickEls=[...ticks.children];
  let prog=0,lastAi=-1;
  function apply(){
    fill.style.width=(prog*100)+'%';knob.style.left=(prog*100)+'%';
    cards.forEach((c,i)=>{const th=N>1?i/(N-1):0;const on=prog>=th-0.02;c.classList.toggle('lit',on);tickEls[i].classList.toggle('on',on);});
    const ai=Math.round(prog*(N-1));
    if(ai!==lastAi){lastAi=ai;const c=cards[ai];if(c&&rail.scrollWidth>rail.clientWidth+4)rail.scrollTo({left:c.offsetLeft-rail.clientWidth/2+c.offsetWidth/2,behavior:'smooth'});}
  }
  function setFromX(x){const r=track.getBoundingClientRect();prog=Math.min(1,Math.max(0,(x-r.left)/r.width));apply();}
  let kd=false;
  track.addEventListener('pointerdown',e=>{kd=true;setFromX(e.clientX);try{knob.setPointerCapture(e.pointerId)}catch(_){}});
  knob.addEventListener('pointerdown',e=>{e.stopPropagation();kd=true;try{knob.setPointerCapture(e.pointerId)}catch(_){}});
  addEventListener('pointermove',e=>{if(kd)setFromX(e.clientX);});
  addEventListener('pointerup',()=>{kd=false;});
  addEventListener('resize',apply);
  apply();
})();

