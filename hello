  var TZ={'MIAMI':'America/New_York','W PALM BEACH':'America/New_York','CHICAGO':'America/Chicago','NEW YORK':'America/New_York','VANCOUVER':'America/Vancouver','LISBON':'Europe/Lisbon','CURITIBA':'America/Sao_Paulo','SÃO PAULO':'America/Sao_Paulo','DUBAI':'Asia/Dubai','HO CHI MINH':'Asia/Ho_Chi_Minh','SINGAPORE':'Asia/Singapore'};
  var MISSIONS=['CLIENT PRESENTATION','BRAND STRATEGY','DESIGN REVIEW','CGI DELIVERY','FILM EXPORT','WORKSHOP','DISCOVERY SESSION','MASTERPLAN REVIEW','NAMING SESSION','CREATIVE REVIEW','FULL CAMPAIGN','LAUNCH PLANNING','SALES STRATEGY','PROJECT KICKOFF','RENDER APPROVAL','VISUALIZATION','SITE VISIT','INVESTOR MEETING','CAMPAIGN REVIEW','BROCHURE REVIEW'];
  var STATUS=['BOARDING','ON TIME','FINAL CALL','IN PROGRESS','UNDER REVIEW','LIVE','RENDERING','UPLOADING','APPROVED','COMPLETED'];
  var ALPHA=' ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789:&·';
  var W={time:5,from:12,to:12,mission:19,status:12},ROWS=6;
  var rnd=function(a){return a[Math.floor(Math.random()*a.length)];};
  var pad=function(s,n){s=(s||'').toUpperCase().slice(0,n);while(s.length<n)s+=' ';return s;};
  function makeCell(){var s=document.createElement('span');s.className='flap';s.textContent=' ';return s;}
  function flip(c){c.style.animation='none';void c.offsetWidth;c.style.animation='flapAnim 70ms ease';}
  function setCell(cell,target,delay){target=target||' ';if(cell.textContent===target)return;
    var steps=4+Math.floor(Math.random()*6),i=0;
    function step(){i++;cell.textContent=(i<steps)?ALPHA[Math.floor(Math.random()*ALPHA.length)]:target;flip(cell);if(i<steps)setTimeout(step,40+Math.random()*16);}
    setTimeout(step,delay);}
  function buildField(n){var d=document.createElement('div');d.className='opsb-field';for(var i=0;i<n;i++)d.appendChild(makeCell());return d;}
  function setField(f,str,n){str=pad(str,n);for(var i=0;i<n;i++)setCell(f.children[i],str[i],Math.random()*180);}
  function timeAt(c){try{return new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',hour12:false,timeZone:TZ[c]}).format(new Date());}catch(e){return '00:00';}}
  function newOp(){var from=rnd(OFFICES),to;do{to=rnd(OFFICES);}while(to===from);
    return {time:timeAt(to),from:from,to:to,mission:rnd(MISSIONS),status:rnd(STATUS)};}
  var data=[],rowEls=[];
  function buildRow(){var row=document.createElement('div');row.className='opsb-row';
    var fT=buildField(W.time),fF=buildField(W.from),fO=buildField(W.to),fM=buildField(W.mission),fS=buildField(W.status);fS.classList.add('st');
    row.appendChild(fT);row.appendChild(fF);row.appendChild(fO);row.appendChild(fM);row.appendChild(fS);
    row._f={t:fT,f:fF,o:fO,m:fM,s:fS};return row;}
  function renderRow(row,op){setField(row._f.t,op.time,W.time);setField(row._f.f,op.from,W.from);setField(row._f.o,op.to,W.to);setField(row._f.m,op.mission,W.mission);setField(row._f.s,op.status,W.status);}
  for(var i=0;i<ROWS;i++){var op=newOp();data.push(op);var r=buildRow();rowEls.push(r);rowsEl.appendChild(r);}
  var running=false,loopT,rowT,clockT;
  function wake(){if(running)return;running=true;for(var i=0;i<ROWS;i++)(function(k){setTimeout(function(){renderRow(rowEls[k],data[k]);},k*130);})(i);startLoops();}
  function fieldUpdate(){var i=Math.floor(Math.random()*ROWS),op=data[i],f=rnd(['mission','status','status','to','from']);
    if(f==='from'){var nf;do{nf=rnd(OFFICES);}while(nf===op.to);op.from=nf;setField(rowEls[i]._f.f,op.from,W.from);}
    else if(f==='to'){var nt;do{nt=rnd(OFFICES);}while(nt===op.from);op.to=nt;op.time=timeAt(nt);setField(rowEls[i]._f.o,op.to,W.to);setField(rowEls[i]._f.t,op.time,W.time);}
    else if(f==='mission'){op.mission=rnd(MISSIONS);setField(rowEls[i]._f.m,op.mission,W.mission);}
    else{op.status=rnd(STATUS);setField(rowEls[i]._f.s,op.status,W.status);}
    loopT=setTimeout(fieldUpdate,2000+Math.random()*4000);}
  function rowReplace(){var i=Math.floor(Math.random()*ROWS),op=newOp();data[i]=op;renderRow(rowEls[i],op);rowT=setTimeout(rowReplace,20000+Math.random()*10000);}
  function clockTick(){for(var i=0;i<ROWS;i++){var op=data[i],nt=timeAt(op.to);if(nt!==op.time){op.time=nt;setField(rowEls[i]._f.t,op.time,W.time);}}}
  function startLoops(){stopLoops();loopT=setTimeout(fieldUpdate,2600);rowT=setTimeout(rowReplace,22000);clockT=setInterval(clockTick,20000);}
  function stopLoops(){clearTimeout(loopT);clearTimeout(rowT);clearInterval(clockT);}
  new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){running?startLoops():wake();}else stopLoops();});},{threshold:.15}).observe(board);
})();
</script>

